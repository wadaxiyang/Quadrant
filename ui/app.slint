import { Palette } from "std-widgets.slint";
import {
    Branding,
    InboxItem,
    ModalKind,
    ModalManager,
    Theme,
    ThemeMode,
    ToastHost,
    ToastKind,
    Typography,
    UiConstants,
} from "kit/kit.slint";
import { Sidebar } from "components/sidebar.slint";
import { TitleBar } from "components/title_bar.slint";
import { QuadrantsView, TaskRow } from "views/quadrants.slint";
import { TodayTaskRow, TodayView } from "views/today.slint";
import { FocusTaskRow, FocusView } from "views/focus.slint";
import { ReviewActivityRow, ReviewQuadrantRow, ReviewRecentRow, ReviewView } from "views/review.slint";
import { CompletedTaskRow, CompletedView } from "views/completed.slint";
import { SettingsView } from "views/settings.slint";
import { AboutView } from "views/about.slint";

export { QuickAddWindow } from "components/quick_add.slint";
export { TaskEditorWindow } from "components/task_editor.slint";

export component MainWindow inherits Window {
    title: "Quadrant";
    icon: Branding.app_mark;
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 760px;
    min-height: 520px;
    no-frame: true;
    resize-border-width: 6px;
    background: Theme.background;
    default-font-family: root.ui_font_family;
    default-font-size: Typography.body;
    default-font-weight: Typography.regular;

    in-out property <string> ui_font_family <=> Theme.ui_font_family;
    in-out property <bool> agent_connected: false;
    in-out property <bool> command_pending: false;
    in-out property <string> connection_message;
    property <length> connection_banner_height: root.agent_connected && !root.command_pending ? 0px : 48px;
    in-out property <int> current_route: 0;
    in-out property <bool> sidebar_user_collapsed: false;
    in-out property <bool> toast_visible: false;
    in-out property <string> toast_message;
    in-out property <ToastKind> toast_kind: ToastKind.info;
    in-out property <bool> dialog_visible: false;
    in-out property <string> dialog_title;
    in-out property <string> dialog_message;
    property <int> dialog_mode: 0;
    property <string> pending_delete_id;
    in-out property <[InboxItem]> inbox_tasks;
    in-out property <[TaskRow]> q1_tasks;
    in-out property <[TaskRow]> q2_tasks;
    in-out property <[TaskRow]> q3_tasks;
    in-out property <[TaskRow]> q4_tasks;
    in-out property <[TodayTaskRow]> overdue_tasks;
    in-out property <[TodayTaskRow]> planned_today_tasks;
    in-out property <[TodayTaskRow]> due_today_tasks;
    in-out property <[TodayTaskRow]> needs_reschedule_tasks;
    in-out property <int> today_task_count;
    in-out property <[FocusTaskRow]> focus_tasks;
    in-out property <string> focus_selected_task_id;
    in-out property <int> focus_selected_mode: 1;
    in-out property <int> focus_selected_kind: 0;
    in-out property <int> focus_session_status: -1;
    in-out property <string> focus_timer_text: "25:00";
    in-out property <float> focus_timer_progress: 0;
    in-out property <string> focus_session_label: "Ready to focus";
    in-out property <string> focus_today_summary: "No productive focus completed today";
    in-out property <string> focus_minutes: "25";
    in-out property <string> short_break_minutes: "5";
    in-out property <string> long_break_minutes: "15";
    in-out property <string> long_break_interval: "4";
    in-out property <bool> auto_start_break: false;
    in-out property <bool> auto_start_focus: false;
    in-out property <int> review_range: 0;
    in-out property <string> review_completed_value: "0";
    in-out property <string> review_completed_hint;
    in-out property <string> review_focus_value: "0m";
    in-out property <string> review_focus_hint;
    in-out property <string> review_sessions_value: "0";
    in-out property <string> review_sessions_hint;
    in-out property <string> review_average_value: "0m";
    in-out property <string> review_state_summary;
    in-out property <[ReviewActivityRow]> review_activity;
    in-out property <int> review_activity_completed_max: 1;
    in-out property <int> review_activity_focus_max: 1;
    in-out property <[ReviewQuadrantRow]> review_quadrants;
    in-out property <int> review_quadrant_completed_max: 1;
    in-out property <int> review_quadrant_focus_max: 1;
    in-out property <string> review_longest_focus: "0m";
    in-out property <string> review_top_task: "No linked task";
    in-out property <string> review_top_task_detail;
    in-out property <string> review_top_quadrant;
    in-out property <[ReviewRecentRow]> review_recent;
    in-out property <[CompletedTaskRow]> completed_tasks;
    in-out property <bool> completed_has_more: false;
    in-out property <string> application_version: "0.1.0";
    in-out property <string> backup_directory;
    in-out property <string> latest_backup: "No backup created yet";
    in-out property <bool> restore_pending: false;
    in-out property <string> update_description;
    in-out property <bool> can_open_releases: true;
    in-out property <bool> launch_at_startup: false;
    in-out property <bool> start_hidden: false;
    in-out property <bool> close_to_tray: true;
    in-out property <bool> minimize_to_tray: false;
    in-out property <bool> autostart_supported: false;
    in-out property <bool> tray_supported: false;
    in-out property <bool> global_hotkey_available: false;
    in-out property <bool> native_notifications_available: false;
    in-out property <bool> single_instance_available: false;

    callback navigation_requested(int);
    callback quick_add_requested;
    callback theme_selected(ThemeMode);
    callback desktop_settings_changed(bool, bool, bool, bool);
    callback task_move_requested(string, int);
    callback task_edit_requested(string);
    callback task_reorder_requested(string, int);
    callback task_complete_requested(string);
    callback task_delete_confirmed(string);
    callback focus_start_requested(int, int, string);
    callback focus_pause_requested;
    callback focus_resume_requested;
    callback focus_finish_requested;
    callback focus_cancel_requested;
    callback focus_settings_changed(string, string, string, string, bool, bool);
    callback review_range_selected(int);
    callback completed_reopen_requested(string);
    callback completed_load_more_requested;
    callback create_backup_requested;
    callback open_backup_directory_requested;
    callback backup_restore_confirmed;
    callback open_release_page_requested;
    callback window_close;
    callback window_minimize;
    callback window_maximize;
    callback window_drag_delta(float, float);

    public function show_toast(message: string, kind: ToastKind) {
        root.toast_message = message;
        root.toast_kind = kind;
        root.toast_visible = true;
    }

    public function apply_theme(mode: ThemeMode, system_dark: bool) {
        Theme.mode = mode;
        Theme.system_dark = system_dark;
        Palette.color-scheme = mode == ThemeMode.system ? ColorScheme.unknown :
                               mode == ThemeMode.light ? ColorScheme.light : ColorScheme.dark;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.background;
        border-radius: root.maximized ? 0px : UiConstants.content_radius;
        border-width: root.maximized ? 0px : 1px;
        border-color: Theme.main_color;
        clip: true;

        TitleBar {
                x: 0px;
                y: 0px;
                width: parent.width;
                title: "Quadrant";
                version: root.application_version;
                is_maximized: root.maximized;
                theme_mode: Theme.mode;
                close => { root.window_close(); }
                minimize => { root.window_minimize(); }
                maximize => { root.window_maximize(); }
                theme_selected(mode) => {
                    root.theme_selected(mode);
                }
                drag_delta(dx, dy) => { root.window_drag_delta(dx, dy); }
            }

            if root.connection_banner_height > 0px: Rectangle {
                x: 0px;
                y: UiConstants.title_bar_height;
                width: parent.width;
                height: root.connection_banner_height;
                background: Theme.card_bg;
                Text {
                    x: 16px; width: parent.width - 32px; height: parent.height;
                    text: root.command_pending && root.agent_connected ? "Waiting for the background service…" : root.connection_message;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                x: 0px;
                y: UiConstants.title_bar_height + root.connection_banner_height;
                width: parent.width;
                height: parent.height - UiConstants.title_bar_height - root.connection_banner_height;
                spacing: 0px;

                Sidebar {
                    collapsed <=> root.sidebar_user_collapsed;
                    auto_collapsed: root.width < 920px;
                    selected_route: root.current_route;
                    route_selected(route) => {
                        root.current_route = route;
                        root.navigation_requested(route);
                    }
                    quick_add_clicked => { root.quick_add_requested(); }
                }

                Rectangle {
                    background: Theme.content_bg;
                    border-color: Theme.border_color;
                    border-width: 1px;
                    border-radius: root.maximized ? 0px : UiConstants.content_radius;
                    clip: true;

                    if root.current_route == 0: QuadrantsView {
                        inbox_tasks: root.inbox_tasks;
                        q1_tasks: root.q1_tasks;
                        q2_tasks: root.q2_tasks;
                        q3_tasks: root.q3_tasks;
                        q4_tasks: root.q4_tasks;
                        move_requested(id, destination) => { root.task_move_requested(id, destination); }
                        edit_requested(id) => { root.task_edit_requested(id); }
                        reorder_requested(id, direction) => { root.task_reorder_requested(id, direction); }
                        complete_requested(id) => { root.task_complete_requested(id); }
                        delete_requested(id) => {
                            root.pending_delete_id = id;
                            root.dialog_mode = 1;
                            root.dialog_title = "Delete task?";
                            root.dialog_message = "This permanently deletes the task. Completed history snapshots remain available for Review.";
                            root.dialog_visible = true;
                        }
                        add_requested => { root.quick_add_requested(); }
                    }
                    if root.current_route == 1: TodayView {
                        overdue_tasks: root.overdue_tasks;
                        planned_today_tasks: root.planned_today_tasks;
                        due_today_tasks: root.due_today_tasks;
                        needs_reschedule_tasks: root.needs_reschedule_tasks;
                        unique_task_count: root.today_task_count;
                        edit_requested(id) => { root.task_edit_requested(id); }
                        complete_requested(id) => { root.task_complete_requested(id); }
                    }
                    if root.current_route == 2: FocusView {
                        tasks: root.focus_tasks;
                        selected_task_id <=> root.focus_selected_task_id;
                        selected_mode <=> root.focus_selected_mode;
                        selected_kind <=> root.focus_selected_kind;
                        session_status: root.focus_session_status;
                        timer_text: root.focus_timer_text;
                        timer_progress: root.focus_timer_progress;
                        session_label: root.focus_session_label;
                        today_summary: root.focus_today_summary;
                        focus_minutes <=> root.focus_minutes;
                        short_break_minutes <=> root.short_break_minutes;
                        long_break_minutes <=> root.long_break_minutes;
                        long_break_interval <=> root.long_break_interval;
                        auto_start_break <=> root.auto_start_break;
                        auto_start_focus <=> root.auto_start_focus;
                        start_requested(mode, kind, task_id) => { root.focus_start_requested(mode, kind, task_id); }
                        pause_requested => { root.focus_pause_requested(); }
                        resume_requested => { root.focus_resume_requested(); }
                        finish_requested => { root.focus_finish_requested(); }
                        cancel_requested => { root.focus_cancel_requested(); }
                        settings_changed(focus, short_break, long_break, interval, auto_break, auto_focus) => {
                            root.focus_settings_changed(focus, short_break, long_break, interval, auto_break, auto_focus);
                        }
                    }
                    if root.current_route == 3: ReviewView {
                        selected_range <=> root.review_range;
                        completed_value: root.review_completed_value;
                        completed_hint: root.review_completed_hint;
                        focus_value: root.review_focus_value;
                        focus_hint: root.review_focus_hint;
                        sessions_value: root.review_sessions_value;
                        sessions_hint: root.review_sessions_hint;
                        average_value: root.review_average_value;
                        state_summary: root.review_state_summary;
                        activity: root.review_activity;
                        activity_completed_max: root.review_activity_completed_max;
                        activity_focus_max: root.review_activity_focus_max;
                        quadrants: root.review_quadrants;
                        quadrant_completed_max: root.review_quadrant_completed_max;
                        quadrant_focus_max: root.review_quadrant_focus_max;
                        longest_focus: root.review_longest_focus;
                        top_task: root.review_top_task;
                        top_task_detail: root.review_top_task_detail;
                        top_quadrant: root.review_top_quadrant;
                        recent: root.review_recent;
                        range_selected(range) => { root.review_range_selected(range); }
                    }
                    if root.current_route == 4: CompletedView {
                        tasks: root.completed_tasks;
                        has_more: root.completed_has_more;
                        reopen_requested(id) => { root.completed_reopen_requested(id); }
                        delete_requested(id) => {
                            root.pending_delete_id = id;
                            root.dialog_mode = 1;
                            root.dialog_title = "Delete completed task?";
                            root.dialog_message = "This permanently deletes the task row. Its completion snapshot remains in Review.";
                            root.dialog_visible = true;
                        }
                        load_more_requested => { root.completed_load_more_requested(); }
                    }
                    if root.current_route == 5: SettingsView {
                        theme_mode: Theme.mode;
                        launch_at_startup: root.launch_at_startup;
                        start_hidden: root.start_hidden;
                        close_to_tray: root.close_to_tray;
                        minimize_to_tray: root.minimize_to_tray;
                        autostart_supported: root.autostart_supported;
                        tray_supported: root.tray_supported;
                        global_hotkey_available: root.global_hotkey_available;
                        native_notifications_available: root.native_notifications_available;
                        single_instance_available: root.single_instance_available;
                        backup_directory: root.backup_directory;
                        latest_backup: root.latest_backup;
                        restore_pending: root.restore_pending;
                        application_version: root.application_version;
                        update_description: root.update_description;
                        can_open_releases: root.can_open_releases;
                        theme_selected(mode) => {
                            root.theme_selected(mode);
                        }
                        desktop_settings_changed(launch, start_hidden, close_to_tray, minimize_to_tray) => {
                            root.desktop_settings_changed(launch, start_hidden, close_to_tray, minimize_to_tray);
                        }
                        create_backup_requested => { root.create_backup_requested(); }
                        open_backup_directory_requested => { root.open_backup_directory_requested(); }
                        restore_latest_requested => {
                            root.dialog_mode = 2;
                            root.dialog_title = "Restore latest backup?";
                            root.dialog_message = "The backup will be validated and staged. It replaces current data only after you exit and reopen Quadrant; the previous database is retained in the recovery folder.";
                            root.dialog_visible = true;
                        }
                        open_releases_requested => { root.open_release_page_requested(); }
                    }
                    if root.current_route == 6: AboutView {
                        application_version: root.application_version;
                        can_open_releases: root.can_open_releases;
                        show_notices => {
                            root.dialog_mode = 0;
                            root.dialog_title = "Source and license notices";
                            root.dialog_message = "Quadrant is GPL-3.0-only. Fluent UI components are derived from owu/wsl-dashboard at commit 948589a. Icons are Microsoft Fluent UI System Icons under the MIT License. Release archives include third-party notices and the locked Rust dependency license inventory.";
                            root.dialog_visible = true;
                        }
                        open_releases => { root.open_release_page_requested(); }
                    }
                }
            }
    }

    ToastHost {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 20px;
        shown: root.toast_visible;
        message: root.toast_message;
        kind: root.toast_kind;
        z: 400;
        dismissed => { root.toast_visible = false; }
    }

    ModalManager {
        width: 100%;
        height: 100%;
        shown: root.dialog_visible;
        title: root.dialog_title;
        message: root.dialog_message;
        primary_text: root.dialog_mode == 1 ? "Delete" : (root.dialog_mode == 2 ? "Stage restore" : "Close");
        show_secondary: root.dialog_mode == 1 || root.dialog_mode == 2;
        secondary_text: "Cancel";
        kind: root.dialog_mode == 1 ? ModalKind.danger : (root.dialog_mode == 2 ? ModalKind.warning : ModalKind.info);
        danger_primary: root.dialog_mode == 1;
        accepted => {
            if (root.dialog_mode == 1) {
                root.task_delete_confirmed(root.pending_delete_id);
                root.pending_delete_id = "";
            } else if (root.dialog_mode == 2) {
                root.backup_restore_confirmed();
            }
            root.dialog_visible = false;
        }
        dismissed => {
            root.pending_delete_id = "";
            root.dialog_visible = false;
        }
    }
}
