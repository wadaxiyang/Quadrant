import { Palette, ScrollView, Switch } from "std-widgets.slint";
import { Theme, ThemeMode, Typography } from "../theme.slint";
import { UiConstants } from "../constants.slint";
import { Icons } from "../icons.slint";
import { Badge, BadgeKind, FluentButton, FluentTextArea, FluentTextField, SegmentButton, SettingRow, SurfaceCard } from "../components/common.slint";
import { FluentIcon, IconButton } from "../components/icon.slint";
import { ModalKind, ModalManager } from "../components/modal_manager.slint";
import { SectionHeader } from "../components/page_shell.slint";
import { ToastHost, ToastKind } from "../components/toast.slint";

component GalleryLabel inherits Text {
    color: Theme.text_secondary;
    font-size: Typography.caption;
    font-weight: Typography.semibold;
}

component StateSpecimen inherits VerticalLayout {
    in property <string> label;
    spacing: UiConstants.space_4;
    GalleryLabel { text: root.label; horizontal-alignment: center; }
}

component ModalTextSample inherits SurfaceCard {
    in property <string> sample_title;
    in property <string> sample_message;
    preferred-height: sample_layout.preferred-height;
    elevated: true;

    sample_layout := VerticalLayout {
        padding: UiConstants.space_16;
        spacing: UiConstants.space_8;
        Text {
            text: root.sample_title;
            color: Theme.text_primary;
            font-size: Typography.subtitle;
            font-weight: Typography.semibold;
        }
        Text {
            text: root.sample_message;
            color: Theme.text_secondary;
            font-size: Typography.body;
            wrap: word-wrap;
        }
    }
}

component CardStateSample inherits SurfaceCard {
    in property <string> label;
    min-height: 56px;
    accessible_name: root.label;

    Text {
        text: root.label;
        color: Theme.text_primary;
        font-size: Typography.caption;
        font-weight: Typography.semibold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component DesignGalleryWindow inherits Window {
    title: "Quadrant Design Gallery";
    icon: Icons.app_mark;
    preferred-width: 1040px;
    preferred-height: 800px;
    min-width: 760px;
    min-height: 520px;
    background: Theme.background;
    default-font-family: root.ui_font_family;
    default-font-size: Typography.body;
    default-font-weight: Typography.regular;

    in-out property <string> ui_font_family <=> Theme.ui_font_family;
    in-out property <string> sample_text;
    in-out property <bool> sample_switch: true;
    in-out property <ThemeMode> gallery_theme: ThemeMode.light;
    in-out property <bool> sample_modal_visible: false;
    in-out property <int> sample_modal_kind: 0;

    changed gallery_theme => {
        Theme.mode = root.gallery_theme;
        Palette.color-scheme = root.gallery_theme == ThemeMode.system ? ColorScheme.unknown :
                               root.gallery_theme == ThemeMode.light ? ColorScheme.light : ColorScheme.dark;
    }

    ScrollView {
        width: 100%;
        height: 100%;
        viewport-width: self.width;

        VerticalLayout {
            padding: UiConstants.page_padding_wide;
            spacing: UiConstants.space_20;

            Text {
                text: "Quadrant Fluent design gallery";
                color: Theme.text_primary;
                font-size: Typography.title;
                font-weight: Typography.semibold;
            }
            Text {
                text: "Shared tokens and reusable component states. Development-only; not part of release navigation.";
                color: Theme.text_secondary;
                font-size: Typography.body;
            }
            HorizontalLayout {
                spacing: UiConstants.space_4;
                SegmentButton {
                    text: "System";
                    selected: root.gallery_theme == ThemeMode.system;
                    clicked => {
                        root.gallery_theme = ThemeMode.system;
                        Theme.mode = ThemeMode.system;
                        Palette.color-scheme = ColorScheme.unknown;
                    }
                }
                SegmentButton {
                    text: "Light";
                    selected: root.gallery_theme == ThemeMode.light;
                    clicked => {
                        root.gallery_theme = ThemeMode.light;
                        Theme.mode = ThemeMode.light;
                        Palette.color-scheme = ColorScheme.light;
                    }
                }
                SegmentButton {
                    text: "Dark";
                    selected: root.gallery_theme == ThemeMode.dark;
                    clicked => {
                        root.gallery_theme = ThemeMode.dark;
                        Theme.mode = ThemeMode.dark;
                        Palette.color-scheme = ColorScheme.dark;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            SurfaceCard {
                preferred-height: button_states.preferred-height;
                button_states := VerticalLayout {
                    padding: UiConstants.space_16;
                    spacing: UiConstants.space_12;
                    GalleryLabel { text: "Button interaction states"; }
                    HorizontalLayout {
                        spacing: UiConstants.space_12;
                        StateSpecimen { horizontal-stretch: 1; label: "Normal"; FluentButton { text: "Button"; } }
                        StateSpecimen { horizontal-stretch: 1; label: "Hover"; FluentButton { text: "Button"; preview_hover: true; } }
                        StateSpecimen { horizontal-stretch: 1; label: "Pressed"; FluentButton { text: "Button"; preview_pressed: true; } }
                        StateSpecimen { horizontal-stretch: 1; label: "Keyboard focus"; FluentButton { text: "Button"; preview_focus: true; } }
                        StateSpecimen { horizontal-stretch: 1; label: "Disabled"; FluentButton { text: "Button"; enabled: false; } }
                        StateSpecimen { horizontal-stretch: 1; label: "Danger"; FluentButton { text: "Delete"; danger: true; primary: true; } }
                    }
                    HorizontalLayout {
                        spacing: UiConstants.space_8;
                        GalleryLabel { text: "Segment"; width: 72px; vertical-alignment: center; }
                        SegmentButton { text: "Selected"; selected: true; }
                        SegmentButton { text: "Hover"; preview_hover: true; }
                        SegmentButton { text: "Pressed"; preview_pressed: true; }
                        SegmentButton { text: "Focus"; preview_focus: true; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }

            SurfaceCard {
                preferred-height: primitives_layout.preferred-height;

                primitives_layout := VerticalLayout {
                    padding: UiConstants.space_16;
                    spacing: UiConstants.space_12;

                    SectionHeader {
                        title: "Reusable rows and badges";
                        description: "Content-driven primitives for sections, settings, and compact status.";
                        badge_text: "Phase 2";
                        badge_kind: BadgeKind.accent;
                    }

                    HorizontalLayout {
                        spacing: UiConstants.space_8;
                        Badge { text: "Neutral"; }
                        Badge { text: "Accent"; kind: BadgeKind.accent; }
                        Badge { text: "Ready"; kind: BadgeKind.success; }
                        Badge { text: "Warning"; kind: BadgeKind.warning; }
                        Badge { text: "Error"; kind: BadgeKind.danger; }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    SettingRow {
                        title: "Standard setting row";
                        description: "The description wraps and the row grows without a fixed card height.";
                        Switch {
                            text: "";
                            accessible-label: "Standard setting row";
                            checked <=> root.sample_switch;
                        }
                    }
                }
            }

            SurfaceCard {
                preferred-height: icon_states.preferred-height;
                icon_states := VerticalLayout {
                    padding: UiConstants.space_16;
                    spacing: UiConstants.space_12;
                    GalleryLabel { text: "IconButton interaction states"; }
                    HorizontalLayout {
                        spacing: UiConstants.space_12;
                        StateSpecimen { horizontal-stretch: 1; label: "Normal"; IconButton { icon: Icons.add; tooltip: "Normal"; } }
                        StateSpecimen { horizontal-stretch: 1; label: "Hover"; IconButton { icon: Icons.add; tooltip: "Hover"; preview_hover: true; } }
                        StateSpecimen { horizontal-stretch: 1; label: "Pressed"; IconButton { icon: Icons.add; tooltip: "Pressed"; preview_pressed: true; } }
                        StateSpecimen { horizontal-stretch: 1; label: "Keyboard focus"; IconButton { icon: Icons.add; tooltip: "Focused"; preview_focus: true; } }
                        StateSpecimen { horizontal-stretch: 1; label: "Danger"; IconButton { icon: Icons.delete; tooltip: "Delete"; danger: true; preview_hover: true; } }
                        StateSpecimen { horizontal-stretch: 1; label: "Disabled"; IconButton { icon: Icons.dismiss; tooltip: "Disabled"; enabled: false; } }
                    }
                    HorizontalLayout {
                        spacing: UiConstants.space_12;
                        GalleryLabel { text: "Semantic icons"; width: 116px; vertical-alignment: center; }
                        FluentIcon { source: Icons.quadrants_regular; size: 20px; }
                        FluentIcon { source: Icons.quadrants_filled; size: 20px; icon_color: Theme.accent; }
                        FluentIcon { source: Icons.status_info; size: 24px; icon_color: Theme.accent; }
                        FluentIcon { source: Icons.status_success; size: 24px; icon_color: Theme.success; }
                        FluentIcon { source: Icons.status_warning; size: 24px; icon_color: Theme.warning; }
                        FluentIcon { source: Icons.status_error; size: 24px; icon_color: Theme.danger; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }

            SurfaceCard {
                preferred-height: card_states.preferred-height;
                card_states := VerticalLayout {
                    padding: UiConstants.space_16;
                    spacing: UiConstants.space_12;
                    GalleryLabel { text: "SurfaceCard variants"; }
                    HorizontalLayout {
                        spacing: UiConstants.space_12;
                        CardStateSample { horizontal-stretch: 1; label: "Base"; }
                        CardStateSample { horizontal-stretch: 1; label: "Hover"; interactive: true; preview_hover: true; }
                        CardStateSample { horizontal-stretch: 1; label: "Pressed"; interactive: true; preview_pressed: true; }
                        CardStateSample { horizontal-stretch: 1; label: "Elevated"; elevated: true; }
                        CardStateSample { horizontal-stretch: 1; label: "Selected"; selected: true; }
                        CardStateSample { horizontal-stretch: 1; label: "Keyboard focus"; interactive: true; preview_focus: true; }
                        CardStateSample { horizontal-stretch: 1; label: "Disabled"; interactive: true; enabled: false; }
                    }
                }
            }

            SurfaceCard {
                preferred-height: inputs_layout.preferred-height;
                inputs_layout := HorizontalLayout {
                    padding: UiConstants.space_16;
                    spacing: UiConstants.space_16;
                    GalleryLabel { text: "Inputs"; width: 92px; }
                    VerticalLayout {
                        spacing: UiConstants.space_8;
                        FluentTextField { text <=> root.sample_text; placeholder_text: "Task title"; }
                        FluentTextField { text: "Focused value"; preview_focus: true; }
                        FluentTextField { text: "Invalid value"; error_text: "Explain the problem beside the field."; }
                        FluentTextField { text: "Disabled value"; enabled: false; }
                        FluentTextArea { height: 80px; text: root.sample_text; placeholder_text: "Notes"; }
                    }
                    VerticalLayout {
                        spacing: UiConstants.space_12;
                        HorizontalLayout {
                            spacing: UiConstants.space_4;
                            SegmentButton { text: "Inbox"; selected: true; }
                            SegmentButton { text: "Q1"; }
                            SegmentButton { text: "Q2"; enabled: false; }
                        }
                        Switch { text: "Enabled setting"; checked <=> root.sample_switch; }
                        Switch { text: "Disabled setting"; enabled: false; }
                    }
                }
            }

            SurfaceCard {
                preferred-height: toast_gallery_layout.preferred-height;
                vertical-stretch: 0;

                toast_gallery_layout := VerticalLayout {
                    padding: UiConstants.space_16;
                    spacing: UiConstants.space_12;
                    GalleryLabel { text: "Toast states"; }
                    Rectangle {
                        height: 56px;
                        ToastHost {
                            width: min(parent.width, 420px);
                            shown: true;
                            message: "Information uses the shared SVG and type scale.";
                            kind: ToastKind.info;
                            auto_dismiss: false;
                        }
                    }
                    Rectangle {
                        height: 56px;
                        ToastHost {
                            width: min(parent.width, 420px);
                            shown: true;
                            message: "The task was completed successfully.";
                            kind: ToastKind.success;
                            auto_dismiss: false;
                        }
                    }
                    Rectangle {
                        height: 76px;
                        ToastHost {
                            width: min(parent.width, 420px);
                            shown: true;
                            message: "This deliberately long error wraps onto a second line so critical details remain visible at the maximum toast width.";
                            kind: ToastKind.error;
                            auto_dismiss: false;
                        }
                    }
                }
            }

            SurfaceCard {
                preferred-height: modal_gallery_layout.preferred-height;
                vertical-stretch: 0;

                modal_gallery_layout := VerticalLayout {
                    padding: UiConstants.space_16;
                    spacing: UiConstants.space_12;

                    SectionHeader {
                        title: "Modal states";
                        description: "Interactive info, warning, and destructive confirmation coverage.";
                        badge_text: "Enter / Esc";
                        badge_kind: BadgeKind.accent;
                    }

                    HorizontalLayout {
                        spacing: UiConstants.space_8;
                        FluentButton { text: "Show info"; clicked => { root.sample_modal_kind = 0; root.sample_modal_visible = true; } }
                        FluentButton { text: "Show warning"; clicked => { root.sample_modal_kind = 1; root.sample_modal_visible = true; } }
                        FluentButton { text: "Show danger"; danger: true; clicked => { root.sample_modal_kind = 2; root.sample_modal_visible = true; } }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    HorizontalLayout {
                        spacing: UiConstants.space_16;
                        ModalTextSample {
                            horizontal-stretch: 1;
                            sample_title: "Short confirmation";
                            sample_message: "Save these changes?";
                        }
                        ModalTextSample {
                            horizontal-stretch: 1;
                            sample_title: "Long wrapped confirmation";
                            sample_message: "This longer modal copy demonstrates content-driven height when a decision needs enough context to remain clear without clipping or relying on a fixed dialog height.";
                        }
                    }
                }
            }

            SurfaceCard {
                height: 156px;
                VerticalLayout {
                    padding: UiConstants.space_16;
                    spacing: UiConstants.space_8;
                    GalleryLabel { text: "Typography"; }
                    Text { text: "Page title — 28 / Semibold"; color: Theme.text_primary; font-size: Typography.title; font-weight: Typography.semibold; }
                    Text { text: "Body — 14 / Regular"; color: Theme.text_primary; font-size: Typography.body; }
                    Text { text: "Caption — 12 / Regular"; color: Theme.text_tertiary; font-size: Typography.caption; }
                }
            }
        }
    }

    ModalManager {
        width: 100%;
        height: 100%;
        shown: root.sample_modal_visible;
        title: root.sample_modal_kind == 2 ? "Delete this task?" :
               root.sample_modal_kind == 1 ? "Review this change" : "Information";
        message: root.sample_modal_kind == 2 ? "This action permanently removes the task. Completion snapshots remain available in Review." :
                 root.sample_modal_kind == 1 ? "The validated backup will be staged and applied after Quadrant restarts." :
                 "Modal content grows with wrapped text and keeps its primary action keyboard accessible.";
        primary_text: root.sample_modal_kind == 2 ? "Delete" :
                      root.sample_modal_kind == 1 ? "Continue" : "Close";
        secondary_text: "Cancel";
        show_secondary: root.sample_modal_kind != 0;
        kind: root.sample_modal_kind == 2 ? ModalKind.danger :
              root.sample_modal_kind == 1 ? ModalKind.warning : ModalKind.info;
        danger_primary: root.sample_modal_kind == 2;
        accepted => { root.sample_modal_visible = false; }
        dismissed => { root.sample_modal_visible = false; }
    }
}
