import { ScrollView } from "std-widgets.slint";
import {
    Badge,
    Elevation,
    FluentButton,
    FluentIcons as Icons,
    IconButton,
    PageHeader,
    SegmentButton,
    SurfaceCard,
    TaskRowShell,
    Theme,
    Typography,
    UiConstants,
} from "../kit/kit.slint";

export struct TaskRow {
    id: string,
    title: string,
}

component TaskCard inherits TaskRowShell {
    in property <TaskRow> task;
    in property <int> destination;
    callback move_requested(string, int);
    callback edit_requested(string);
    callback reorder_requested(string, int);
    callback complete_requested(string);
    callback delete_requested(string);

    row_height: 60px;

    HorizontalLayout {
        padding-left: UiConstants.space_8;
        padding-right: UiConstants.space_8;
        spacing: UiConstants.space_6;
        alignment: center;

        IconButton {
            icon: Icons.complete;
            tooltip: "Complete task";
            clicked => { root.complete_requested(root.task.id); }
        }

        Text {
            horizontal-stretch: 1;
            text: root.task.title;
            color: Theme.text_primary;
            font-size: Typography.body;
            font-weight: Typography.semibold;
            overflow: elide;
            vertical-alignment: center;
        }

        IconButton {
            icon: Icons.edit;
            tooltip: "Edit task";
            clicked => { root.edit_requested(root.task.id); }
        }

        FluentButton {
            min-width: 68px;
            text: "Move";
            clicked => { move_popup.show(); }
        }

        IconButton {
            icon: Icons.more_horizontal;
            tooltip: "More task actions";
            clicked => { more_popup.show(); }
        }
    }

    move_popup := PopupWindow {
        x: root.width - self.width - 40px;
        y: root.height - UiConstants.space_4;
        width: 172px;
        height: 196px;
        close-policy: close-on-click-outside;

        SurfaceCard {
            drop-shadow-blur: Elevation.popup_blur;
            drop-shadow-color: Elevation.popup_shadow;

            VerticalLayout {
                padding: UiConstants.space_8;
                spacing: UiConstants.space_4;

                SegmentButton { text: "Inbox"; selected: root.destination == 0; clicked => { root.move_requested(root.task.id, 0); move_popup.close(); } }
                SegmentButton { text: "Q1 · Important + Urgent"; selected: root.destination == 1; clicked => { root.move_requested(root.task.id, 1); move_popup.close(); } }
                SegmentButton { text: "Q2 · Important"; selected: root.destination == 2; clicked => { root.move_requested(root.task.id, 2); move_popup.close(); } }
                SegmentButton { text: "Q3 · Urgent"; selected: root.destination == 3; clicked => { root.move_requested(root.task.id, 3); move_popup.close(); } }
                SegmentButton { text: "Q4 · Neither"; selected: root.destination == 4; clicked => { root.move_requested(root.task.id, 4); move_popup.close(); } }
            }
        }
    }

    more_popup := PopupWindow {
        x: root.width - self.width;
        y: root.height - UiConstants.space_4;
        width: 148px;
        height: 124px;
        close-policy: close-on-click-outside;

        SurfaceCard {
            drop-shadow-blur: Elevation.popup_blur;
            drop-shadow-color: Elevation.popup_shadow;

            VerticalLayout {
                padding: UiConstants.space_8;
                spacing: UiConstants.space_4;

                FluentButton { text: "Move up"; icon: Icons.chevron_up; show_icon: true; clicked => { root.reorder_requested(root.task.id, -1); more_popup.close(); } }
                FluentButton { text: "Move down"; icon: Icons.chevron_down; show_icon: true; clicked => { root.reorder_requested(root.task.id, 1); more_popup.close(); } }
                FluentButton { text: "Delete"; icon: Icons.delete; show_icon: true; danger: true; clicked => { root.delete_requested(root.task.id); more_popup.close(); } }
            }
        }
    }
}

component TaskColumn inherits SurfaceCard {
    in property <string> code;
    in property <string> title;
    in property <string> subtitle;
    in property <color> accent;
    in property <int> destination;
    in property <[TaskRow]> tasks;
    in property <bool> content_sized: false;
    callback move_requested(string, int);
    callback edit_requested(string);
    callback reorder_requested(string, int);
    callback complete_requested(string);
    callback delete_requested(string);

    min-height: 160px;
    preferred-height: root.content_sized ? column_content.preferred-height : 360px;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 4px;
        height: 100%;
        background: root.accent;
        border-radius: 2px;
    }

    column_content := VerticalLayout {
        padding: UiConstants.space_12;
        spacing: UiConstants.space_8;

        HorizontalLayout {
            spacing: UiConstants.space_8;

            if root.code != "": Rectangle {
                width: code_label.preferred-width + UiConstants.space_16;
                height: 24px;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.accent;
                background: root.accent.with-alpha(0.10);

                code_label := Text {
                    text: root.code;
                    color: root.accent;
                    font-size: Typography.caption;
                    font-weight: Typography.semibold;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: UiConstants.space_2;

                Text {
                    text: root.title;
                    color: Theme.text_primary;
                    font-size: Typography.body;
                    font-weight: Typography.semibold;
                    overflow: elide;
                }

                Text {
                    text: root.subtitle;
                    color: Theme.text_secondary;
                    font-size: Typography.caption;
                    overflow: elide;
                }
            }

            Badge {
                text: root.tasks.length + (root.tasks.length == 1 ? " task" : " tasks");
            }
        }

        Rectangle {
            vertical-stretch: root.content_sized ? 0 : 1;
            preferred-height: root.tasks.length == 0 ? 36px : root.tasks.length * 72px;
            clip: true;

            ScrollView {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    spacing: UiConstants.space_8;

                    for task in root.tasks: TaskCard {
                        task: task;
                        destination: root.destination;
                        move_requested(id, destination) => { root.move_requested(id, destination); }
                        edit_requested(id) => { root.edit_requested(id); }
                        reorder_requested(id, direction) => { root.reorder_requested(id, direction); }
                        complete_requested(id) => { root.complete_requested(id); }
                        delete_requested(id) => { root.delete_requested(id); }
                    }

                    if root.tasks.length == 0: Text {
                        height: 36px;
                        text: "No active tasks";
                        color: Theme.text_tertiary;
                        font-size: Typography.caption;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component QuadrantsView inherits Rectangle {
    in property <[TaskRow]> inbox_tasks;
    in property <[TaskRow]> q1_tasks;
    in property <[TaskRow]> q2_tasks;
    in property <[TaskRow]> q3_tasks;
    in property <[TaskRow]> q4_tasks;
    callback move_requested(string, int);
    callback edit_requested(string);
    callback reorder_requested(string, int);
    callback complete_requested(string);
    callback delete_requested(string);

    property <bool> compact: root.width < UiConstants.compact_breakpoint;
    property <bool> wide: root.width >= UiConstants.wide_breakpoint;
    property <length> responsive_padding: root.compact ? UiConstants.page_padding_compact :
                                                   root.wide ? UiConstants.page_padding_wide : UiConstants.page_padding_medium;

    background: transparent;

    ScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding: root.responsive_padding;
            spacing: UiConstants.space_16;

            PageHeader {
                title: "Quadrants";
                subtitle: "Capture in Inbox, then classify by importance and urgency.";
            }

            if root.wide: Rectangle {
                height: max(520px, root.height - 2 * root.responsive_padding - 88px);

                HorizontalLayout {
                    spacing: UiConstants.space_16;

                    TaskColumn {
                        width: 280px;
                        code: ""; title: "Inbox"; subtitle: "Unclassified captures"; accent: Theme.accent;
                        destination: 0; tasks: root.inbox_tasks;
                        move_requested(id, destination) => { root.move_requested(id, destination); }
                        edit_requested(id) => { root.edit_requested(id); }
                        reorder_requested(id, direction) => { root.reorder_requested(id, direction); }
                        complete_requested(id) => { root.complete_requested(id); }
                        delete_requested(id) => { root.delete_requested(id); }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: UiConstants.space_12;

                        HorizontalLayout {
                            spacing: UiConstants.space_12;
                            TaskColumn {
                                code: "Q1"; title: "Important + Urgent"; subtitle: "Do now"; accent: Theme.q1_accent;
                                destination: 1; tasks: root.q1_tasks;
                                move_requested(id, destination) => { root.move_requested(id, destination); }
                                edit_requested(id) => { root.edit_requested(id); }
                                reorder_requested(id, direction) => { root.reorder_requested(id, direction); }
                                complete_requested(id) => { root.complete_requested(id); }
                                delete_requested(id) => { root.delete_requested(id); }
                            }
                            TaskColumn {
                                code: "Q2"; title: "Important + Not urgent"; subtitle: "Plan deliberately"; accent: Theme.q2_accent;
                                destination: 2; tasks: root.q2_tasks;
                                move_requested(id, destination) => { root.move_requested(id, destination); }
                                edit_requested(id) => { root.edit_requested(id); }
                                reorder_requested(id, direction) => { root.reorder_requested(id, direction); }
                                complete_requested(id) => { root.complete_requested(id); }
                                delete_requested(id) => { root.delete_requested(id); }
                            }
                        }

                        HorizontalLayout {
                            spacing: UiConstants.space_12;
                            TaskColumn {
                                code: "Q3"; title: "Not important + Urgent"; subtitle: "Delegate or contain"; accent: Theme.q3_accent;
                                destination: 3; tasks: root.q3_tasks;
                                move_requested(id, destination) => { root.move_requested(id, destination); }
                                edit_requested(id) => { root.edit_requested(id); }
                                reorder_requested(id, direction) => { root.reorder_requested(id, direction); }
                                complete_requested(id) => { root.complete_requested(id); }
                                delete_requested(id) => { root.delete_requested(id); }
                            }
                            TaskColumn {
                                code: "Q4"; title: "Not important + Not urgent"; subtitle: "Reduce or remove"; accent: Theme.q4_accent;
                                destination: 4; tasks: root.q4_tasks;
                                move_requested(id, destination) => { root.move_requested(id, destination); }
                                edit_requested(id) => { root.edit_requested(id); }
                                reorder_requested(id, direction) => { root.reorder_requested(id, direction); }
                                complete_requested(id) => { root.complete_requested(id); }
                                delete_requested(id) => { root.delete_requested(id); }
                            }
                        }
                    }
                }
            }

            if !root.wide && !root.compact: VerticalLayout {
                spacing: UiConstants.space_12;

                TaskColumn {
                    content_sized: true;
                    code: ""; title: "Inbox"; subtitle: "Unclassified captures"; accent: Theme.accent;
                    destination: 0; tasks: root.inbox_tasks;
                    move_requested(id, destination) => { root.move_requested(id, destination); }
                    edit_requested(id) => { root.edit_requested(id); }
                    reorder_requested(id, direction) => { root.reorder_requested(id, direction); }
                    complete_requested(id) => { root.complete_requested(id); }
                    delete_requested(id) => { root.delete_requested(id); }
                }

                HorizontalLayout {
                    spacing: UiConstants.space_12;
                    TaskColumn {
                        content_sized: true;
                        code: "Q1"; title: "Important + Urgent"; subtitle: "Do now"; accent: Theme.q1_accent;
                        destination: 1; tasks: root.q1_tasks;
                        move_requested(id, destination) => { root.move_requested(id, destination); }
                        edit_requested(id) => { root.edit_requested(id); }
                        reorder_requested(id, direction) => { root.reorder_requested(id, direction); }
                        complete_requested(id) => { root.complete_requested(id); }
                        delete_requested(id) => { root.delete_requested(id); }
                    }
                    TaskColumn {
                        content_sized: true;
                        code: "Q2"; title: "Important + Not urgent"; subtitle: "Plan deliberately"; accent: Theme.q2_accent;
                        destination: 2; tasks: root.q2_tasks;
                        move_requested(id, destination) => { root.move_requested(id, destination); }
                        edit_requested(id) => { root.edit_requested(id); }
                        reorder_requested(id, direction) => { root.reorder_requested(id, direction); }
                        complete_requested(id) => { root.complete_requested(id); }
                        delete_requested(id) => { root.delete_requested(id); }
                    }
                }

                HorizontalLayout {
                    spacing: UiConstants.space_12;
                    TaskColumn {
                        content_sized: true;
                        code: "Q3"; title: "Not important + Urgent"; subtitle: "Delegate or contain"; accent: Theme.q3_accent;
                        destination: 3; tasks: root.q3_tasks;
                        move_requested(id, destination) => { root.move_requested(id, destination); }
                        edit_requested(id) => { root.edit_requested(id); }
                        reorder_requested(id, direction) => { root.reorder_requested(id, direction); }
                        complete_requested(id) => { root.complete_requested(id); }
                        delete_requested(id) => { root.delete_requested(id); }
                    }
                    TaskColumn {
                        content_sized: true;
                        code: "Q4"; title: "Not important + Not urgent"; subtitle: "Reduce or remove"; accent: Theme.q4_accent;
                        destination: 4; tasks: root.q4_tasks;
                        move_requested(id, destination) => { root.move_requested(id, destination); }
                        edit_requested(id) => { root.edit_requested(id); }
                        reorder_requested(id, direction) => { root.reorder_requested(id, direction); }
                        complete_requested(id) => { root.complete_requested(id); }
                        delete_requested(id) => { root.delete_requested(id); }
                    }
                }
            }

            if root.compact: VerticalLayout {
                spacing: UiConstants.space_12;

                TaskColumn {
                    content_sized: true; code: ""; title: "Inbox"; subtitle: "Unclassified captures"; accent: Theme.accent;
                    destination: 0; tasks: root.inbox_tasks;
                    move_requested(id, destination) => { root.move_requested(id, destination); } edit_requested(id) => { root.edit_requested(id); }
                    reorder_requested(id, direction) => { root.reorder_requested(id, direction); } complete_requested(id) => { root.complete_requested(id); }
                    delete_requested(id) => { root.delete_requested(id); }
                }
                TaskColumn {
                    content_sized: true; code: "Q1"; title: "Important + Urgent"; subtitle: "Do now"; accent: Theme.q1_accent;
                    destination: 1; tasks: root.q1_tasks;
                    move_requested(id, destination) => { root.move_requested(id, destination); } edit_requested(id) => { root.edit_requested(id); }
                    reorder_requested(id, direction) => { root.reorder_requested(id, direction); } complete_requested(id) => { root.complete_requested(id); }
                    delete_requested(id) => { root.delete_requested(id); }
                }
                TaskColumn {
                    content_sized: true; code: "Q2"; title: "Important + Not urgent"; subtitle: "Plan deliberately"; accent: Theme.q2_accent;
                    destination: 2; tasks: root.q2_tasks;
                    move_requested(id, destination) => { root.move_requested(id, destination); } edit_requested(id) => { root.edit_requested(id); }
                    reorder_requested(id, direction) => { root.reorder_requested(id, direction); } complete_requested(id) => { root.complete_requested(id); }
                    delete_requested(id) => { root.delete_requested(id); }
                }
                TaskColumn {
                    content_sized: true; code: "Q3"; title: "Not important + Urgent"; subtitle: "Delegate or contain"; accent: Theme.q3_accent;
                    destination: 3; tasks: root.q3_tasks;
                    move_requested(id, destination) => { root.move_requested(id, destination); } edit_requested(id) => { root.edit_requested(id); }
                    reorder_requested(id, direction) => { root.reorder_requested(id, direction); } complete_requested(id) => { root.complete_requested(id); }
                    delete_requested(id) => { root.delete_requested(id); }
                }
                TaskColumn {
                    content_sized: true; code: "Q4"; title: "Not important + Not urgent"; subtitle: "Reduce or remove"; accent: Theme.q4_accent;
                    destination: 4; tasks: root.q4_tasks;
                    move_requested(id, destination) => { root.move_requested(id, destination); } edit_requested(id) => { root.edit_requested(id); }
                    reorder_requested(id, direction) => { root.reorder_requested(id, direction); } complete_requested(id) => { root.complete_requested(id); }
                    delete_requested(id) => { root.delete_requested(id); }
                }
            }

            Rectangle { height: UiConstants.space_8; }
        }
    }
}
