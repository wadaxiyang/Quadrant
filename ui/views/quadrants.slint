import { Theme } from "../theme.slint";
import { UiConstants } from "../constants.slint";
import { PageHeader } from "../components/page_shell.slint";
import { SurfaceCard } from "../components/common.slint";

component QuadrantShellCard inherits SurfaceCard {
    in property <string> code;
    in property <string> title;
    in property <string> subtitle;
    in property <color> accent;

    Rectangle {
        width: 4px;
        height: 100%;
        background: root.accent;
        border-radius: 2px;
    }

    VerticalLayout {
        padding: 16px;
        spacing: 4px;

        Text {
            text: root.code + "  " + root.title;
            color: Theme.text_primary;
            font-size: 15px;
            font-weight: 600;
        }

        Text {
            text: root.subtitle;
            color: Theme.text_secondary;
            font-size: 11px;
        }

        Rectangle { vertical-stretch: 1; }

        Text {
            text: "Task cards arrive with M2 persistence";
            color: Theme.text_secondary;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }
}

export component QuadrantsView inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding: UiConstants.page_padding;
        spacing: 16px;

        PageHeader {
            title: "Quadrants";
            subtitle: "Capture in Inbox, then classify by importance and urgency.";
        }

        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 1;

            SurfaceCard {
                width: 220px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "Inbox"; color: Theme.text_primary; font-size: 16px; font-weight: 600; }
                    Text { text: "Unclassified captures appear here."; color: Theme.text_secondary; font-size: 11px; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; }
                    Text { text: "Quick Add is ready for keyboard capture."; color: Theme.accent; font-size: 11px; wrap: word-wrap; }
                }
            }

            VerticalLayout {
                spacing: 12px;
                horizontal-stretch: 1;

                HorizontalLayout {
                    spacing: 12px;
                    QuadrantShellCard { code: "Q1"; title: "Important + Urgent"; subtitle: "Do now"; accent: #d13438; }
                    QuadrantShellCard { code: "Q2"; title: "Important + Not urgent"; subtitle: "Plan deliberately"; accent: #107c10; }
                }

                HorizontalLayout {
                    spacing: 12px;
                    QuadrantShellCard { code: "Q3"; title: "Not important + Urgent"; subtitle: "Delegate or contain"; accent: #ca5010; }
                    QuadrantShellCard { code: "Q4"; title: "Not important + Not urgent"; subtitle: "Reduce or remove"; accent: #5c2d91; }
                }
            }
        }
    }
}
