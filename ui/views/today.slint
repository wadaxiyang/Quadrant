import { ScrollView } from "std-widgets.slint";
import { Theme, Typography } from "../theme.slint";
import { UiConstants } from "../constants.slint";
import { Badge, BadgeKind, SurfaceCard } from "../components/common.slint";
import { EmptyState, PageHeader, SectionHeader } from "../components/page_shell.slint";
import { IconButton } from "../components/icon.slint";
import { Icons } from "../icons.slint";

export struct TodayTaskRow {
    id: string,
    title: string,
    metadata: string,
}

component TodayTaskListRow inherits Rectangle {
    in property <TodayTaskRow> task;
    callback edit_requested(string);
    callback complete_requested(string);

    height: 60px;
    background: transparent;

    HorizontalLayout {
        padding-left: UiConstants.space_8;
        padding-right: UiConstants.space_8;
        spacing: UiConstants.space_8;
        alignment: center;

        IconButton {
            icon: Icons.complete;
            tooltip: "Complete task";
            clicked => { root.complete_requested(root.task.id); }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: UiConstants.space_4;
            alignment: center;

            Text {
                text: root.task.title;
                color: Theme.text_primary;
                font-size: Typography.body;
                font-weight: Typography.semibold;
                overflow: elide;
            }

            Text {
                text: root.task.metadata;
                color: Theme.text_secondary;
                font-size: Typography.caption;
                overflow: elide;
            }
        }

        IconButton {
            icon: Icons.edit;
            tooltip: "Edit task";
            clicked => { root.edit_requested(root.task.id); }
        }
    }

}

component TodaySection inherits SurfaceCard {
    in property <string> title;
    in property <string> subtitle;
    in property <color> accent;
    in property <BadgeKind> badge_kind: BadgeKind.neutral;
    in property <[TodayTaskRow]> tasks;
    callback edit_requested(string);
    callback complete_requested(string);

    min-height: 92px;
    preferred-height: section_content.preferred-height;
    vertical-stretch: 0;

    Rectangle {
        x: 0px;
        width: 4px;
        height: 100%;
        background: root.accent;
        border-radius: 2px;
    }

    section_content := VerticalLayout {
        padding: UiConstants.space_12;
        spacing: 0px;

        SectionHeader {
            title: root.title;
            description: root.subtitle;
            badge_text: root.tasks.length + (root.tasks.length == 1 ? " task" : " tasks");
            badge_kind: root.badge_kind;
        }

        for task[index] in root.tasks: VerticalLayout {
            spacing: 0px;

            TodayTaskListRow {
                task: task;
                edit_requested(id) => { root.edit_requested(id); }
                complete_requested(id) => { root.complete_requested(id); }
            }

            if index < root.tasks.length - 1: Rectangle {
                height: 1px;
                background: Theme.divider;
            }
        }
    }
}

export component TodayView inherits Rectangle {
    in property <[TodayTaskRow]> overdue_tasks;
    in property <[TodayTaskRow]> planned_today_tasks;
    in property <[TodayTaskRow]> due_today_tasks;
    in property <[TodayTaskRow]> needs_reschedule_tasks;
    in property <int> unique_task_count;
    callback edit_requested(string);
    callback complete_requested(string);

    property <bool> compact: root.width < UiConstants.compact_breakpoint;
    property <bool> wide: root.width >= UiConstants.wide_breakpoint;
    property <length> responsive_padding: root.compact ? UiConstants.page_padding_compact :
                                                   root.wide ? UiConstants.page_padding_wide : UiConstants.page_padding_medium;

    background: transparent;

    ScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding: root.responsive_padding;
            spacing: UiConstants.space_16;

            PageHeader {
                title: "Today";
                subtitle: "Plans, deadlines, and work that needs attention now.";
            }

            HorizontalLayout {
                spacing: UiConstants.space_8;
                Badge {
                    text: root.unique_task_count + (root.unique_task_count == 1 ? " task needs attention" : " tasks need attention");
                    kind: root.unique_task_count > 0 ? BadgeKind.accent : BadgeKind.neutral;
                }
                Rectangle { horizontal-stretch: 1; }
            }

            if root.overdue_tasks.length > 0: TodaySection {
                title: "Overdue";
                subtitle: "Deadlines before the current instant";
                accent: Theme.danger;
                badge_kind: BadgeKind.danger;
                tasks: root.overdue_tasks;
                edit_requested(id) => { root.edit_requested(id); }
                complete_requested(id) => { root.complete_requested(id); }
            }

            if root.planned_today_tasks.length > 0: TodaySection {
                title: "Planned today";
                subtitle: "Work intentionally scheduled for the local date";
                accent: Theme.accent;
                badge_kind: BadgeKind.accent;
                tasks: root.planned_today_tasks;
                edit_requested(id) => { root.edit_requested(id); }
                complete_requested(id) => { root.complete_requested(id); }
            }

            if root.due_today_tasks.length > 0: TodaySection {
                title: "Due today";
                subtitle: "Deadlines inside today's local calendar boundaries";
                accent: Theme.success;
                badge_kind: BadgeKind.success;
                tasks: root.due_today_tasks;
                edit_requested(id) => { root.edit_requested(id); }
                complete_requested(id) => { root.complete_requested(id); }
            }

            if root.needs_reschedule_tasks.length > 0: TodaySection {
                title: "Needs rescheduling";
                subtitle: "Unfinished work planned before today";
                accent: Theme.warning;
                badge_kind: BadgeKind.warning;
                tasks: root.needs_reschedule_tasks;
                edit_requested(id) => { root.edit_requested(id); }
                complete_requested(id) => { root.complete_requested(id); }
            }

            if root.unique_task_count == 0: EmptyState {
                vertical-stretch: 0;
                title: "Nothing needs attention today";
                message: "Plan a task for today or add a due date from the task editor.";
            }

            Rectangle { min-height: UiConstants.space_8; vertical-stretch: 1; }
        }
    }
}
