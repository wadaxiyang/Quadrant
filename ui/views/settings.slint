import { ScrollView, Switch } from "std-widgets.slint";
import {
    Badge,
    BadgeKind,
    FluentButton,
    PageHeader,
    SectionHeader,
    SegmentButton,
    SettingRow,
    SurfaceCard,
    Theme,
    ThemeMode,
    Typography,
    UiConstants,
} from "../kit/kit.slint";

export component SettingsView inherits Rectangle {
    in property <ThemeMode> theme_mode: ThemeMode.system;
    in property <bool> launch_at_startup: false;
    in property <bool> start_hidden: false;
    in property <bool> close_to_tray: true;
    in property <bool> minimize_to_tray: false;
    in property <bool> autostart_supported: false;
    in property <bool> tray_supported: false;
    in property <bool> global_hotkey_available: false;
    in property <bool> native_notifications_available: false;
    in property <bool> single_instance_available: false;
    in property <string> backup_directory;
    in property <string> latest_backup: "No backup created yet";
    in property <bool> restore_pending: false;
    in property <string> application_version: "0.1.0";
    in property <string> update_description;
    in property <bool> can_open_releases: true;
    changed launch_at_startup => { launch_at_startup_switch.checked = root.launch_at_startup; }
    changed start_hidden => { start_hidden_switch.checked = root.start_hidden; }
    changed close_to_tray => { close_to_tray_switch.checked = root.close_to_tray; }
    callback theme_selected(ThemeMode);
    callback desktop_settings_changed(bool, bool, bool, bool);
    callback create_backup_requested;
    callback open_backup_directory_requested;
    callback restore_latest_requested;
    callback open_releases_requested;

    property <bool> compact: root.width < UiConstants.compact_breakpoint;
    property <bool> wide: root.width >= UiConstants.wide_breakpoint;
    property <length> responsive_padding: root.compact ? UiConstants.page_padding_compact :
                                                   root.wide ? UiConstants.page_padding_wide : UiConstants.page_padding_medium;
    property <length> content_width: min(root.width - 2 * root.responsive_padding, 900px);

    ScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding-top: root.responsive_padding;
            padding-bottom: root.responsive_padding;

            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }

                settings_content := VerticalLayout {
                    width: root.content_width;
                    spacing: UiConstants.space_16;

                    PageHeader {
                        title: "Settings";
                        subtitle: "Persistent preferences, backups, and platform capabilities.";
                    }

                    SurfaceCard {
                        preferred-height: appearance_layout.preferred-height;
                        vertical-stretch: 0;

                        appearance_layout := VerticalLayout {
                            padding: UiConstants.space_16;
                            spacing: UiConstants.space_12;

                            SectionHeader {
                                title: "Appearance";
                                description: "System follows the normalized platform theme source.";
                            }

                            HorizontalLayout {
                                spacing: UiConstants.space_8;
                                SegmentButton { width: 104px; text: "System"; selected: root.theme_mode == ThemeMode.system; clicked => { root.theme_selected(ThemeMode.system); } }
                                SegmentButton { width: 104px; text: "Light"; selected: root.theme_mode == ThemeMode.light; clicked => { root.theme_selected(ThemeMode.light); } }
                                SegmentButton { width: 104px; text: "Dark"; selected: root.theme_mode == ThemeMode.dark; clicked => { root.theme_selected(ThemeMode.dark); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }

                    SurfaceCard {
                        preferred-height: desktop_layout.preferred-height;
                        vertical-stretch: 0;

                        desktop_layout := VerticalLayout {
                            padding: UiConstants.space_16;
                            spacing: UiConstants.space_4;

                            SectionHeader {
                                title: "Desktop integration";
                                description: "Platform capabilities and window behavior.";
                            }

                            if !root.compact: HorizontalLayout {
                                spacing: UiConstants.space_8;
                                Badge { text: "Quick Add " + (root.global_hotkey_available ? "ready" : "unavailable"); kind: root.global_hotkey_available ? BadgeKind.success : BadgeKind.neutral; }
                                Badge { text: "Notifications " + (root.native_notifications_available ? "ready" : "unavailable"); kind: root.native_notifications_available ? BadgeKind.success : BadgeKind.neutral; }
                                Badge { text: "Single instance " + (root.single_instance_available ? "ready" : "unavailable"); kind: root.single_instance_available ? BadgeKind.success : BadgeKind.neutral; }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            if root.compact: VerticalLayout {
                                spacing: UiConstants.space_6;
                                Badge { text: "Quick Add " + (root.global_hotkey_available ? "ready" : "unavailable"); kind: root.global_hotkey_available ? BadgeKind.success : BadgeKind.neutral; }
                                Badge { text: "Notifications " + (root.native_notifications_available ? "ready" : "unavailable"); kind: root.native_notifications_available ? BadgeKind.success : BadgeKind.neutral; }
                                Badge { text: "Single instance " + (root.single_instance_available ? "ready" : "unavailable"); kind: root.single_instance_available ? BadgeKind.success : BadgeKind.neutral; }
                            }

                            SettingRow {
                                title: "Launch at startup";
                                description: root.autostart_supported ? "Start Quadrant after login." : "Unavailable on this platform.";
                                enabled: root.autostart_supported;
                                launch_at_startup_switch := Switch {
                                    text: "";
                                    accessible-label: "Launch at startup";
                                    enabled: root.autostart_supported;
                                    checked: root.launch_at_startup;
                                    toggled => {
                                        self.checked = root.launch_at_startup;
                                        root.desktop_settings_changed(!root.launch_at_startup, root.start_hidden, root.close_to_tray, root.minimize_to_tray);
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Theme.divider; }

                            SettingRow {
                                title: "Start in background";
                                description: root.tray_supported ? "Start only the background service at login; open the interface from the tray." : "Requires a working tray icon.";
                                enabled: root.tray_supported;
                                start_hidden_switch := Switch {
                                    text: "";
                                    accessible-label: "Start in background";
                                    enabled: root.tray_supported;
                                    checked: root.start_hidden;
                                    toggled => {
                                        self.checked = root.start_hidden;
                                        root.desktop_settings_changed(root.launch_at_startup, !root.start_hidden, root.close_to_tray, root.minimize_to_tray);
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Theme.divider; }

                            SettingRow {
                                title: "Close to tray";
                                description: root.tray_supported ? "Close releases the interface; reminders and Focus keep running. Use tray Exit to quit Quadrant." : "Requires a working tray icon.";
                                enabled: root.tray_supported;
                                close_to_tray_switch := Switch {
                                    text: "";
                                    accessible-label: "Close to tray";
                                    enabled: root.tray_supported;
                                    checked: root.close_to_tray;
                                    toggled => {
                                        self.checked = root.close_to_tray;
                                        root.desktop_settings_changed(root.launch_at_startup, root.start_hidden, !root.close_to_tray, root.minimize_to_tray);
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Theme.divider; }

                            SettingRow {
                                title: "Minimize to taskbar";
                                description: "Minimizing keeps the window ready to restore. Closing to tray releases the interface.";
                            }
                        }
                    }

                    SurfaceCard {
                        preferred-height: backup_layout.preferred-height;
                        vertical-stretch: 0;

                        backup_layout := VerticalLayout {
                            padding: UiConstants.space_16;
                            spacing: UiConstants.space_10;

                            SectionHeader {
                                title: "Backup and restore";
                                description: "Create a validated local snapshot or stage the latest snapshot for restart.";
                            }

                            VerticalLayout {
                                spacing: UiConstants.space_4;
                                Text { text: "Latest backup"; color: Theme.text_primary; font-size: Typography.caption; font-weight: Typography.semibold; }
                                Text { text: root.latest_backup; color: Theme.text_secondary; font-size: Typography.caption; overflow: elide; }
                            }

                            VerticalLayout {
                                spacing: UiConstants.space_4;
                                Text { text: "Backup directory"; color: Theme.text_primary; font-size: Typography.caption; font-weight: Typography.semibold; }
                                Text { text: root.backup_directory; color: Theme.text_secondary; font-size: Typography.caption; overflow: elide; }
                            }

                            if root.restore_pending: Rectangle {
                                min-height: 48px;
                                background: Theme.warning.with-alpha(0.10);
                                border-width: 1px;
                                border-color: Theme.warning;
                                border-radius: UiConstants.control_radius;

                                HorizontalLayout {
                                    padding-left: UiConstants.space_12;
                                    padding-right: UiConstants.space_12;
                                    spacing: UiConstants.space_8;

                                    VerticalLayout {
                                        alignment: center;
                                        Badge { text: "Restart required"; kind: BadgeKind.warning; }
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: "Use Exit in the tray, then reopen Quadrant to apply the restore. Closing only the window keeps the background service running.";
                                        color: Theme.text_primary;
                                        font-size: Typography.caption;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if !root.compact: HorizontalLayout {
                                spacing: UiConstants.space_8;
                                FluentButton { text: "Create backup"; primary: true; clicked => { root.create_backup_requested(); } }
                                FluentButton { text: "Open folder"; clicked => { root.open_backup_directory_requested(); } }
                                FluentButton {
                                    text: "Restore latest";
                                    danger: true;
                                    enabled: root.latest_backup != "No backup created yet" && !root.restore_pending;
                                    clicked => { root.restore_latest_requested(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            if root.compact: VerticalLayout {
                                spacing: UiConstants.space_8;
                                FluentButton { text: "Create backup"; primary: true; clicked => { root.create_backup_requested(); } }
                                FluentButton { text: "Open folder"; clicked => { root.open_backup_directory_requested(); } }
                                FluentButton {
                                    text: "Restore latest";
                                    danger: true;
                                    enabled: root.latest_backup != "No backup created yet" && !root.restore_pending;
                                    clicked => { root.restore_latest_requested(); }
                                }
                            }
                        }
                    }

                    SurfaceCard {
                        preferred-height: updates_layout.preferred-height;
                        vertical-stretch: 0;

                        updates_layout := VerticalLayout {
                            padding-left: UiConstants.space_16;
                            padding-right: UiConstants.space_16;

                            SettingRow {
                                title: "Version " + root.application_version;
                                description: root.update_description;
                                FluentButton {
                                    text: "Open releases";
                                    enabled: root.can_open_releases;
                                    clicked => { root.open_releases_requested(); }
                                }
                            }
                        }
                    }

                    Rectangle { height: UiConstants.space_8; }
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}
