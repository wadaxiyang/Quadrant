import { ScrollView } from "std-widgets.slint";
import {
    Badge,
    BadgeKind,
    MetricCard,
    PageHeader,
    SectionHeader,
    SegmentButton,
    SurfaceCard,
    Theme,
    Typography,
    UiConstants,
} from "../kit/kit.slint";

export struct ReviewActivityRow {
    label: string,
    completed: int,
    focus_seconds: int,
}

export struct ReviewQuadrantRow {
    label: string,
    completed: int,
    focus_seconds: int,
    focus_text: string,
}

export struct ReviewRecentRow {
    title: string,
    metadata: string,
}

component ChartLegend inherits HorizontalLayout {
    in property <color> swatch;
    in property <string> text;

    spacing: UiConstants.space_6;

    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 2px;
            background: root.swatch;
        }
    }

    Text {
        text: root.text;
        color: Theme.text_secondary;
        font-size: Typography.caption;
        vertical-alignment: center;
    }
}

component ActivityRow inherits Rectangle {
    in property <ReviewActivityRow> item;
    in property <int> completed_max: 1;
    in property <int> focus_max: 1;

    height: 46px;

    HorizontalLayout {
        spacing: UiConstants.space_8;

        Text {
            width: 76px;
            text: root.item.label;
            color: Theme.text_secondary;
            font-size: Typography.caption;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: UiConstants.space_6;
            alignment: center;

            Rectangle {
                height: 8px;
                background: Theme.divider;
                border-radius: 4px;
                Rectangle {
                    width: parent.width * root.item.completed / max(root.completed_max, 1);
                    height: 100%;
                    background: Theme.accent;
                    border-radius: 4px;
                }
            }

            Rectangle {
                height: 8px;
                background: Theme.divider;
                border-radius: 4px;
                Rectangle {
                    width: parent.width * root.item.focus_seconds / max(root.focus_max, 1);
                    height: 100%;
                    background: Theme.success;
                    border-radius: 4px;
                }
            }
        }

        Text {
            width: 78px;
            text: root.item.completed + " / " + root.item.focus_seconds / 60 + "m";
            color: Theme.text_secondary;
            font-size: Typography.caption;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

component QuadrantRow inherits Rectangle {
    in property <ReviewQuadrantRow> item;
    in property <int> completed_max: 1;
    in property <int> focus_max: 1;

    height: 46px;

    HorizontalLayout {
        spacing: UiConstants.space_8;

        Text {
            width: 56px;
            text: root.item.label;
            color: Theme.text_primary;
            font-size: Typography.caption;
            font-weight: Typography.semibold;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: UiConstants.space_6;
            alignment: center;

            Rectangle {
                height: 8px;
                background: Theme.divider;
                border-radius: 4px;
                Rectangle {
                    width: parent.width * root.item.completed / max(root.completed_max, 1);
                    height: 100%;
                    background: Theme.accent;
                    border-radius: 4px;
                }
            }

            Rectangle {
                height: 8px;
                background: Theme.divider;
                border-radius: 4px;
                Rectangle {
                    width: parent.width * root.item.focus_seconds / max(root.focus_max, 1);
                    height: 100%;
                    background: Theme.success;
                    border-radius: 4px;
                }
            }
        }

        Text {
            width: 92px;
            text: root.item.completed + " · " + root.item.focus_text;
            color: Theme.text_secondary;
            font-size: Typography.caption;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

component ActivityCard inherits SurfaceCard {
    in property <[ReviewActivityRow]> activity;
    in property <int> completed_max: 1;
    in property <int> focus_max: 1;

    height: max(144px, 112px + root.activity.length * 54px);
    vertical-stretch: 0;

    activity_layout := VerticalLayout {
        padding: UiConstants.space_16;
        spacing: UiConstants.space_8;

        SectionHeader {
            title: "Activity";
            description: "Completion and productive Focus by period.";
        }

        HorizontalLayout {
            spacing: UiConstants.space_16;
            ChartLegend { swatch: Theme.accent; text: "Completed tasks"; }
            ChartLegend { swatch: Theme.success; text: "Focus time"; }
            Rectangle { horizontal-stretch: 1; }
        }

        if root.activity.length == 0: Text {
            height: 40px;
            text: "No activity in this range.";
            color: Theme.text_tertiary;
            font-size: Typography.caption;
            vertical-alignment: center;
        }

        for item in root.activity: ActivityRow {
            item: item;
            completed_max: root.completed_max;
            focus_max: root.focus_max;
        }
    }
}

component PlacementCard inherits SurfaceCard {
    in property <[ReviewQuadrantRow]> quadrants;
    in property <int> completed_max: 1;
    in property <int> focus_max: 1;

    height: max(144px, 112px + root.quadrants.length * 54px);
    vertical-stretch: 0;

    placement_layout := VerticalLayout {
        padding: UiConstants.space_16;
        spacing: UiConstants.space_8;

        SectionHeader {
            title: "By placement";
            description: "Completed tasks and associated Focus time.";
        }

        HorizontalLayout {
            spacing: UiConstants.space_16;
            ChartLegend { swatch: Theme.accent; text: "Completed"; }
            ChartLegend { swatch: Theme.success; text: "Focus"; }
            Rectangle { horizontal-stretch: 1; }
        }

        for item in root.quadrants: QuadrantRow {
            item: item;
            completed_max: root.completed_max;
            focus_max: root.focus_max;
        }
    }
}

component FocusHighlightsCard inherits SurfaceCard {
    in property <string> longest_focus;
    in property <string> top_task;
    in property <string> top_task_detail;
    in property <string> top_quadrant;

    min-height: 176px;
    preferred-height: max(root.min-height, highlights_layout.preferred-height);
    vertical-stretch: 0;

    highlights_layout := VerticalLayout {
        padding: UiConstants.space_16;
        spacing: UiConstants.space_8;

        SectionHeader {
            title: "Focus highlights";
            description: "Productive sessions in the selected range.";
        }

        HorizontalLayout {
            spacing: UiConstants.space_12;
            Text { text: "Longest session"; color: Theme.text_secondary; font-size: Typography.caption; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.longest_focus; color: Theme.text_primary; font-size: Typography.body; font-weight: Typography.semibold; }
        }

        Rectangle { height: 1px; background: Theme.divider; }

        VerticalLayout {
            spacing: UiConstants.space_4;
            Text { text: "Most focused task"; color: Theme.text_secondary; font-size: Typography.caption; }
            Text { text: root.top_task; color: Theme.text_primary; font-size: Typography.body; font-weight: Typography.semibold; overflow: elide; }
            Text { text: root.top_task_detail; color: Theme.text_secondary; font-size: Typography.caption; wrap: word-wrap; }
            HorizontalLayout {
                Badge { text: root.top_quadrant; kind: BadgeKind.accent; }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}

component RecentCompletionsCard inherits SurfaceCard {
    in property <[ReviewRecentRow]> recent;

    height: max(144px, 80px + root.recent.length * 49px);
    vertical-stretch: 0;

    recent_layout := VerticalLayout {
        padding: UiConstants.space_16;
        spacing: 0px;

        SectionHeader {
            title: "Recent completions";
            description: "Immutable completion snapshots from this range.";
            badge_text: root.recent.length + (root.recent.length == 1 ? " item" : " items");
        }

        if root.recent.length == 0: Text {
            height: 48px;
            text: "No completion history in this range.";
            color: Theme.text_tertiary;
            font-size: Typography.caption;
            vertical-alignment: center;
        }

        for item[index] in root.recent: VerticalLayout {
            if index > 0: Rectangle { height: 1px; background: Theme.divider; }

            HorizontalLayout {
                height: 48px;
                spacing: UiConstants.space_12;

                Text {
                    horizontal-stretch: 1;
                    text: item.title;
                    color: Theme.text_primary;
                    font-size: Typography.body;
                    font-weight: Typography.semibold;
                    overflow: elide;
                    vertical-alignment: center;
                }

                Text {
                    text: item.metadata;
                    color: Theme.text_secondary;
                    font-size: Typography.caption;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
        }
    }
}

export component ReviewView inherits Rectangle {
    in-out property <int> selected_range: 0;
    in property <string> completed_value: "0";
    in property <string> completed_hint;
    in property <string> focus_value: "0m";
    in property <string> focus_hint;
    in property <string> sessions_value: "0";
    in property <string> sessions_hint;
    in property <string> average_value: "0m";
    in property <string> state_summary;
    in property <[ReviewActivityRow]> activity;
    in property <int> activity_completed_max: 1;
    in property <int> activity_focus_max: 1;
    in property <[ReviewQuadrantRow]> quadrants;
    in property <int> quadrant_completed_max: 1;
    in property <int> quadrant_focus_max: 1;
    in property <string> longest_focus;
    in property <string> top_task;
    in property <string> top_task_detail;
    in property <string> top_quadrant;
    in property <[ReviewRecentRow]> recent;
    callback range_selected(int);

    property <bool> compact: root.width < UiConstants.compact_breakpoint;
    property <bool> wide: root.width >= UiConstants.wide_breakpoint;
    property <length> responsive_padding: root.compact ? UiConstants.page_padding_compact :
                                                   root.wide ? UiConstants.page_padding_wide : UiConstants.page_padding_medium;

    ScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding: root.responsive_padding;
            spacing: UiConstants.space_16;

            PageHeader {
                title: "Review";
                subtitle: "Completion and productive Focus history from immutable events.";
            }

            if !root.compact: HorizontalLayout {
                spacing: UiConstants.space_8;
                SegmentButton { width: 76px; text: "7 days"; selected: root.selected_range == 0; clicked => { root.selected_range = 0; root.range_selected(0); } }
                SegmentButton { width: 76px; text: "30 days"; selected: root.selected_range == 1; clicked => { root.selected_range = 1; root.range_selected(1); } }
                SegmentButton { width: 76px; text: "90 days"; selected: root.selected_range == 2; clicked => { root.selected_range = 2; root.range_selected(2); } }
                SegmentButton { width: 76px; text: "All time"; selected: root.selected_range == 3; clicked => { root.selected_range = 3; root.range_selected(3); } }
                Rectangle { horizontal-stretch: 1; }
            }

            if root.compact: GridLayout {
                spacing: UiConstants.space_8;
                SegmentButton { row: 0; col: 0; text: "7 days"; selected: root.selected_range == 0; clicked => { root.selected_range = 0; root.range_selected(0); } }
                SegmentButton { row: 0; col: 1; text: "30 days"; selected: root.selected_range == 1; clicked => { root.selected_range = 1; root.range_selected(1); } }
                SegmentButton { row: 1; col: 0; text: "90 days"; selected: root.selected_range == 2; clicked => { root.selected_range = 2; root.range_selected(2); } }
                SegmentButton { row: 1; col: 1; text: "All time"; selected: root.selected_range == 3; clicked => { root.selected_range = 3; root.range_selected(3); } }
            }

            Text {
                text: root.state_summary;
                color: Theme.text_secondary;
                font-size: Typography.caption;
                wrap: word-wrap;
            }

            if root.wide: HorizontalLayout {
                spacing: UiConstants.space_10;
                MetricCard { horizontal-stretch: 1; label: "Completed"; value: root.completed_value; hint: root.completed_hint; }
                MetricCard { horizontal-stretch: 1; label: "Focused time"; value: root.focus_value; hint: root.focus_hint; }
                MetricCard { horizontal-stretch: 1; label: "Focus sessions"; value: root.sessions_value; hint: root.sessions_hint; }
                MetricCard { horizontal-stretch: 1; label: "Average focus"; value: root.average_value; hint: "productive sessions only"; }
            }

            if !root.wide && !root.compact: GridLayout {
                spacing: UiConstants.space_10;
                MetricCard { row: 0; col: 0; label: "Completed"; value: root.completed_value; hint: root.completed_hint; }
                MetricCard { row: 0; col: 1; label: "Focused time"; value: root.focus_value; hint: root.focus_hint; }
                MetricCard { row: 1; col: 0; label: "Focus sessions"; value: root.sessions_value; hint: root.sessions_hint; }
                MetricCard { row: 1; col: 1; label: "Average focus"; value: root.average_value; hint: "productive sessions only"; }
            }

            if root.compact: VerticalLayout {
                spacing: UiConstants.space_8;
                MetricCard { label: "Completed"; value: root.completed_value; hint: root.completed_hint; }
                MetricCard { label: "Focused time"; value: root.focus_value; hint: root.focus_hint; }
                MetricCard { label: "Focus sessions"; value: root.sessions_value; hint: root.sessions_hint; }
                MetricCard { label: "Average focus"; value: root.average_value; hint: "productive sessions only"; }
            }

            if root.wide: HorizontalLayout {
                spacing: UiConstants.space_12;
                ActivityCard {
                    horizontal-stretch: 2;
                    activity: root.activity;
                    completed_max: root.activity_completed_max;
                    focus_max: root.activity_focus_max;
                }
                PlacementCard {
                    horizontal-stretch: 1;
                    quadrants: root.quadrants;
                    completed_max: root.quadrant_completed_max;
                    focus_max: root.quadrant_focus_max;
                }
            }

            if !root.wide: VerticalLayout {
                spacing: UiConstants.space_12;
                ActivityCard { activity: root.activity; completed_max: root.activity_completed_max; focus_max: root.activity_focus_max; }
                PlacementCard { quadrants: root.quadrants; completed_max: root.quadrant_completed_max; focus_max: root.quadrant_focus_max; }
            }

            if root.wide: HorizontalLayout {
                spacing: UiConstants.space_12;
                FocusHighlightsCard {
                    horizontal-stretch: 1;
                    longest_focus: root.longest_focus;
                    top_task: root.top_task;
                    top_task_detail: root.top_task_detail;
                    top_quadrant: root.top_quadrant;
                }
                RecentCompletionsCard { horizontal-stretch: 2; recent: root.recent; }
            }

            if !root.wide: VerticalLayout {
                spacing: UiConstants.space_12;
                FocusHighlightsCard {
                    longest_focus: root.longest_focus;
                    top_task: root.top_task;
                    top_task_detail: root.top_task_detail;
                    top_quadrant: root.top_quadrant;
                }
                RecentCompletionsCard { recent: root.recent; }
            }

            Rectangle { height: UiConstants.space_8; }
        }
    }
}
