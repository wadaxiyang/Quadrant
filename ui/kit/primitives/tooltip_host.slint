import { Theme, Typography } from "../foundation/theme.slint";
import { UiConstants } from "../foundation/constants.slint";

export component TooltipHost inherits Rectangle {
    in property <string> text;
    in property <bool> shown: false;

    visible: root.shown && root.text != "";
    width: tooltip_label.preferred-width + UiConstants.space_16;
    height: 28px;
    background: Theme.dark_mode ? #f2f2f2 : #2b2b2b;
    border-radius: UiConstants.control_radius;
    z: 500;

    tooltip_label := Text {
        text: root.text;
        color: Theme.dark_mode ? #202020 : #ffffff;
        font-size: Typography.caption;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
