// Derived from wsl-dashboard src/ui/components/common.slint at
// 948589a255a4bd8a3ff9c3de49e2e13109378fcd.

import { Typography } from "../foundation/theme.slint";
import { TextEdit } from "std-widgets.slint";

export component FluentTextArea inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder_text;
    in property <bool> enabled: true;
    callback edited(string);

    forward-focus: area_input;
    min-height: 76px;
    background: transparent;

    area_input := TextEdit {
        width: 100%;
        height: 100%;
        text <=> root.text;
        placeholder-text: root.placeholder_text;
        font-size: Typography.body;
        wrap: word-wrap;
        enabled: root.enabled;
        edited => { root.edited(self.text); }
    }
}
