import { Theme, Typography } from "../../foundation/theme.slint";
import { UiConstants } from "../../foundation/constants.slint";
import { Badge, BadgeKind } from "../../primitives/badge.slint";

export component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> badge_text;
    in property <BadgeKind> badge_kind: BadgeKind.neutral;

    min-height: root.description == "" ? 32px : 48px;
    preferred-height: max(root.min-height, section_layout.preferred-height);

    section_layout := HorizontalLayout {
        spacing: UiConstants.space_12;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: UiConstants.space_4;
            alignment: center;

            Text {
                text: root.title;
                color: Theme.text_primary;
                font-size: 16px;
                font-weight: Typography.semibold;
            }

            if root.description != "": Text {
                text: root.description;
                color: Theme.text_secondary;
                font-size: Typography.caption;
                wrap: word-wrap;
            }
        }

        if root.badge_text != "": Badge {
            text: root.badge_text;
            kind: root.badge_kind;
        }

        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            @children
        }
    }
}
