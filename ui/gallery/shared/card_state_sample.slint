import { SurfaceCard, Theme, Typography } from "../../kit/kit.slint";

export component CardStateSample inherits SurfaceCard {
    in property <string> label;
    min-height: 56px;
    accessible_name: root.label;

    Text {
        text: root.label;
        color: Theme.text_primary;
        font-size: Typography.caption;
        font-weight: Typography.semibold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
