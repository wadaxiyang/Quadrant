import { UiConstants } from "../../constants.slint";
import { GalleryLabel } from "gallery_label.slint";

export component StateSpecimen inherits VerticalLayout {
    in property <string> label;
    spacing: UiConstants.space_4;

    GalleryLabel {
        text: root.label;
        horizontal-alignment: center;
    }
}
