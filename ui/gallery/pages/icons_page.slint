import { FluentIcon, FluentIcons, IconButton, SurfaceCard, Theme, UiConstants } from "../../kit/kit.slint";
import { GalleryLabel } from "../shared/gallery_label.slint";
import { StateSpecimen } from "../shared/state_specimen.slint";

export component IconsPage inherits SurfaceCard {
    preferred-height: icon_states.preferred-height;

    icon_states := VerticalLayout {
        padding: UiConstants.space_16;
        spacing: UiConstants.space_12;

        GalleryLabel { text: "IconButton interaction states"; }

        HorizontalLayout {
            spacing: UiConstants.space_12;
            StateSpecimen { horizontal-stretch: 1; label: "Normal"; IconButton { icon: FluentIcons.add; tooltip: "Normal"; } }
            StateSpecimen { horizontal-stretch: 1; label: "Hover"; IconButton { icon: FluentIcons.add; tooltip: "Hover"; preview_hover: true; } }
            StateSpecimen { horizontal-stretch: 1; label: "Pressed"; IconButton { icon: FluentIcons.add; tooltip: "Pressed"; preview_pressed: true; } }
            StateSpecimen { horizontal-stretch: 1; label: "Keyboard focus"; IconButton { icon: FluentIcons.add; tooltip: "Focused"; preview_focus: true; } }
            StateSpecimen { horizontal-stretch: 1; label: "Danger"; IconButton { icon: FluentIcons.delete; tooltip: "Delete"; danger: true; preview_hover: true; } }
            StateSpecimen { horizontal-stretch: 1; label: "Disabled"; IconButton { icon: FluentIcons.dismiss; tooltip: "Disabled"; enabled: false; } }
        }

        HorizontalLayout {
            spacing: UiConstants.space_12;
            GalleryLabel { text: "Semantic icons"; width: 116px; vertical-alignment: center; }
            FluentIcon { source: FluentIcons.quadrants_regular; size: 20px; }
            FluentIcon { source: FluentIcons.quadrants_filled; size: 20px; icon_color: Theme.accent; }
            FluentIcon { source: FluentIcons.status_info; size: 24px; icon_color: Theme.accent; }
            FluentIcon { source: FluentIcons.status_success; size: 24px; icon_color: Theme.success; }
            FluentIcon { source: FluentIcons.status_warning; size: 24px; icon_color: Theme.warning; }
            FluentIcon { source: FluentIcons.status_error; size: 24px; icon_color: Theme.danger; }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}
