// Derived from wsl-dashboard src/ui/components/common.slint at
// 948589a255a4bd8a3ff9c3de49e2e13109378fcd. Font glyph icons and WSL-only
// controls were replaced by semantic SVG images.

import { Theme } from "../theme.slint";

export component SidebarItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <color> icon_color: Theme.icon_color_slate;
    in property <bool> selected: false;
    in property <bool> collapsed: false;
    callback clicked;

    height: 36px;
    border-radius: 4px;
    background: selected ? Theme.selected_bg : (touch.has-hover ? Theme.hover_bg : transparent);

    Rectangle {
        visible: root.collapsed && touch.has-hover;
        x: parent.width + 8px;
        y: (parent.height - self.height) / 2;
        width: tooltip_label.preferred-width + 16px;
        height: 28px;
        background: #333333;
        border-radius: 4px;
        z: 100;

        tooltip_label := Text {
            text: root.text;
            color: white;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    HorizontalLayout {
        padding-left: 13px;
        spacing: root.collapsed ? 0px : 12px;
        alignment: start;
        width: 100%;

        animate spacing {
            duration: 200ms;
            easing: ease-out-quad;
        }

        Image {
            width: 20px;
            height: 20px;
            source: root.icon;
            colorize: (root.selected || touch.has-hover) ? Theme.accent : root.icon_color;
            image-fit: contain;
        }

        Rectangle {
            width: root.collapsed ? 0px : item_label.preferred-width;
            clip: true;

            animate width {
                duration: 200ms;
                easing: ease-out-quad;
            }

            item_label := Text {
                width: 100%;
                text: root.text;
                font-size: 14px;
                font-weight: root.selected ? 600 : 400;
                color: (root.selected || touch.has-hover) ? Theme.text_primary : Theme.text_secondary;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
                opacity: root.collapsed && parent.width < 10px ? 0 : 1;
                animate opacity { duration: 150ms; }
            }
        }
    }

    Rectangle {
        visible: root.selected;
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 16px;
        background: Theme.accent;
        border-radius: 1.5px;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component FluentButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;

    min-width: 88px;
    height: 32px;
    border-radius: 4px;
    border-width: root.primary ? 0px : 1px;
    border-color: root.danger ? Theme.danger : Theme.input_border;
    background: root.primary
        ? (button_touch.has-hover ? Theme.accent_hover : Theme.accent)
        : (button_touch.pressed ? Theme.selected_bg : (button_touch.has-hover ? Theme.hover_bg : Theme.input_bg));
    opacity: root.enabled ? 1 : 0.55;

    Text {
        text: root.text;
        color: root.primary ? white : (root.danger ? Theme.danger : Theme.text_primary);
        font-size: 13px;
        font-weight: root.primary ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button_touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component WindowControlButton inherits Rectangle {
    in property <string> symbol;
    in property <bool> close_button: false;
    callback clicked;

    width: 46px;
    height: 100%;
    background: control_touch.has-hover ? (root.close_button ? #e81123 : Theme.hover_bg) : transparent;

    Text {
        text: root.symbol;
        color: control_touch.has-hover && root.close_button ? white : Theme.text_primary;
        font-size: root.close_button ? 18px : 14px;
        font-weight: 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    control_touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component FluentTextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder_text;
    in property <bool> enabled: true;
    callback accepted(string);
    callback edited(string);

    forward-focus: field_input;
    height: 38px;
    background: Theme.input_bg;
    border-width: 1px;
    border-color: field_input.has-focus ? Theme.accent : Theme.input_border;
    border-radius: 4px;
    clip: true;

    field_input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        text <=> root.text;
        color: Theme.text_primary;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
        enabled: root.enabled;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
    }

    Text {
        visible: root.text == "" && !field_input.has-focus;
        x: 12px;
        width: parent.width - 24px;
        text: root.placeholder_text;
        color: Theme.text_secondary;
        font-size: 14px;
        vertical-alignment: center;
    }
}

export component FluentTextArea inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder_text;
    in property <bool> enabled: true;
    callback edited(string);

    forward-focus: area_input;
    min-height: 76px;
    background: Theme.input_bg;
    border-width: 1px;
    border-color: area_input.has-focus ? Theme.accent : Theme.input_border;
    border-radius: 4px;
    clip: true;

    area_input := TextInput {
        x: 12px;
        y: 8px;
        width: parent.width - 24px;
        height: parent.height - 16px;
        text <=> root.text;
        color: Theme.text_primary;
        font-size: 13px;
        vertical-alignment: top;
        single-line: false;
        enabled: root.enabled;
        edited => { root.edited(self.text); }
    }

    Text {
        visible: root.text == "" && !area_input.has-focus;
        x: 12px;
        y: 8px;
        width: parent.width - 24px;
        text: root.placeholder_text;
        color: Theme.text_secondary;
        font-size: 13px;
    }
}

export component SegmentButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked;

    min-width: 54px;
    height: 30px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.input_border;
    background: root.selected ? Theme.selected_bg : (segment_touch.has-hover ? Theme.hover_bg : Theme.input_bg);
    opacity: root.enabled ? 1 : 0.5;

    Text {
        text: root.text;
        color: root.selected ? Theme.accent : Theme.text_primary;
        font-size: 12px;
        font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    segment_touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SurfaceCard inherits Rectangle {
    background: Theme.card_bg;
    border-width: 1px;
    border-color: Theme.border_color;
    border-radius: 6px;
}
