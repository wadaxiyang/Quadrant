import { Theme, Typography, Motion } from "../theme.slint";
import { Icons } from "../icons.slint";
import { FluentIcon, IconButton } from "icon.slint";

export enum ToastKind { info, success, error }

export component ToastHost inherits Rectangle {
    in property <bool> shown: false;
    in property <string> message;
    in property <ToastKind> kind: ToastKind.info;
    callback dismissed;

    min-width: 280px;
    preferred-width: 360px;
    max-width: 420px;
    horizontal-stretch: 0;
    height: root.shown ? 56px : 0px;
    opacity: root.shown ? 1 : 0;
    background: Theme.card_bg;
    border-width: 1px;
    border-color: root.kind == ToastKind.error ? Theme.danger :
                  root.kind == ToastKind.success ? Theme.success : Theme.accent;
    border-radius: 6px;
    clip: true;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000044;

    animate height { duration: Motion.standard; easing: ease-out-quad; }
    animate opacity { duration: Motion.fast; }

    Rectangle {
        x: 0px;
        width: 4px;
        height: 100%;
        background: root.kind == ToastKind.error ? Theme.danger :
                    root.kind == ToastKind.success ? Theme.success : Theme.accent;
    }

    FluentIcon {
        x: 16px;
        y: (parent.height - self.height) / 2;
        source: root.kind == ToastKind.error ? Icons.error :
                root.kind == ToastKind.success ? Icons.complete : Icons.info;
        icon_color: root.kind == ToastKind.error ? Theme.danger :
                    root.kind == ToastKind.success ? Theme.success : Theme.accent;
    }

    Text {
        x: 44px;
        width: parent.width - 88px;
        text: root.message;
        color: Theme.text_primary;
        font-size: Typography.body;
        vertical-alignment: center;
        wrap: word-wrap;
    }

    IconButton {
        x: parent.width - self.width - 8px;
        y: (parent.height - self.height) / 2;
        icon: Icons.dismiss;
        tooltip: "Dismiss";
        clicked => { root.dismissed(); }
    }

    Timer {
        running: root.shown;
        interval: 4000ms;
        triggered => { root.dismissed(); }
    }
}
