import { Palette } from "std-widgets.slint";
import {
    Branding,
    FluentButton,
    FluentTextField,
    SegmentButton,
    Theme,
    ThemeMode,
    Typography,
    UiConstants,
} from "../kit/kit.slint";

export component QuickAddWindow inherits Window {
    title: "Quick Add — Quadrant";
    icon: Branding.app_mark;
    preferred-width: 520px;
    preferred-height: 252px;
    min-width: 440px;
    min-height: 252px;
    background: Theme.background;
    default-font-family: root.ui_font_family;
    default-font-size: Typography.body;
    default-font-weight: Typography.regular;
    forward-focus: title_field;

    in-out property <string> ui_font_family <=> Theme.ui_font_family;
    in-out property <string> title_text;
    in-out property <int> destination: 0;
    in-out property <string> error_message;

    in-out property <bool> can_submit: true;

    callback submitted(string, int);
    callback cancelled;

    public function apply_theme(mode: ThemeMode, system_dark: bool) {
        Theme.mode = mode;
        Theme.system_dark = system_dark;
        Palette.color-scheme = mode == ThemeMode.system ? ColorScheme.unknown :
                               mode == ThemeMode.light ? ColorScheme.light : ColorScheme.dark;
    }

    public function set_theme_mode(mode: ThemeMode) {
        Theme.mode = mode;
        Palette.color-scheme = mode == ThemeMode.system ? ColorScheme.unknown :
                               mode == ThemeMode.light ? ColorScheme.light : ColorScheme.dark;
    }

    capture_keys := FocusScope {
        width: 100%;
        height: 100%;
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            if (event.modifiers.control && event.text == "1") {
                root.destination = 1;
                return accept;
            }
            if (event.modifiers.control && event.text == "2") {
                root.destination = 2;
                return accept;
            }
            if (event.modifiers.control && event.text == "3") {
                root.destination = 3;
                return accept;
            }
            if (event.modifiers.control && event.text == "4") {
                root.destination = 4;
                return accept;
            }
            return reject;
        }

        quick_add_layout := VerticalLayout {
            padding: UiConstants.space_24;
            spacing: UiConstants.space_12;

            Text {
                text: "Quick Add";
                color: Theme.text_primary;
                font-size: Typography.subtitle;
                font-weight: Typography.semibold;
            }

            title_field := FluentTextField {
                text <=> root.title_text;
                placeholder_text: "What needs your attention?";
                accepted(value) => { if root.can_submit { root.submitted(value, root.destination); } }
                edited(value) => {
                    if (value != "") {
                        root.error_message = "";
                    }
                }
            }

            HorizontalLayout {
                spacing: UiConstants.space_6;

                SegmentButton { horizontal-stretch: 2; text: "Inbox"; selected: root.destination == 0; clicked => { root.destination = 0; } }
                SegmentButton { horizontal-stretch: 1; text: "Q1"; selected: root.destination == 1; clicked => { root.destination = 1; } }
                SegmentButton { horizontal-stretch: 1; text: "Q2"; selected: root.destination == 2; clicked => { root.destination = 2; } }
                SegmentButton { horizontal-stretch: 1; text: "Q3"; selected: root.destination == 3; clicked => { root.destination = 3; } }
                SegmentButton { horizontal-stretch: 1; text: "Q4"; selected: root.destination == 4; clicked => { root.destination = 4; } }
            }

            Text {
                min-height: 18px;
                text: root.error_message != "" ? root.error_message :
                      "Enter to capture · Esc to cancel · Ctrl+1…4 to classify";
                color: root.error_message != "" ? Theme.danger : Theme.text_secondary;
                font-size: Typography.caption;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: UiConstants.space_8;

                Rectangle { horizontal-stretch: 1; }

                FluentButton {
                    text: "Cancel";
                    clicked => { root.cancelled(); }
                }

                FluentButton {
                    text: "Add task";
                    primary: true;
                    enabled: root.can_submit;
                    clicked => { root.submitted(root.title_text, root.destination); }
                }
            }
        }
    }
}
