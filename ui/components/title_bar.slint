// Derived from wsl-dashboard src/ui/components/title_bar.slint at
// 948589a255a4bd8a3ff9c3de49e2e13109378fcd. Product-specific mail/pin actions
// and Segoe icon glyphs were removed; theme selection is tri-state.

import {
    Branding,
    FluentIcon,
    FluentIcons as Icons,
    IconButton,
    Theme,
    ThemeMode,
    Typography,
    UiConstants,
    WindowControlButton,
} from "../kit/kit.slint";

component ThemeModeControl inherits IconButton {
    in property <ThemeMode> mode: ThemeMode.system;
    callback selected(ThemeMode);

    icon: root.mode == ThemeMode.system ? Icons.theme_system :
          root.mode == ThemeMode.light ? Icons.theme_light : Icons.theme_dark;
    tooltip: root.mode == ThemeMode.system ? "Theme: System" :
             root.mode == ThemeMode.light ? "Theme: Light" : "Theme: Dark";
    clicked => {
        root.selected(root.mode == ThemeMode.system ? ThemeMode.light :
                      root.mode == ThemeMode.light ? ThemeMode.dark : ThemeMode.system);
    }
}

export component TitleBar inherits Rectangle {
    in property <string> title: "Quadrant";
    in property <string> version: "0.1.0";
    in property <bool> is_maximized: false;
    in property <ThemeMode> theme_mode: ThemeMode.system;
    in-out property <float> drag_x;
    in-out property <float> drag_y;

    callback close;
    callback minimize;
    callback maximize;
    callback theme_selected(ThemeMode);
    callback drag_delta(float, float);

    height: UiConstants.title_bar_height;
    background: transparent;

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        padding-left: UiConstants.space_12;
        spacing: UiConstants.space_8;

        Rectangle {
            width: 16px;
            height: UiConstants.title_bar_height;
            background: transparent;

            Image {
                y: (parent.height - self.height) / 2;
                source: Branding.app_mark;
                width: 16px;
                height: 16px;
                image-fit: contain;
                accessible-role: none;
            }
        }

        Text {
            text: root.title;
            color: Theme.text_primary;
            font-size: Typography.body;
            font-weight: Typography.semibold;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 100%;

            title_touch := TouchArea {
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        root.drag_x = self.mouse-x / 1px;
                        root.drag_y = self.mouse-y / 1px;
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.drag_delta((self.mouse-x / 1px) - root.drag_x,
                                        (self.mouse-y / 1px) - root.drag_y);
                    }
                }
                double-clicked => { root.maximize(); }
            }
        }

        ThemeModeControl {
            mode: root.theme_mode;
            selected(mode) => { root.theme_selected(mode); }
        }

        WindowControlButton {
            icon: Icons.minimize;
            label: "Minimize";
            clicked => { root.minimize(); }
        }

        WindowControlButton {
            icon: root.is_maximized ? Icons.restore_window : Icons.maximize;
            label: root.is_maximized ? "Restore window" : "Maximize";
            clicked => { root.maximize(); }
        }

        WindowControlButton {
            icon: Icons.dismiss;
            label: "Close";
            close_button: true;
            clicked => { root.close(); }
        }
    }
}
