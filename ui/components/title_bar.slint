// Derived from wsl-dashboard src/ui/components/title_bar.slint at
// 948589a255a4bd8a3ff9c3de49e2e13109378fcd. Product-specific mail/pin actions
// and Segoe icon glyphs were removed; theme selection is tri-state.

import { Theme, ThemeMode } from "../theme.slint";
import { UiConstants } from "../constants.slint";
import { WindowControlButton } from "common.slint";

component ThemeModeControl inherits Rectangle {
    in property <ThemeMode> mode: ThemeMode.system;
    callback selected(ThemeMode);

    width: 92px;
    height: 28px;
    border-radius: 4px;
    background: theme_touch.has-hover ? Theme.hover_bg : transparent;

    Text {
        text: root.mode == ThemeMode.system ? "Theme: System" :
              root.mode == ThemeMode.light ? "Theme: Light" : "Theme: Dark";
        color: theme_touch.has-hover ? Theme.accent : Theme.text_secondary;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    theme_touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.selected(root.mode == ThemeMode.system ? ThemeMode.light :
                          root.mode == ThemeMode.light ? ThemeMode.dark : ThemeMode.system);
        }
    }
}

export component TitleBar inherits Rectangle {
    in property <string> title: "Quadrant";
    in property <string> version: "0.1.0";
    in property <bool> is_maximized: false;
    in property <ThemeMode> theme_mode: ThemeMode.system;
    in-out property <float> drag_x;
    in-out property <float> drag_y;

    callback close;
    callback minimize;
    callback maximize;
    callback theme_selected(ThemeMode);
    callback drag_delta(float, float);

    height: UiConstants.title_bar_height;
    background: transparent;

    title_touch := TouchArea {
        width: parent.width - 230px;
        height: parent.height;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.drag_x = self.mouse-x / 1px;
                root.drag_y = self.mouse-y / 1px;
            }
        }
        moved => {
            if (self.pressed) {
                root.drag_delta((self.mouse-x / 1px) - root.drag_x,
                                (self.mouse-y / 1px) - root.drag_y);
            }
        }
        double-clicked => { root.maximize(); }
    }

    HorizontalLayout {
        x: 16px;
        width: parent.width - 250px;
        height: 100%;
        spacing: 8px;
        alignment: start;

        Text {
            text: root.title;
            color: Theme.text_primary;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Text {
            text: "v" + root.version;
            color: Theme.text_secondary;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    HorizontalLayout {
        x: parent.width - self.width;
        height: 100%;
        spacing: 0px;
        alignment: end;

        ThemeModeControl {
            y: (parent.height - self.height) / 2;
            mode: root.theme_mode;
            selected(mode) => { root.theme_selected(mode); }
        }

        WindowControlButton {
            symbol: "—";
            clicked => { root.minimize(); }
        }

        WindowControlButton {
            symbol: root.is_maximized ? "❐" : "□";
            clicked => { root.maximize(); }
        }

        WindowControlButton {
            symbol: "×";
            close_button: true;
            clicked => { root.close(); }
        }
    }
}
