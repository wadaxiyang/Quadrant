import { Theme, Typography } from "../theme.slint";
import { UiConstants } from "../constants.slint";
import { Icons } from "../icons.slint";
import { FluentIcon } from "icon.slint";
import { Badge, BadgeKind, FluentButton, SurfaceCard } from "common.slint";

export component PageHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> show_action: false;
    in property <string> action_text;
    callback action_clicked;

    min-height: 72px;
    preferred-height: max(root.min-height, header_layout.preferred-height);

    header_layout := HorizontalLayout {
        spacing: UiConstants.space_16;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: UiConstants.space_4;
            alignment: center;

            Text {
                text: root.title;
                color: Theme.text_primary;
                font-size: Typography.title;
                font-weight: Typography.semibold;
            }

            Text {
                text: root.subtitle;
                color: Theme.text_secondary;
                font-size: Typography.body;
                wrap: word-wrap;
                max-height: 40px;
                overflow: elide;
            }
        }

        if root.show_action: FluentButton {
            min-width: 112px;
            text: root.action_text;
            primary: true;
            clicked => { root.action_clicked(); }
        }
    }
}

export component EmptyState inherits SurfaceCard {
    in property <string> title;
    in property <string> message;
    in property <image> icon: Icons.status_info;
    // Retained for source compatibility. Development milestone text is no longer rendered.
    in property <string> milestone;

    min-height: 144px;
    preferred-height: max(root.min-height, empty_layout.preferred-height);

    empty_layout := VerticalLayout {
        padding: UiConstants.space_28;
        spacing: UiConstants.space_8;
        alignment: center;

        FluentIcon {
            source: root.icon;
            size: 24px;
            icon_color: Theme.icon_neutral;
        }

        Text {
            text: root.title;
            color: Theme.text_primary;
            font-size: Typography.body_large;
            font-weight: Typography.semibold;
            horizontal-alignment: center;
        }

        Text {
            text: root.message;
            color: Theme.text_secondary;
            font-size: Typography.body;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

    }
}

export component MetricCard inherits SurfaceCard {
    in property <string> label;
    in property <string> value: "—";
    in property <string> hint;

    min-width: 150px;
    min-height: 112px;
    preferred-height: max(root.min-height, metric_layout.preferred-height);

    metric_layout := VerticalLayout {
        padding: UiConstants.space_16;
        spacing: UiConstants.space_4;

        Text {
            text: root.label;
            color: Theme.text_secondary;
            font-size: 12px;
        }

        Text {
            text: root.value;
            color: Theme.text_primary;
            font-size: Typography.title;
            font-weight: Typography.semibold;
        }

        Text {
            text: root.hint;
            color: Theme.text_secondary;
            font-size: Typography.caption;
        }
    }
}

export component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> badge_text;
    in property <BadgeKind> badge_kind: BadgeKind.neutral;

    min-height: root.description == "" ? 32px : 48px;
    preferred-height: max(root.min-height, section_layout.preferred-height);

    section_layout := HorizontalLayout {
        spacing: UiConstants.space_12;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: UiConstants.space_4;
            alignment: center;

            Text {
                text: root.title;
                color: Theme.text_primary;
                font-size: 16px;
                font-weight: Typography.semibold;
            }

            if root.description != "": Text {
                text: root.description;
                color: Theme.text_secondary;
                font-size: Typography.caption;
                wrap: word-wrap;
            }
        }

        if root.badge_text != "": Badge {
            text: root.badge_text;
            kind: root.badge_kind;
        }

        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            @children
        }
    }
}
