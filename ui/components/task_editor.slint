import { Date, DatePickerPopup, Palette, ScrollView, Time, TimePickerPopup } from "std-widgets.slint";
import {
    Branding,
    FluentButton,
    FluentIcon,
    FluentIcons as Icons,
    FluentTextArea,
    FluentTextField,
    IconButton,
    SectionHeader,
    SegmentButton,
    SurfaceCard,
    Theme,
    ThemeMode,
    Typography,
    UiConstants,
} from "../kit/kit.slint";

component FieldLabel inherits Text {
    color: Theme.text_secondary;
    font-size: Typography.caption;
    font-weight: Typography.semibold;
}

component FieldError inherits Text {
    in property <string> message;
    visible: root.message != "";
    text: root.message;
    color: Theme.danger;
    font-size: Typography.caption;
    wrap: word-wrap;
}

export component TaskEditorWindow inherits Window {
    title: "Edit Task — Quadrant";
    icon: Branding.app_mark;
    preferred-width: 760px;
    preferred-height: 720px;
    min-width: 620px;
    min-height: 520px;
    background: Theme.background;
    default-font-family: root.ui_font_family;
    default-font-size: Typography.body;
    default-font-weight: Typography.regular;
    forward-focus: capture_keys;

    in-out property <string> ui_font_family <=> Theme.ui_font_family;
    in-out property <string> task_id;
    in-out property <string> title_text;
    in-out property <string> notes_text;
    in-out property <int> destination: 0;
    in-out property <string> planned_on;
    in-out property <string> due_at;
    in-out property <string> due_time_zone;
    in-out property <string> reminder_at;
    in-out property <string> reminder_time_zone;
    in-out property <int> recurrence: 0;
    in-out property <string> custom_interval_days;
    in-out property <string> error_message;

    // Human-readable editor state. Legacy ISO properties above remain public
    // for source compatibility; the Rust adapter translates these values.
    in-out property <bool> planned_selected: false;
    in-out property <Date> planned_date: { year: 2026, month: 1, day: 1 };
    in-out property <bool> due_selected: false;
    in-out property <Date> due_date: { year: 2026, month: 1, day: 1 };
    in-out property <Time> due_time: { hour: 9, minute: 0, second: 0 };
    in-out property <bool> reminder_selected: false;
    in-out property <Date> reminder_date: { year: 2026, month: 1, day: 1 };
    in-out property <Time> reminder_time: { hour: 8, minute: 30, second: 0 };

    in-out property <string> title_error;
    in-out property <string> planned_error;
    in-out property <string> due_error;
    in-out property <string> due_time_zone_error;
    in-out property <string> reminder_error;
    in-out property <string> reminder_time_zone_error;
    in-out property <string> recurrence_error;

    in-out property <bool> can_submit: true;

    callback submitted(string, string, string, int, string, string, string, string, string, int, string);
    callback cancelled;

    function two_digits(value: int) -> string {
        return (value < 10 ? "0" : "") + value;
    }

    function date_text(value: Date) -> string {
        return value.year + "-" + root.two_digits(value.month) + "-" + root.two_digits(value.day);
    }

    function time_text(value: Time) -> string {
        return root.two_digits(value.hour) + ":" + root.two_digits(value.minute);
    }

    public function apply_theme(mode: ThemeMode, system_dark: bool) {
        Theme.mode = mode;
        Theme.system_dark = system_dark;
        Palette.color-scheme = mode == ThemeMode.system ? ColorScheme.unknown :
                               mode == ThemeMode.light ? ColorScheme.light : ColorScheme.dark;
    }

    public function set_theme_mode(mode: ThemeMode) {
        Theme.mode = mode;
        Palette.color-scheme = mode == ThemeMode.system ? ColorScheme.unknown :
                               mode == ThemeMode.light ? ColorScheme.light : ColorScheme.dark;
    }

    capture_keys := FocusScope {
        width: 100%;
        height: 100%;

        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;

            Rectangle {
                height: 76px;
                background: Theme.content_bg;

                VerticalLayout {
                    padding-left: UiConstants.space_24;
                    padding-right: UiConstants.space_24;
                    alignment: center;
                    spacing: UiConstants.space_4;

                    Text {
                        text: "Edit task";
                        color: Theme.text_primary;
                        font-size: Typography.subtitle;
                        font-weight: Typography.semibold;
                    }

                    Text {
                        text: "Update task details, schedule, and recurrence.";
                        color: Theme.text_secondary;
                        font-size: Typography.caption;
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.divider; }

            ScrollView {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                viewport-width: self.width;

                editor_form := VerticalLayout {
                    padding: UiConstants.space_24;
                    spacing: UiConstants.space_16;

                    if root.error_message != "": Rectangle {
                        min-height: 48px;
                        preferred-height: validation_layout.preferred-height;
                        background: Theme.danger_bg;
                        border-width: 1px;
                        border-color: Theme.danger;
                        border-radius: UiConstants.control_radius;

                        validation_layout := HorizontalLayout {
                            padding: UiConstants.space_12;
                            spacing: UiConstants.space_8;
                            alignment: center;

                            FluentIcon {
                                source: Icons.status_error;
                                size: 24px;
                                icon_color: Theme.danger;
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: root.error_message;
                                color: Theme.text_primary;
                                font-size: Typography.caption;
                                wrap: word-wrap;
                                vertical-alignment: center;
                            }
                        }
                    }

                    SurfaceCard {
                        preferred-height: general_layout.preferred-height;
                        vertical-stretch: 0;

                        general_layout := VerticalLayout {
                            padding: UiConstants.space_16;
                            spacing: UiConstants.space_10;

                            SectionHeader {
                                title: "General";
                                description: "Core task details and placement.";
                            }

                            FieldLabel { text: "Title"; }
                            title_field := FluentTextField {
                                text <=> root.title_text;
                                placeholder_text: "Task title";
                                error_text: root.title_error;
                                edited(value) => {
                                    if (value != "") {
                                        root.title_error = "";
                                        root.error_message = "";
                                    }
                                }
                            }

                            FieldLabel { text: "Notes"; }
                            FluentTextArea {
                                height: 104px;
                                text <=> root.notes_text;
                                placeholder_text: "Context, links, or next actions";
                            }

                            FieldLabel { text: "Placement"; }
                            HorizontalLayout {
                                spacing: UiConstants.space_6;
                                SegmentButton { horizontal-stretch: 2; text: "Inbox"; selected: root.destination == 0; clicked => { root.destination = 0; } }
                                SegmentButton { horizontal-stretch: 1; text: "Q1"; selected: root.destination == 1; clicked => { root.destination = 1; } }
                                SegmentButton { horizontal-stretch: 1; text: "Q2"; selected: root.destination == 2; clicked => { root.destination = 2; } }
                                SegmentButton { horizontal-stretch: 1; text: "Q3"; selected: root.destination == 3; clicked => { root.destination = 3; } }
                                SegmentButton { horizontal-stretch: 1; text: "Q4"; selected: root.destination == 4; clicked => { root.destination = 4; } }
                            }
                        }
                    }

                    SurfaceCard {
                        preferred-height: schedule_layout.preferred-height;
                        vertical-stretch: 0;

                        schedule_layout := VerticalLayout {
                            padding: UiConstants.space_16;
                            spacing: UiConstants.space_10;

                            SectionHeader {
                                title: "Schedule";
                                description: "Choose local dates and times; Quadrant stores the corresponding UTC instant.";
                            }

                            FieldLabel { text: "Planned date"; }
                            VerticalLayout {
                                spacing: UiConstants.space_4;
                                HorizontalLayout {
                                    spacing: UiConstants.space_8;
                                    FluentButton {
                                        horizontal-stretch: 1;
                                        text: root.planned_selected ? root.date_text(root.planned_date) : "Select date";
                                        icon: Icons.calendar;
                                        show_icon: true;
                                        danger: root.planned_error != "";
                                        clicked => { planned_picker.show(); }
                                    }
                                    IconButton {
                                        visible: root.planned_selected;
                                        icon: Icons.dismiss;
                                        tooltip: "Clear planned date";
                                        clicked => { root.planned_selected = false; root.planned_error = ""; }
                                    }
                                }
                                FieldError { message: root.planned_error; }
                            }

                            FieldLabel { text: "Due"; }
                            VerticalLayout {
                                spacing: UiConstants.space_4;
                                HorizontalLayout {
                                    spacing: UiConstants.space_8;
                                    FluentButton {
                                        width: 148px;
                                        text: root.due_selected ? root.date_text(root.due_date) : "Select date";
                                        icon: Icons.calendar;
                                        show_icon: true;
                                        danger: root.due_error != "";
                                        clicked => { due_date_picker.show(); }
                                    }
                                    FluentButton {
                                        width: 112px;
                                        text: root.time_text(root.due_time);
                                        icon: Icons.clock;
                                        show_icon: true;
                                        enabled: root.due_selected;
                                        danger: root.due_error != "";
                                        clicked => { due_time_picker.show(); }
                                    }
                                    FluentTextField {
                                        horizontal-stretch: 1;
                                        text <=> root.due_time_zone;
                                        placeholder_text: "Timezone, e.g. Asia/Shanghai";
                                        error_text: root.due_time_zone_error;
                                        edited(value) => { root.due_time_zone_error = ""; }
                                    }
                                    IconButton {
                                        visible: root.due_selected;
                                        icon: Icons.dismiss;
                                        tooltip: "Clear due date and time";
                                        clicked => { root.due_selected = false; root.due_error = ""; root.due_time_zone_error = ""; }
                                    }
                                }
                                FieldError { message: root.due_error; }
                            }

                            FieldLabel { text: "Reminder"; }
                            VerticalLayout {
                                spacing: UiConstants.space_4;
                                HorizontalLayout {
                                    spacing: UiConstants.space_8;
                                    FluentButton {
                                        width: 148px;
                                        text: root.reminder_selected ? root.date_text(root.reminder_date) : "Select date";
                                        icon: Icons.calendar;
                                        show_icon: true;
                                        danger: root.reminder_error != "";
                                        clicked => { reminder_date_picker.show(); }
                                    }
                                    FluentButton {
                                        width: 112px;
                                        text: root.time_text(root.reminder_time);
                                        icon: Icons.clock;
                                        show_icon: true;
                                        enabled: root.reminder_selected;
                                        danger: root.reminder_error != "";
                                        clicked => { reminder_time_picker.show(); }
                                    }
                                    FluentTextField {
                                        horizontal-stretch: 1;
                                        text <=> root.reminder_time_zone;
                                        placeholder_text: "Timezone, e.g. Asia/Shanghai";
                                        error_text: root.reminder_time_zone_error;
                                        edited(value) => { root.reminder_time_zone_error = ""; }
                                    }
                                    IconButton {
                                        visible: root.reminder_selected;
                                        icon: Icons.dismiss;
                                        tooltip: "Clear reminder date and time";
                                        clicked => { root.reminder_selected = false; root.reminder_error = ""; root.reminder_time_zone_error = ""; }
                                    }
                                }
                                FieldError { message: root.reminder_error; }
                            }
                        }
                    }

                    SurfaceCard {
                        preferred-height: repeat_layout.preferred-height;
                        vertical-stretch: 0;

                        repeat_layout := VerticalLayout {
                            padding: UiConstants.space_16;
                            spacing: UiConstants.space_10;

                            SectionHeader {
                                title: "Repeat";
                                description: "Choose how the next occurrence is scheduled after completion.";
                            }

                            HorizontalLayout {
                                spacing: UiConstants.space_6;
                                SegmentButton { horizontal-stretch: 1; text: "None"; selected: root.recurrence == 0; clicked => { root.recurrence = 0; } }
                                SegmentButton { horizontal-stretch: 1; text: "Daily"; selected: root.recurrence == 1; clicked => { root.recurrence = 1; } }
                                SegmentButton { horizontal-stretch: 1; text: "Weekly"; selected: root.recurrence == 2; clicked => { root.recurrence = 2; } }
                                SegmentButton { horizontal-stretch: 1; text: "Monthly"; selected: root.recurrence == 3; clicked => { root.recurrence = 3; } }
                                SegmentButton { horizontal-stretch: 1; text: "Custom"; selected: root.recurrence == 4; clicked => { root.recurrence = 4; } }
                            }

                            if root.recurrence == 4: HorizontalLayout {
                                spacing: UiConstants.space_8;
                                FluentTextField {
                                    width: 150px;
                                    text <=> root.custom_interval_days;
                                    placeholder_text: "1–365";
                                    error_text: root.recurrence_error;
                                    edited(value) => { root.recurrence_error = ""; }
                                }
                                Text {
                                    text: "days between occurrences";
                                    color: Theme.text_secondary;
                                    font-size: Typography.caption;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }

                    Rectangle { height: UiConstants.space_8; }
                }
            }

            Rectangle {
                height: 65px;
                background: Theme.content_bg;

                Rectangle {
                    y: 0px;
                    width: 100%;
                    height: 1px;
                    background: Theme.divider;
                }

                HorizontalLayout {
                    padding-left: UiConstants.space_24;
                    padding-right: UiConstants.space_24;
                    spacing: UiConstants.space_8;
                    alignment: center;

                    Rectangle { horizontal-stretch: 1; }

                    FluentButton {
                        text: "Cancel";
                        clicked => { root.cancelled(); }
                    }

                    FluentButton {
                        text: "Save";
                        enabled: root.can_submit;
                        primary: true;
                        clicked => {
                            root.planned_on = root.planned_selected ? root.date_text(root.planned_date) : "";
                            root.due_at = root.due_selected ? root.date_text(root.due_date) + "T" + root.time_text(root.due_time) + ":00" : "";
                            root.reminder_at = root.reminder_selected ? root.date_text(root.reminder_date) + "T" + root.time_text(root.reminder_time) + ":00" : "";
                            root.submitted(
                                root.task_id,
                                root.title_text,
                                root.notes_text,
                                root.destination,
                                root.planned_on,
                                root.due_at,
                                root.due_selected ? root.due_time_zone : "",
                                root.reminder_at,
                                root.reminder_selected ? root.reminder_time_zone : "",
                                root.recurrence,
                                root.custom_interval_days
                            );
                        }
                    }
                }
            }
        }
    }

    planned_picker := DatePickerPopup {
        title: "Planned date";
        date: root.planned_date;
        accepted(value) => {
            root.planned_date = value;
            root.planned_selected = true;
            root.planned_error = "";
        }
    }

    due_date_picker := DatePickerPopup {
        title: "Due date";
        date: root.due_date;
        accepted(value) => {
            root.due_date = value;
            root.due_selected = true;
            root.due_error = "";
        }
    }

    due_time_picker := TimePickerPopup {
        title: "Due time";
        use-24-hour-format: true;
        time: root.due_time;
        accepted(value) => { root.due_time = value; root.due_error = ""; }
    }

    reminder_date_picker := DatePickerPopup {
        title: "Reminder date";
        date: root.reminder_date;
        accepted(value) => {
            root.reminder_date = value;
            root.reminder_selected = true;
            root.reminder_error = "";
        }
    }

    reminder_time_picker := TimePickerPopup {
        title: "Reminder time";
        use-24-hour-format: true;
        time: root.reminder_time;
        accepted(value) => { root.reminder_time = value; root.reminder_error = ""; }
    }
}
