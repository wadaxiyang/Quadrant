import { Theme, ThemeMode, Typography } from "../theme.slint";
import { Palette } from "std-widgets.slint";
import { FluentButton, FluentTextArea, FluentTextField, SegmentButton, SurfaceCard } from "common.slint";

component FieldLabel inherits Text {
    color: Theme.text_secondary;
    font-size: Typography.caption;
    font-weight: Typography.semibold;
}

export component TaskEditorWindow inherits Window {
    title: "Edit Task — Quadrant";
    preferred-width: 760px;
    preferred-height: 760px;
    min-width: 620px;
    min-height: 680px;
    background: Theme.background;
    default-font-family: root.ui_font_family;
    default-font-size: Typography.body;
    default-font-weight: Typography.regular;
    forward-focus: title_field;

    in-out property <string> ui_font_family <=> Theme.ui_font_family;
    in-out property <string> task_id;
    in-out property <string> title_text;
    in-out property <string> notes_text;
    in-out property <int> destination: 0;
    in-out property <string> planned_on;
    in-out property <string> due_at;
    in-out property <string> due_time_zone;
    in-out property <string> reminder_at;
    in-out property <string> reminder_time_zone;
    in-out property <int> recurrence: 0;
    in-out property <string> custom_interval_days;
    in-out property <string> error_message;

    callback submitted(string, string, string, int, string, string, string, string, string, int, string);
    callback cancelled;

    public function apply_theme(mode: ThemeMode, system_dark: bool) {
        Theme.mode = mode;
        Theme.system_dark = system_dark;
        Palette.color-scheme = mode == ThemeMode.system ? ColorScheme.unknown :
                               mode == ThemeMode.light ? ColorScheme.light : ColorScheme.dark;
    }

    public function set_theme_mode(mode: ThemeMode) {
        Theme.mode = mode;
        Palette.color-scheme = mode == ThemeMode.system ? ColorScheme.unknown :
                               mode == ThemeMode.light ? ColorScheme.light : ColorScheme.dark;
    }

    capture_keys := FocusScope {
        width: 100%;
        height: 100%;
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            return reject;
        }

        SurfaceCard {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 24px;

            VerticalLayout {
                padding: 18px;
                spacing: 7px;

                Text {
                    text: "Edit task";
                    color: Theme.text_primary;
                    font-size: 20px;
                    font-weight: 600;
                }

                FieldLabel { text: "Title"; }
                title_field := FluentTextField {
                    text <=> root.title_text;
                    placeholder_text: "Task title";
                    edited(value) => { if (value != "") { root.error_message = ""; } }
                }

                FieldLabel { text: "Notes"; }
                FluentTextArea {
                    height: 82px;
                    text <=> root.notes_text;
                    placeholder_text: "Context, links, or next actions";
                }

                FieldLabel { text: "Placement"; }
                HorizontalLayout {
                    spacing: 6px;
                    SegmentButton { text: "Inbox"; selected: root.destination == 0; clicked => { root.destination = 0; } }
                    SegmentButton { text: "Q1"; selected: root.destination == 1; clicked => { root.destination = 1; } }
                    SegmentButton { text: "Q2"; selected: root.destination == 2; clicked => { root.destination = 2; } }
                    SegmentButton { text: "Q3"; selected: root.destination == 3; clicked => { root.destination = 3; } }
                    SegmentButton { text: "Q4"; selected: root.destination == 4; clicked => { root.destination = 4; } }
                }

                FieldLabel { text: "Planned date (optional)"; }
                FluentTextField { text <=> root.planned_on; placeholder_text: "YYYY-MM-DD"; }

                FieldLabel { text: "Due time and timezone (both optional)"; }
                HorizontalLayout {
                    spacing: 8px;
                    FluentTextField {
                        horizontal-stretch: 2;
                        text <=> root.due_at;
                        placeholder_text: "2026-09-03T09:00:00+08:00";
                    }
                    FluentTextField {
                        horizontal-stretch: 1;
                        text <=> root.due_time_zone;
                        placeholder_text: "Asia/Shanghai";
                    }
                }

                FieldLabel { text: "Reminder time and timezone (both optional)"; }
                HorizontalLayout {
                    spacing: 8px;
                    FluentTextField {
                        horizontal-stretch: 2;
                        text <=> root.reminder_at;
                        placeholder_text: "2026-09-03T08:30:00+08:00";
                    }
                    FluentTextField {
                        horizontal-stretch: 1;
                        text <=> root.reminder_time_zone;
                        placeholder_text: "Asia/Shanghai";
                    }
                }

                FieldLabel { text: "Recurrence"; }
                HorizontalLayout {
                    spacing: 6px;
                    SegmentButton { text: "None"; selected: root.recurrence == 0; clicked => { root.recurrence = 0; } }
                    SegmentButton { text: "Daily"; selected: root.recurrence == 1; clicked => { root.recurrence = 1; } }
                    SegmentButton { text: "Weekly"; selected: root.recurrence == 2; clicked => { root.recurrence = 2; } }
                    SegmentButton { text: "Monthly"; selected: root.recurrence == 3; clicked => { root.recurrence = 3; } }
                    SegmentButton { text: "Custom"; selected: root.recurrence == 4; clicked => { root.recurrence = 4; } }
                }

                if root.recurrence == 4: HorizontalLayout {
                    spacing: 8px;
                    FluentTextField {
                        width: 150px;
                        text <=> root.custom_interval_days;
                        placeholder_text: "1–365";
                    }
                    Text {
                        text: "days between occurrences";
                        color: Theme.text_secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                Text {
                    min-height: 18px;
                    text: root.error_message;
                    color: Theme.danger;
                    font-size: Typography.caption;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    FluentButton { width: 88px; text: "Cancel"; clicked => { root.cancelled(); } }
                    FluentButton {
                        width: 104px;
                        text: "Save";
                        primary: true;
                        clicked => {
                            root.submitted(
                                root.task_id,
                                root.title_text,
                                root.notes_text,
                                root.destination,
                                root.planned_on,
                                root.due_at,
                                root.due_time_zone,
                                root.reminder_at,
                                root.reminder_time_zone,
                                root.recurrence,
                                root.custom_interval_days
                            );
                        }
                    }
                }
            }
        }
    }
}
