// Derived from wsl-dashboard src/ui/components/sidebar.slint at
// 948589a255a4bd8a3ff9c3de49e2e13109378fcd; navigation and icons adapted for Quadrant.

import {
    FluentIcon,
    FluentIcons as Icons,
    Motion,
    SidebarItem,
    Theme,
    TooltipHost,
    Typography,
    UiConstants,
} from "../kit/kit.slint";

export component Sidebar inherits Rectangle {
    in-out property <bool> collapsed: false;
    in property <bool> auto_collapsed: false;
    in property <int> selected_route: 0;
    callback route_selected(int);
    callback quick_add_clicked;

    property <bool> effective_collapsed: root.collapsed || root.auto_collapsed;

    width: effective_collapsed ? UiConstants.sidebar_collapsed_width : UiConstants.sidebar_expanded_width;
    background: Theme.sidebar_bg;

    animate width {
        duration: Motion.slow;
        easing: ease-out-quad;
    }

    VerticalLayout {
        height: 100%;
        padding-left: 4px;
        padding-right: 4px;
        padding-top: 12px;
        padding-bottom: 16px;
        spacing: 4px;

        Rectangle {
            height: UiConstants.navigation_item_height;
            border-radius: 4px;
            border-width: menu_focus.has-focus ? 2px : 0px;
            border-color: Theme.focus_ring;
            background: menu_touch.has-hover ? Theme.hover_bg : transparent;
            forward-focus: menu_focus;
            accessible-role: button;
            accessible-label: root.effective_collapsed ? "Expand navigation" : "Collapse navigation";
            accessible-enabled: true;
            accessible-action-default => { root.collapsed = !root.collapsed; }

            FluentIcon {
                x: UiConstants.navigation_item_padding
                    + (UiConstants.navigation_icon_slot_width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                size: UiConstants.navigation_icon_size;
                source: Icons.menu;
                icon_color: menu_touch.has-hover ? Theme.accent : Theme.icon_neutral;
            }

            menu_touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.collapsed = !root.collapsed; }
            }

            menu_focus := FocusScope {
                width: 0px;
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == Key.Space) {
                        root.collapsed = !root.collapsed;
                        return accept;
                    }
                    return reject;
                }
            }

            TooltipHost {
                x: parent.width + UiConstants.space_8;
                y: (parent.height - self.height) / 2;
                text: root.effective_collapsed ? "Expand navigation" : "Collapse navigation";
                shown: root.effective_collapsed && menu_touch.has-hover;
            }
        }

        Rectangle {
            height: UiConstants.navigation_item_height;
            border-radius: 4px;
            border-width: quick_add_focus.has-focus ? 2px : 0px;
            border-color: Theme.focus_ring;
            background: quick_add_touch.has-hover ? Theme.accent_hover : Theme.accent;
            forward-focus: quick_add_focus;
            accessible-role: button;
            accessible-label: "Quick Add";
            accessible-enabled: true;
            accessible-action-default => { root.quick_add_clicked(); }

            HorizontalLayout {
                padding-left: UiConstants.navigation_item_padding;
                spacing: root.effective_collapsed ? 0px : UiConstants.space_10;
                alignment: start;

                Rectangle {
                    width: UiConstants.navigation_icon_slot_width;
                    height: UiConstants.navigation_item_height;

                    FluentIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 16px;
                        source: Icons.add;
                        icon_color: white;
                    }
                }

                Rectangle {
                    width: root.effective_collapsed ? 0px : quick_add_label.preferred-width;
                    clip: true;

                    animate width {
                        duration: Motion.slow;
                        easing: ease-out-quad;
                    }

                    quick_add_label := Text {
                        width: 100%;
                        text: "Quick Add";
                        color: white;
                        font-size: Typography.body;
                        font-weight: Typography.semibold;
                        vertical-alignment: center;
                        opacity: root.effective_collapsed && parent.width < 10px ? 0 : 1;
                        animate opacity { duration: Motion.standard; }
                    }
                }
            }

            quick_add_touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.quick_add_clicked(); }
            }

            quick_add_focus := FocusScope {
                width: 0px;
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == Key.Space) {
                        root.quick_add_clicked();
                        return accept;
                    }
                    return reject;
                }
            }

            TooltipHost {
                x: parent.width + UiConstants.space_8;
                y: (parent.height - self.height) / 2;
                text: "Quick Add";
                shown: root.effective_collapsed && quick_add_touch.has-hover;
            }
        }

        SidebarItem {
            icon: Icons.quadrants_regular;
            selected_icon: Icons.quadrants_filled;
            text: "Quadrants";
            selected: root.selected_route == 0;
            collapsed: root.effective_collapsed;
            clicked => { root.route_selected(0); }
        }

        SidebarItem {
            icon: Icons.today_regular;
            selected_icon: Icons.today_filled;
            text: "Today";
            selected: root.selected_route == 1;
            collapsed: root.effective_collapsed;
            clicked => { root.route_selected(1); }
        }

        SidebarItem {
            icon: Icons.focus_regular;
            selected_icon: Icons.focus_filled;
            text: "Focus";
            selected: root.selected_route == 2;
            collapsed: root.effective_collapsed;
            clicked => { root.route_selected(2); }
        }

        SidebarItem {
            icon: Icons.review_regular;
            selected_icon: Icons.review_filled;
            text: "Review";
            selected: root.selected_route == 3;
            collapsed: root.effective_collapsed;
            clicked => { root.route_selected(3); }
        }

        Rectangle { vertical-stretch: 1; }

        SidebarItem {
            icon: Icons.completed_regular;
            selected_icon: Icons.completed_filled;
            text: "Completed";
            selected: root.selected_route == 4;
            collapsed: root.effective_collapsed;
            clicked => { root.route_selected(4); }
        }

        Rectangle {
            height: 1px;
            width: 100%;
            background: Theme.border_color;
        }

        Rectangle { height: 4px; }

        SidebarItem {
            icon: Icons.settings_regular;
            selected_icon: Icons.settings_filled;
            text: "Settings";
            selected: root.selected_route == 5;
            collapsed: root.effective_collapsed;
            clicked => { root.route_selected(5); }
        }

        SidebarItem {
            icon: Icons.about_regular;
            selected_icon: Icons.about_filled;
            text: "About";
            selected: root.selected_route == 6;
            collapsed: root.effective_collapsed;
            clicked => { root.route_selected(6); }
        }
    }
}
