// Stage 2 compatibility facade. Product callers keep Icons until Stage 5, while
// canonical product branding and reusable Fluent icons remain separate globals.
import { Branding, FluentIcons } from "kit/kit.slint";

export global Icons {
    out property <image> app_mark: Branding.app_mark;

    out property <image> menu: FluentIcons.menu;
    out property <image> quadrants_regular: FluentIcons.quadrants_regular;
    out property <image> quadrants_filled: FluentIcons.quadrants_filled;
    out property <image> today_regular: FluentIcons.today_regular;
    out property <image> today_filled: FluentIcons.today_filled;
    out property <image> focus_regular: FluentIcons.focus_regular;
    out property <image> focus_filled: FluentIcons.focus_filled;
    out property <image> review_regular: FluentIcons.review_regular;
    out property <image> review_filled: FluentIcons.review_filled;
    out property <image> completed_regular: FluentIcons.completed_regular;
    out property <image> completed_filled: FluentIcons.completed_filled;
    out property <image> settings_regular: FluentIcons.settings_regular;
    out property <image> settings_filled: FluentIcons.settings_filled;
    out property <image> about_regular: FluentIcons.about_regular;
    out property <image> about_filled: FluentIcons.about_filled;

    out property <image> add: FluentIcons.add;
    out property <image> dismiss: FluentIcons.dismiss;
    out property <image> minimize: FluentIcons.minimize;
    out property <image> maximize: FluentIcons.maximize;
    out property <image> restore_window: FluentIcons.restore_window;
    out property <image> theme_system: FluentIcons.theme_system;
    out property <image> theme_light: FluentIcons.theme_light;
    out property <image> theme_dark: FluentIcons.theme_dark;
    out property <image> delete: FluentIcons.delete;
    out property <image> edit: FluentIcons.edit;
    out property <image> complete: FluentIcons.complete;
    out property <image> chevron_up: FluentIcons.chevron_up;
    out property <image> chevron_down: FluentIcons.chevron_down;
    out property <image> more_horizontal: FluentIcons.more_horizontal;
    out property <image> restore_task: FluentIcons.restore_task;
    out property <image> folder_open: FluentIcons.folder_open;
    out property <image> backup: FluentIcons.backup;
    out property <image> warning: FluentIcons.warning;
    out property <image> error: FluentIcons.error;
    out property <image> info: FluentIcons.info;
    out property <image> calendar: FluentIcons.calendar;
    out property <image> clock: FluentIcons.clock;
    out property <image> recurrence: FluentIcons.recurrence;
    out property <image> heart_filled: FluentIcons.heart_filled;

    out property <image> status_success: FluentIcons.status_success;
    out property <image> status_info: FluentIcons.status_info;
    out property <image> status_warning: FluentIcons.status_warning;
    out property <image> status_error: FluentIcons.status_error;
}
