// Semantic, platform-neutral icon IDs. Assets are Microsoft Fluent UI System
// Icons (MIT), pinned and documented in docs/09_SOURCE_MAP.md.

export global Icons {
    out property <image> menu: @image-url("../assets/icons/navigation.svg");
    out property <image> quadrants: @image-url("../assets/icons/quadrants.svg");
    out property <image> today: @image-url("../assets/icons/today.svg");
    out property <image> focus: @image-url("../assets/icons/focus.svg");
    out property <image> review: @image-url("../assets/icons/review.svg");
    out property <image> completed: @image-url("../assets/icons/completed.svg");
    out property <image> settings: @image-url("../assets/icons/settings.svg");
    out property <image> about: @image-url("../assets/icons/about.svg");
}
