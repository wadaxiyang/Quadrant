<Application x:Class="Quadrant.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Quadrant.App.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:ReminderPresetToCustomEnabledConverter x:Key="ReminderPresetToCustomEnabledConverter" />
            <converters:ReminderPresetDisplayConverter x:Key="ReminderPresetDisplayConverter" />
            <converters:TaskFilterToBooleanConverter x:Key="TaskFilterToBooleanConverter" />
            <converters:QuickCaptureDestinationToBooleanConverter x:Key="QuickCaptureDestinationToBooleanConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Resources/Spacing.xaml" />
                <ResourceDictionary Source="Resources/Typography.xaml" />
                <ResourceDictionary Source="Resources/QuadrantColors.xaml" />
                <ResourceDictionary Source="Resources/ControlStyles.xaml" />
                <ResourceDictionary Source="Resources/TaskCardTemplate.xaml" />
                <ResourceDictionary Source="Resources/UiStrings.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
