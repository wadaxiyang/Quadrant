<Window x:Class="Quadrant.App.Views.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快速添加"
        Width="520"
        MinWidth="440"
        SizeToContent="Height"
        ShowActivated="True"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="Window_PreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="{StaticResource WindowMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource TitleMediumTextStyle}" Text="快速添加任务" />

        <StackPanel Grid.Row="1" Margin="{StaticResource FieldTopMargin}">
            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="标题（必填）" />
            <TextBox x:Name="TitleBox" Margin="{StaticResource CaptionTopMargin}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource ValidationTextStyle}" Text="{Binding TitleError}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="{StaticResource FieldTopMargin}">
            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="象限" />
            <UniformGrid Margin="{StaticResource CaptionTopMargin}" Columns="4">
                <Button Margin="{StaticResource ButtonGap}" Click="Quadrant_Click" Tag="1" Content="Q1" AutomationProperties.Name="选择 Q1 象限" />
                <Button Margin="{StaticResource ButtonGap}" Click="Quadrant_Click" Tag="2" Content="Q2" AutomationProperties.Name="选择 Q2 象限" />
                <Button Margin="{StaticResource ButtonGap}" Click="Quadrant_Click" Tag="3" Content="Q3" AutomationProperties.Name="选择 Q3 象限" />
                <Button Margin="{StaticResource ButtonGap}" Click="Quadrant_Click" Tag="4" Content="Q4" AutomationProperties.Name="选择 Q4 象限" />
            </UniformGrid>
            <TextBlock Margin="{StaticResource CaptionTopMargin}" Style="{StaticResource CaptionTextStyle}" Text="{Binding QuadrantLabel}" />
        </StackPanel>

        <Expander Grid.Row="3" Margin="{StaticResource FieldTopMargin}" Header="时间与提醒">
            <Grid Margin="{StaticResource CaptionTopMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource FormColumnGap}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DatePicker Grid.Column="0" SelectedDate="{Binding DueDate}" />
                    <ComboBox Grid.Column="2" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding TimeSuggestions}" Text="{Binding DueTimeText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <TextBlock Grid.Row="1" Style="{StaticResource ValidationTextStyle}" Text="{Binding DueTimeError}" />
                <Grid Grid.Row="2" Margin="{StaticResource FieldTopMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource FormColumnGap}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DatePicker Grid.Column="0" SelectedDate="{Binding CustomReminderDate}" />
                    <ComboBox Grid.Column="2" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding TimeSuggestions}" Text="{Binding CustomReminderTimeText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <ComboBox Grid.Row="3"
                          Margin="{StaticResource FieldTopMargin}"
                          ItemsSource="{Binding ReminderPresets}"
                          SelectedItem="{Binding ReminderPreset}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ReminderPresetDisplayConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="4" Style="{StaticResource ValidationTextStyle}" Text="{Binding ReminderError}" />
            </Grid>
        </Expander>

        <StackPanel Grid.Row="4" Margin="{StaticResource FieldTopMargin}" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button IsCancel="True" MinWidth="80" Content="{DynamicResource CancelText}" AutomationProperties.Name="取消快速添加" />
            <Button Margin="{StaticResource ButtonGap}" IsDefault="True" IsEnabled="{Binding IsValid}" MinWidth="80" Click="Save_Click" Content="{DynamicResource SaveText}" AutomationProperties.Name="保存任务" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
