<ui:FluentWindow x:Class="Quadrant.App.Views.QuickAddWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="快速添加"
                 Icon="/Resources/Quadrant.ico"
                 Width="560"
                 Height="560"
                 MinWidth="480"
                 MinHeight="440"
                 ShowActivated="True"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner"
                 PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="快速添加" CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon><ui:ImageIcon Source="/Resources/Quadrant.ico" /></ui:TitleBar.Icon>
        </ui:TitleBar>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,16,24,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleLargeTextStyle}" Text="快速添加任务" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="记录后立即回到当前工作" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="标题（必填）" />
                    <ui:TextBox x:Name="TitleBox" Margin="0,4,0,0" Icon="{ui:SymbolIcon Edit24}" PlaceholderText="要完成什么？" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource ValidationTextStyle}" Text="{Binding TitleError}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="象限（Ctrl + 1…4）" />
                    <UniformGrid Margin="0,4,0,0" Columns="4">
                        <ui:Button Margin="0,0,4,0" Click="Quadrant_Click" Tag="1" Content="Q1" AutomationProperties.Name="选择 Q1 象限" />
                        <ui:Button Margin="4,0" Click="Quadrant_Click" Tag="2" Content="Q2" AutomationProperties.Name="选择 Q2 象限" />
                        <ui:Button Margin="4,0" Click="Quadrant_Click" Tag="3" Content="Q3" AutomationProperties.Name="选择 Q3 象限" />
                        <ui:Button Margin="4,0,0,0" Click="Quadrant_Click" Tag="4" Content="Q4" AutomationProperties.Name="选择 Q4 象限" />
                    </UniformGrid>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding QuadrantLabel}" />
                </StackPanel>

                <ui:CardExpander Grid.Row="3" Margin="0,16,0,0" Header="时间与提醒">
                    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding DueDate}" /><ComboBox Grid.Column="2" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding TimeSuggestions}" Text="{Binding DueTimeText, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                        <TextBlock Grid.Row="1" Style="{StaticResource ValidationTextStyle}" Text="{Binding DueTimeError}" />
                        <ComboBox Grid.Row="2" Margin="0,12,0,0" ItemsSource="{Binding ReminderPresets}" SelectedItem="{Binding ReminderPreset}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource ReminderPresetDisplayConverter}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        <Grid Grid.Row="3" Margin="0,12,0,0" IsEnabled="{Binding ReminderPreset, Converter={StaticResource ReminderPresetToCustomEnabledConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding CustomReminderDate}" /><ComboBox Grid.Column="2" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding TimeSuggestions}" Text="{Binding CustomReminderTimeText, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                        <TextBlock Grid.Row="4" Style="{StaticResource ValidationTextStyle}" Text="{Binding ReminderError}" />
                    </Grid>
                </ui:CardExpander>

                <StackPanel Grid.Row="4" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button IsCancel="True" MinWidth="88" Content="{DynamicResource CancelText}" AutomationProperties.Name="取消快速添加" />
                    <ui:Button Margin="8,0,0,0" Appearance="Primary" IsDefault="True" IsEnabled="{Binding IsValid}" MinWidth="88" Click="Save_Click" Content="{DynamicResource SaveText}" Icon="{ui:SymbolIcon Add24}" AutomationProperties.Name="保存任务" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
