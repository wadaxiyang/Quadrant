<ui:FluentWindow x:Class="Quadrant.App.Views.CompletedWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="已完成"
                 Icon="/Resources/Quadrant.ico"
                 Width="600"
                 Height="540"
                 MinWidth="440"
                 MinHeight="360"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="已完成" CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon><ui:ImageIcon Source="/Resources/Quadrant.ico" /></ui:TitleBar.Icon>
        </ui:TitleBar>
        <Grid Grid.Row="1" Margin="24,16,24,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource TitleLargeTextStyle}" Text="已完成任务" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="恢复仍需处理的任务，或永久清理记录" />
            </StackPanel>
            <ui:ListView Grid.Row="1" Margin="0,16,0,0" ItemsSource="{Binding CompletedTasks}" Style="{StaticResource QuadrantTaskListStyle}">
                <ui:ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TaskCardStyle}" Margin="{StaticResource TaskCardBottomMargin}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="CheckmarkCircle20" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding CompletedText}" />
                                        <TextBlock Margin="12,0,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding QuadrantId, StringFormat=象限 {0}}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:Button Command="{Binding RestoreCommand}" CommandParameter="{Binding Id}" Content="恢复" Icon="{ui:SymbolIcon ArrowCounterclockwise20}" />
                                    <ui:Button Margin="8,0,0,0" Appearance="Danger" Command="{Binding DeleteCommand}" CommandParameter="{Binding Id}" Content="永久删除" Icon="{ui:SymbolIcon Delete20}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>
        </Grid>
    </Grid>
</ui:FluentWindow>
