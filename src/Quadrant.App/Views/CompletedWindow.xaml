<Window x:Class="Quadrant.App.Views.CompletedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="已完成"
        Width="560"
        Height="520"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="{StaticResource WindowMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource TitleMediumTextStyle}" Text="已完成任务" />
        <ListBox Grid.Row="1"
                 Margin="{StaticResource FieldTopMargin}"
                 ItemsSource="{Binding CompletedTasks}"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource TaskCardStyle}" Margin="{StaticResource TaskCardBottomMargin}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="{Binding Title}" TextWrapping="Wrap" />
                                <TextBlock Margin="{StaticResource CaptionTopMargin}" Style="{StaticResource CaptionTextStyle}" Text="{Binding CompletedText}" />
                                <TextBlock Margin="{StaticResource CaptionTopMargin}" Style="{StaticResource CaptionTextStyle}" Text="{Binding QuadrantId, StringFormat=象限 {0}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding RestoreCommand}" CommandParameter="{Binding Id}" Content="恢复" />
                                <Button Margin="{StaticResource ButtonGap}" Command="{Binding DeleteCommand}" CommandParameter="{Binding Id}" Content="永久删除" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
