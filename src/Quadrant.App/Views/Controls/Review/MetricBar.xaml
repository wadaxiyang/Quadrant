<UserControl x:Class="Quadrant.App.Views.Controls.Review.MetricBar"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="64">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="{Binding Label, ElementName=Root}"/>
        <TextBlock Margin="8,0,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SecondaryLabel, ElementName=Root}"/>
      </StackPanel>
      <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextStyle}" Text="{Binding ValueText, ElementName=Root}"/>
    </Grid>
    <ProgressBar Grid.Row="1" Height="8" Margin="0,8,0,0" Maximum="100" Value="{Binding ProgressValue, ElementName=Root}" IsHitTestVisible="False">
      <ProgressBar.Style>
        <Style TargetType="ProgressBar">
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding QuadrantId, ElementName=Root}" Value="1"><Setter Property="Foreground" Value="{DynamicResource QuadrantQ1AccentBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding QuadrantId, ElementName=Root}" Value="2"><Setter Property="Foreground" Value="{DynamicResource QuadrantQ2AccentBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding QuadrantId, ElementName=Root}" Value="3"><Setter Property="Foreground" Value="{DynamicResource QuadrantQ3AccentBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding QuadrantId, ElementName=Root}" Value="4"><Setter Property="Foreground" Value="{DynamicResource QuadrantQ4AccentBrush}"/></DataTrigger>
          </Style.Triggers>
        </Style>
      </ProgressBar.Style>
    </ProgressBar>
    <TextBlock Grid.Row="2" Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PercentageText, ElementName=Root}"/>
  </Grid>
</UserControl>
