<Page x:Class="Quadrant.App.Views.Pages.InboxPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      PreviewKeyDown="Page_PreviewKeyDown">
    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource TitleLargeTextStyle}" Text="Inbox" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="未分类的快速收集任务" />
            </StackPanel>
            <ui:InfoBadge Grid.Column="1" VerticalAlignment="Center" Value="{Binding Count}" AutomationProperties.Name="Inbox 任务数量" />
        </Grid>
        <ui:InfoBar Grid.Row="1" Margin="0,0,0,16" IsOpen="True" IsClosable="False" Severity="Informational" Message="选择一行后按 1–4 分类；Enter 编辑，Delete 删除。" />
        <Grid Grid.Row="2">
            <ListBox x:Name="InboxList" ItemsSource="{Binding Tasks}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Inbox 未分类任务列表">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Margin="0,0,12,0" Padding="4" Click="Complete_Click" Tag="{Binding}" ToolTip="完成任务" AutomationProperties.Name="完成 Inbox 任务" Icon="{ui:SymbolIcon CheckmarkCircle24}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding CreatedAt, StringFormat=收集于 {0:g}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Margin="8,0,0,0" Padding="8,4" Content="Q1" Tag="{Binding}" Click="ClassifyQ1_Click" AutomationProperties.Name="分类到 Q1" />
                                    <ui:Button Margin="6,0,0,0" Padding="8,4" Content="Q2" Tag="{Binding}" Click="ClassifyQ2_Click" AutomationProperties.Name="分类到 Q2" />
                                    <ui:Button Margin="6,0,0,0" Padding="8,4" Content="Q3" Tag="{Binding}" Click="ClassifyQ3_Click" AutomationProperties.Name="分类到 Q3" />
                                    <ui:Button Margin="6,0,0,0" Padding="8,4" Content="Q4" Tag="{Binding}" Click="ClassifyQ4_Click" AutomationProperties.Name="分类到 Q4" />
                                    <ui:Button Margin="10,0,0,0" Padding="4" Icon="{ui:SymbolIcon CalendarAdd24}" Tag="{Binding}" Click="PlanToday_Click" ToolTip="添加到 Today" AutomationProperties.Name="添加 Inbox 任务到 Today" />
                                    <ui:Button Margin="10,0,0,0" Padding="4" Icon="{ui:SymbolIcon Edit24}" Tag="{Binding}" Click="Edit_Click" ToolTip="编辑任务" AutomationProperties.Name="编辑 Inbox 任务" />
                                    <ui:Button Margin="6,0,0,0" Padding="4" Appearance="Transparent" Icon="{ui:SymbolIcon Delete24}" Tag="{Binding}" Click="Delete_Click" ToolTip="删除任务" AutomationProperties.Name="删除 Inbox 任务" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:ProgressRing Width="32" Height="32" IsIndeterminate="True" />
                <TextBlock Margin="0,12,0,0" Style="{StaticResource CaptionTextStyle}" Text="正在加载 Inbox…" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Inbox 已清空" HorizontalAlignment="Center" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="未分类的快速收集任务会出现在这里。" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding ErrorMessage}" HorizontalAlignment="Center" />
                <ui:Button Margin="0,12,0,0" Content="重试" Click="Retry_Click" AutomationProperties.Name="重试加载 Inbox" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
