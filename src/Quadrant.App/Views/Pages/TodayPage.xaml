<Page x:Class="Quadrant.App.Views.Pages.TodayPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Loaded="Page_Loaded" Unloaded="Page_Unloaded">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,16,24,24">
    <TextBlock Style="{StaticResource TitleLargeTextStyle}" Text="Today" />
    <TextBlock Margin="0,4,0,16" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="计划、到期与需要重新安排的任务" />
    <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="计划日期不会自动移动；请明确选择 Today、Tomorrow 或移除计划。" />
    <StackPanel Margin="0,16,0,0" Orientation="Horizontal"><ui:InfoBadge Value="{Binding UniqueTaskCount}" /><TextBlock Margin="8,0,20,0" VerticalAlignment="Center" Text="项任务" /><TextBlock VerticalAlignment="Center" Text="{Binding EstimatedMinutesTotal, StringFormat=预计 {0} 分钟}" /></StackPanel>
    <StackPanel Margin="0,20,0,0" Visibility="{Binding HasOverdue, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="已逾期" /><ui:ListView ItemsSource="{Binding Overdue}" ItemTemplate="{DynamicResource TodayTaskTemplate}" Style="{StaticResource QuadrantTaskListStyle}" /></StackPanel>
    <StackPanel Margin="0,20,0,0" Visibility="{Binding HasPlannedToday, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="计划于今天" /><ui:ListView ItemsSource="{Binding PlannedToday}" ItemTemplate="{DynamicResource TodayTaskTemplate}" Style="{StaticResource QuadrantTaskListStyle}" /></StackPanel>
    <StackPanel Margin="0,20,0,0" Visibility="{Binding HasDueToday, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="今天到期" /><ui:ListView ItemsSource="{Binding DueToday}" ItemTemplate="{DynamicResource TodayTaskTemplate}" Style="{StaticResource QuadrantTaskListStyle}" /></StackPanel>
    <StackPanel Margin="0,20,0,0" Visibility="{Binding HasNeedsReschedule, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="需要重新安排" /><ui:ListView ItemsSource="{Binding NeedsReschedule}" ItemTemplate="{DynamicResource TodayTaskTemplate}" Style="{StaticResource QuadrantTaskListStyle}" /></StackPanel>
    <StackPanel HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="今天没有计划任务" /><TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="在 Home 或 Inbox 中把任务添加到 Today。" /></StackPanel>
    <ui:Button Margin="0,16,0,0" HorizontalAlignment="Left" Content="重试" Click="Retry_Click" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
  </StackPanel></ScrollViewer>
  <Page.Resources><DataTemplate x:Key="TodayTaskTemplate"><Border Padding="12" Margin="0,8,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Title}"/><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding DueAt, StringFormat=截止 {0:g}}"/><ui:SymbolIcon Margin="8,0,0,0" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="ArrowRepeatAll20" ToolTip="重复任务：完成后创建下一项" AutomationProperties.Name="重复任务"><ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RecurrenceKind}" Value="Daily"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding RecurrenceKind}" Value="Weekly"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding RecurrenceKind}" Value="Monthly"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style></ui:SymbolIcon></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><ui:Button Tag="{Binding}" Click="Complete_Click" ToolTip="完成" Icon="{ui:SymbolIcon CheckmarkCircle24}"/><ui:Button Margin="6,0,0,0" Tag="{Binding}" Click="Today_Click" Content="Today"/><ui:Button Margin="6,0,0,0" Tag="{Binding}" Click="Tomorrow_Click" Content="Tomorrow"/><ui:Button Margin="6,0,0,0" Tag="{Binding}" Click="Remove_Click" ToolTip="移除计划" Icon="{ui:SymbolIcon Delete24}"/></StackPanel></Grid></Border></DataTemplate></Page.Resources>
</Page>
