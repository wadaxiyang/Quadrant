<Page x:Class="Quadrant.App.Views.Pages.FocusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">
    <Grid Margin="{StaticResource PageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource PageHeaderContainerStyle}">
            <StackPanel Style="{StaticResource PageHeaderTitleStackStyle}">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Focus" />
                <TextBlock Margin="{StaticResource PageSubtitleMargin}" Style="{StaticResource PageSubtitleTextStyle}" Text="专注于当前任务" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Center">
                <Border Style="{StaticResource HeroSurfaceStyle}">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource SectionSubtitleTextStyle}" Text="当前任务" />
                        <ComboBox Width="520" MaxWidth="520" Margin="0,8,0,0" HorizontalAlignment="Center"
                                  automation:AutomationProperties.Name="当前专注任务"
                                  IsEnabled="{Binding CanConfigureSession}"
                                  ItemsSource="{Binding TaskOptions}"
                                  SelectedItem="{Binding SelectedTaskOption}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,2">
                                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Style="{StaticResource CaptionTextStyle}" Text="{Binding Metadata}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Border Width="280" Margin="0,24,0,0" HorizontalAlignment="Center" Style="{StaticResource HomeFilterGroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" MinHeight="34" Content="Pomodoro" IsEnabled="{Binding CanConfigureSession}"
                                           automation:AutomationProperties.Name="Pomodoro 模式" Click="PomodoroMode_Click">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Appearance" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPomodoroMode}" Value="True"><Setter Property="Appearance" Value="Primary" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button Grid.Column="1" MinHeight="34" Content="Stopwatch" IsEnabled="{Binding CanConfigureSession}"
                                           automation:AutomationProperties.Name="Stopwatch 模式" Click="StopwatchMode_Click">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Appearance" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStopwatchMode}" Value="True"><Setter Property="Appearance" Value="Primary" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,24,0,0" automation:AutomationProperties.LiveSetting="Polite"
                                   Style="{StaticResource TimerTextStyle}" Text="{Binding TimerText}" />
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource BodyTextStyle}" Text="{Binding StatusText}" />
                        <ProgressBar Width="440" Height="4" Margin="0,20,0,0" HorizontalAlignment="Center"
                                     automation:AutomationProperties.Name="Pomodoro 进度"
                                     Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue, Mode=OneWay}"
                                     Visibility="{Binding IsPomodoroMode, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <StackPanel Margin="0,24,0,0" HorizontalAlignment="Center"
                                    Visibility="{Binding IsIdle, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:Button MinWidth="156" MinHeight="40" Appearance="Primary" Content="开始专注"
                                       Icon="{ui:SymbolIcon Play24}" Click="Start_Click" />
                        </StackPanel>

                        <StackPanel Margin="0,24,0,0" HorizontalAlignment="Center"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:Button MinWidth="156" MinHeight="40" Appearance="Primary" Content="暂停"
                                       Icon="{ui:SymbolIcon Pause24}" Click="Pause_Click" />
                            <StackPanel Margin="0,12,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <ui:Button MinWidth="104" Appearance="Secondary" Content="结束专注" Icon="{ui:SymbolIcon Stop24}" Click="Stop_Click" />
                                <ui:Button MinWidth="80" Margin="8,0,0,0" Appearance="Transparent" Content="取消" Click="Cancel_Click" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,24,0,0" HorizontalAlignment="Center"
                                    Visibility="{Binding IsPaused, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:Button MinWidth="156" MinHeight="40" Appearance="Primary" Content="继续"
                                       Icon="{ui:SymbolIcon Play24}" Click="Resume_Click" />
                            <StackPanel Margin="0,12,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <ui:Button MinWidth="104" Appearance="Secondary" Content="结束专注" Icon="{ui:SymbolIcon Stop24}" Click="Stop_Click" />
                                <ui:Button MinWidth="80" Margin="8,0,0,0" Appearance="Transparent" Content="取消" Click="Cancel_Click" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock MaxWidth="520" Margin="0,16,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                   Style="{StaticResource ValidationTextStyle}" Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0" Style="{StaticResource SectionSurfaceStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:SymbolIcon Width="32" Height="32" VerticalAlignment="Center" FontSize="22"
                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Symbol="Clock24" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="Today" />
                            <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextStyle}" Text="已完成的有效专注" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextStyle}" Text="{Binding TodaySummaryText}" />
                            <TextBlock Margin="0,2,0,0" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextStyle}" Text="Stopwatch 与 Pomodoro Focus" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
