<Page x:Class="Quadrant.App.Views.Pages.FocusPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Loaded="Page_Loaded" Unloaded="Page_Unloaded"><Grid Margin="24,16,24,24"><StackPanel><TextBlock Style="{StaticResource TitleLargeTextStyle}" Text="Focus"/><TextBlock Margin="0,4,0,20" Style="{StaticResource CaptionTextStyle}" Text="专注计时会持续运行；离开此页面仅停止界面刷新。"/><ComboBox ItemsSource="{Binding Tasks}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedTask}"/><ComboBox Margin="0,16,0,0" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"/><TextBlock Margin="0,28,0,20" FontSize="56" FontWeight="SemiBold" Text="{Binding TimerText}" HorizontalAlignment="Center"/><StackPanel HorizontalAlignment="Center" Orientation="Horizontal"><ui:Button Content="开始" Appearance="Primary" Click="Start_Click" IsEnabled="{Binding IsIdle}"/><ui:Button Margin="8,0,0,0" Content="暂停" Click="Pause_Click" IsEnabled="{Binding IsRunning}"/><ui:Button Margin="8,0,0,0" Content="继续" Click="Resume_Click" IsEnabled="{Binding IsPaused}"/><ui:Button Margin="8,0,0,0" Content="结束专注" Click="Stop_Click" IsEnabled="{Binding IsRunning}"/><ui:Button Margin="8,0,0,0" Content="取消" Click="Cancel_Click" IsEnabled="{Binding IsRunning}"/></StackPanel><TextBlock Margin="0,16,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding ErrorMessage}"/></StackPanel></Grid></Page>
