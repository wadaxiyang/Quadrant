<Page x:Class="Quadrant.App.Views.Pages.QuadrantsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:enums="clr-namespace:Quadrant.Core.Enums;assembly=Quadrant.Core"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      SizeChanged="Page_SizeChanged"
      PreviewKeyDown="Page_PreviewKeyDown">
    <Grid Margin="{StaticResource PageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TitleLargeTextStyle}" Text="四象限" />
                <TextBlock Margin="{StaticResource PageSubtitleMargin}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="从 Inbox 分类任务，按重要与紧急程度安排下一步" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBox x:Name="SearchBox" Width="260" Margin="0,0,12,0" ClearButtonEnabled="True" PlaceholderText="搜索标题或备注" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索任务标题和备注">
                    <ui:TextBox.Icon><ui:SymbolIcon Symbol="Search24" /></ui:TextBox.Icon>
                </ui:TextBox>
                <ui:Button Appearance="Primary" Command="{Binding NewTaskCommand}" Content="新建任务" Icon="{ui:SymbolIcon Add24}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ToggleButton MinWidth="64" IsChecked="{Binding SelectedFilter, Converter={StaticResource TaskFilterToBooleanConverter}, ConverterParameter=All}" Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static enums:TaskFilter.All}" Content="全部" />
                <ToggleButton MinWidth="64" Margin="8,0,0,0" IsChecked="{Binding SelectedFilter, Converter={StaticResource TaskFilterToBooleanConverter}, ConverterParameter=Today}" Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static enums:TaskFilter.Today}" Content="今天" />
                <ToggleButton MinWidth="72" Margin="8,0,0,0" IsChecked="{Binding SelectedFilter, Converter={StaticResource TaskFilterToBooleanConverter}, ConverterParameter=Overdue}" Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static enums:TaskFilter.Overdue}" Content="已逾期" />
            </StackPanel>
            <ui:Button x:Name="NarrowInboxButton" Grid.Column="1" Margin="12,0,0,0" Appearance="Secondary" Click="NarrowInboxButton_Click" Visibility="Collapsed" AutomationProperties.Name="展开或收起 Inbox">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="Archive24" />
                    <TextBlock x:Name="NarrowInboxButtonLabel" VerticalAlignment="Center" Text="Inbox" />
                    <ui:InfoBadge Margin="8,0,0,0" Value="{Binding Count}" />
                </StackPanel>
            </ui:Button>
            <ui:InfoBar Grid.Column="2" Margin="16,0,0,0" IsOpen="{Binding HasPossiblyMissedReminders}" IsClosable="False" Severity="Warning" Message="{Binding PossiblyMissedReminderText}" />
        </Grid>

        <Grid x:Name="WorkspaceGrid" Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="InboxColumn" Width="248" />
                <ColumnDefinition x:Name="InboxGapColumn" Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="InboxPanel" Grid.Row="1" Grid.Column="0" Padding="12" Style="{StaticResource SectionSurfaceStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:SymbolIcon Margin="0,1,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Archive24" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Inbox" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="拖到象限分类 · 1–4 快捷键" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:InfoBadge Grid.Column="2" VerticalAlignment="Top" Value="{Binding Count}" AutomationProperties.Name="Inbox 任务数量" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="InboxList" ItemsSource="{Binding Tasks}" Style="{StaticResource QuadrantTaskListStyle}" AutomationProperties.Name="Home Inbox 未分类任务列表">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TaskRowSurfaceStyle}"
                                            Cursor="Hand"
                                            ToolTip="拖到象限进行分类"
                                            AutomationProperties.Name="{Binding Title}"
                                            PreviewMouseLeftButtonDown="InboxTask_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="InboxTask_PreviewMouseMove">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="添加到 Today" Tag="{Binding}" Click="InboxPlanToday_Click"><MenuItem.Icon><ui:SymbolIcon Symbol="CalendarAdd24" /></MenuItem.Icon></MenuItem>
                                                <MenuItem Header="编辑" Tag="{Binding}" Click="InboxEdit_Click"><MenuItem.Icon><ui:SymbolIcon Symbol="Edit24" /></MenuItem.Icon></MenuItem>
                                                <Separator />
                                                <MenuItem Header="删除" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Tag="{Binding}" Click="InboxDelete_Click"><MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon></MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Margin="0,2,8,0" VerticalAlignment="Top" Tag="{Binding}" Click="InboxComplete_Click" ToolTip="完成任务" AutomationProperties.Name="完成 Inbox 任务" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock MaxHeight="40" Style="{StaticResource BodyStrongTextStyle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding CreatedAt, StringFormat=收集于 {0:MM-dd HH:mm}}" />
                                                    <ui:SymbolIcon Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="ArrowRepeatAll20" ToolTip="重复任务：完成后创建下一项" AutomationProperties.Name="重复任务">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RecurrenceKind}" Value="Daily"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding RecurrenceKind}" Value="Weekly"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding RecurrenceKind}" Value="Monthly"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </StackPanel>
                                            </StackPanel>
                                            <Menu Grid.Column="2" Margin="4,0,0,0" Padding="0" Background="Transparent">
                                                <MenuItem Width="28" Height="28" Padding="6" AutomationProperties.Name="更多 Inbox 任务操作" ToolTip="更多">
                                                    <MenuItem.Header><ui:SymbolIcon FontSize="16" Symbol="MoreHorizontal24" /></MenuItem.Header>
                                                    <MenuItem Header="添加到 Today" Tag="{Binding}" Click="InboxPlanToday_Click"><MenuItem.Icon><ui:SymbolIcon Symbol="CalendarAdd24" /></MenuItem.Icon></MenuItem>
                                                    <MenuItem Header="编辑" Tag="{Binding}" Click="InboxEdit_Click"><MenuItem.Icon><ui:SymbolIcon Symbol="Edit24" /></MenuItem.Icon></MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="删除" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Tag="{Binding}" Click="InboxDelete_Click"><MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon></MenuItem>
                                                </MenuItem>
                                            </Menu>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:ProgressRing Width="28" Height="28" IsIndeterminate="True" />
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="正在加载 Inbox…" />
                        </StackPanel>
                        <StackPanel MaxWidth="200" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:SymbolIcon HorizontalAlignment="Center" FontSize="28" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="CheckmarkCircle24" />
                            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextStyle}" Text="Inbox 已清空" />
                            <TextBlock Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="快速记录的新任务会先出现在这里" />
                            <ui:Button Margin="0,12,0,0" HorizontalAlignment="Center" Appearance="Transparent" Content="添加任务" Icon="{ui:SymbolIcon Add24}" Command="{Binding DataContext.NewTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}" />
                        </StackPanel>
                        <StackPanel MaxWidth="200" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:SymbolIcon HorizontalAlignment="Center" FontSize="28" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="ErrorCircle24" />
                            <TextBlock Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Text="{Binding ErrorMessage}" />
                            <ui:Button Margin="0,12,0,0" HorizontalAlignment="Center" Content="重试" Click="InboxRetry_Click" AutomationProperties.Name="重试加载 Inbox" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="MatrixPanel" Grid.Row="1" Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Tag="1" Margin="0,0,8,8" Style="{StaticResource QuadrantPanelStyle}" AllowDrop="True" DragOver="Quadrant_DragOver" Drop="Quadrant_Drop" DragLeave="Quadrant_DragLeave">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource QuadrantQ1AccentBrush}" CornerRadius="2" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Quadrants[0].Name}" /><TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Quadrants[0].Subtitle}" /></StackPanel>
                            <ui:InfoBadge Grid.Column="2" Value="{Binding Quadrants[0].TaskCountText}" />
                        </Grid>
                        <Grid Grid.Row="1"><ListBox ItemsSource="{Binding Quadrants[0].Tasks}" ItemTemplate="{StaticResource TaskCardTemplate}" Style="{StaticResource QuadrantTaskListStyle}" /><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Quadrants[0].EmptyText}" Visibility="{Binding Quadrants[0].IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Tag="2" Margin="8,0,0,8" Style="{StaticResource QuadrantPanelStyle}" AllowDrop="True" DragOver="Quadrant_DragOver" Drop="Quadrant_Drop" DragLeave="Quadrant_DragLeave">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource QuadrantQ2AccentBrush}" CornerRadius="2" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Quadrants[1].Name}" /><TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Quadrants[1].Subtitle}" /></StackPanel>
                            <ui:InfoBadge Grid.Column="2" Value="{Binding Quadrants[1].TaskCountText}" />
                        </Grid>
                        <Grid Grid.Row="1"><ListBox ItemsSource="{Binding Quadrants[1].Tasks}" ItemTemplate="{StaticResource TaskCardTemplate}" Style="{StaticResource QuadrantTaskListStyle}" /><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Quadrants[1].EmptyText}" Visibility="{Binding Quadrants[1].IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Tag="3" Margin="0,8,8,0" Style="{StaticResource QuadrantPanelStyle}" AllowDrop="True" DragOver="Quadrant_DragOver" Drop="Quadrant_Drop" DragLeave="Quadrant_DragLeave">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource QuadrantQ3AccentBrush}" CornerRadius="2" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Quadrants[2].Name}" /><TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Quadrants[2].Subtitle}" /></StackPanel>
                            <ui:InfoBadge Grid.Column="2" Value="{Binding Quadrants[2].TaskCountText}" />
                        </Grid>
                        <Grid Grid.Row="1"><ListBox ItemsSource="{Binding Quadrants[2].Tasks}" ItemTemplate="{StaticResource TaskCardTemplate}" Style="{StaticResource QuadrantTaskListStyle}" /><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Quadrants[2].EmptyText}" Visibility="{Binding Quadrants[2].IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Tag="4" Margin="8,8,0,0" Style="{StaticResource QuadrantPanelStyle}" AllowDrop="True" DragOver="Quadrant_DragOver" Drop="Quadrant_Drop" DragLeave="Quadrant_DragLeave">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource QuadrantQ4AccentBrush}" CornerRadius="2" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Quadrants[3].Name}" /><TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Quadrants[3].Subtitle}" /></StackPanel>
                            <ui:InfoBadge Grid.Column="2" Value="{Binding Quadrants[3].TaskCountText}" />
                        </Grid>
                        <Grid Grid.Row="1"><ListBox ItemsSource="{Binding Quadrants[3].Tasks}" ItemTemplate="{StaticResource TaskCardTemplate}" Style="{StaticResource QuadrantTaskListStyle}" /><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Quadrants[3].EmptyText}" Visibility="{Binding Quadrants[3].IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
