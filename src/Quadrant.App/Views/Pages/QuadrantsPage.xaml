<Page x:Class="Quadrant.App.Views.Pages.QuadrantsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:enums="clr-namespace:Quadrant.Core.Enums;assembly=Quadrant.Core"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent"
      PreviewKeyDown="Page_PreviewKeyDown">
    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TitleLargeTextStyle}" Text="四象限" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="按重要与紧急程度安排下一步" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBox x:Name="SearchBox" Width="260" Margin="0,0,12,0" ClearButtonEnabled="True" PlaceholderText="搜索标题或备注" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索任务标题和备注">
                    <ui:TextBox.Icon><ui:SymbolIcon Symbol="Search24" /></ui:TextBox.Icon>
                </ui:TextBox>
                <ui:Button Appearance="Primary" Command="{Binding NewTaskCommand}" Content="新建任务" Icon="{ui:SymbolIcon Add24}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ToggleButton MinWidth="64" IsChecked="{Binding SelectedFilter, Converter={StaticResource TaskFilterToBooleanConverter}, ConverterParameter=All}" Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static enums:TaskFilter.All}" Content="全部" />
                <ToggleButton MinWidth="64" Margin="8,0,0,0" IsChecked="{Binding SelectedFilter, Converter={StaticResource TaskFilterToBooleanConverter}, ConverterParameter=Today}" Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static enums:TaskFilter.Today}" Content="今天" />
                <ToggleButton MinWidth="72" Margin="8,0,0,0" IsChecked="{Binding SelectedFilter, Converter={StaticResource TaskFilterToBooleanConverter}, ConverterParameter=Overdue}" Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static enums:TaskFilter.Overdue}" Content="已逾期" />
            </StackPanel>
            <ui:InfoBar Grid.Column="1" Margin="16,0,0,0" IsOpen="{Binding HasPossiblyMissedReminders}" IsClosable="False" Severity="Warning" Message="{Binding PossiblyMissedReminderText}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Tag="1" Margin="0,0,8,8" Style="{StaticResource QuadrantPanelStyle}" AllowDrop="True" DragOver="Quadrant_DragOver" Drop="Quadrant_Drop" DragLeave="Quadrant_DragLeave">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource QuadrantQ1AccentBrush}" CornerRadius="2" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Quadrants[0].Name}" /><TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Quadrants[0].Subtitle}" /></StackPanel>
                        <ui:InfoBadge Grid.Column="2" Value="{Binding Quadrants[0].TaskCountText}" />
                    </Grid>
                    <Grid Grid.Row="1"><ListBox ItemsSource="{Binding Quadrants[0].Tasks}" ItemTemplate="{StaticResource TaskCardTemplate}" Style="{StaticResource QuadrantTaskListStyle}" /><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Quadrants[0].EmptyText}" Visibility="{Binding Quadrants[0].IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Tag="2" Margin="8,0,0,8" Style="{StaticResource QuadrantPanelStyle}" AllowDrop="True" DragOver="Quadrant_DragOver" Drop="Quadrant_Drop" DragLeave="Quadrant_DragLeave">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource QuadrantQ2AccentBrush}" CornerRadius="2" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Quadrants[1].Name}" /><TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Quadrants[1].Subtitle}" /></StackPanel>
                        <ui:InfoBadge Grid.Column="2" Value="{Binding Quadrants[1].TaskCountText}" />
                    </Grid>
                    <Grid Grid.Row="1"><ListBox ItemsSource="{Binding Quadrants[1].Tasks}" ItemTemplate="{StaticResource TaskCardTemplate}" Style="{StaticResource QuadrantTaskListStyle}" /><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Quadrants[1].EmptyText}" Visibility="{Binding Quadrants[1].IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Tag="3" Margin="0,8,8,0" Style="{StaticResource QuadrantPanelStyle}" AllowDrop="True" DragOver="Quadrant_DragOver" Drop="Quadrant_Drop" DragLeave="Quadrant_DragLeave">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource QuadrantQ3AccentBrush}" CornerRadius="2" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Quadrants[2].Name}" /><TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Quadrants[2].Subtitle}" /></StackPanel>
                        <ui:InfoBadge Grid.Column="2" Value="{Binding Quadrants[2].TaskCountText}" />
                    </Grid>
                    <Grid Grid.Row="1"><ListBox ItemsSource="{Binding Quadrants[2].Tasks}" ItemTemplate="{StaticResource TaskCardTemplate}" Style="{StaticResource QuadrantTaskListStyle}" /><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Quadrants[2].EmptyText}" Visibility="{Binding Quadrants[2].IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Tag="4" Margin="8,8,0,0" Style="{StaticResource QuadrantPanelStyle}" AllowDrop="True" DragOver="Quadrant_DragOver" Drop="Quadrant_Drop" DragLeave="Quadrant_DragLeave">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource QuadrantQ4AccentBrush}" CornerRadius="2" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Quadrants[3].Name}" /><TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Quadrants[3].Subtitle}" /></StackPanel>
                        <ui:InfoBadge Grid.Column="2" Value="{Binding Quadrants[3].TaskCountText}" />
                    </Grid>
                    <Grid Grid.Row="1"><ListBox ItemsSource="{Binding Quadrants[3].Tasks}" ItemTemplate="{StaticResource TaskCardTemplate}" Style="{StaticResource QuadrantTaskListStyle}" /><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Quadrants[3].EmptyText}" Visibility="{Binding Quadrants[3].IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
