<Page x:Class="Quadrant.App.Views.Pages.ReviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:review="clr-namespace:Quadrant.App.Views.Controls.Review"
      ScrollViewer.CanContentScroll="False"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      SizeChanged="Page_SizeChanged"
      PreviewMouseWheel="Page_PreviewMouseWheel">
  <Page.Resources>
    <Style x:Key="ReviewSectionCardStyle" TargetType="Border" BasedOn="{StaticResource QuadrantPanelStyle}">
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="MinHeight" Value="176"/>
    </Style>
    <Style x:Key="ReviewEmptyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
      <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>
  </Page.Resources>

  <Grid Margin="24,16,24,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Style="{StaticResource TitleLargeTextStyle}" Text="Review"/>
        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding RangeSubtitle}"/>
      </StackPanel>
      <ComboBox Grid.Column="1" Width="132" VerticalAlignment="Center"
                ItemsSource="{Binding RangeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                SelectedValue="{Binding SelectedRange}" AutomationProperties.Name="Review 统计范围"/>
      <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Orientation="Horizontal">
        <ui:Button Padding="12,6" Content="总览" Click="OverviewAnchor_Click" AutomationProperties.Name="转到 Review 总览"/>
        <ui:Button Margin="8,0,0,0" Padding="12,6" Content="分布" Click="DistributionAnchor_Click" AutomationProperties.Name="转到象限分布"/>
        <ui:Button Margin="8,0,0,0" Padding="12,6" Content="活动" Click="ActivityAnchor_Click" AutomationProperties.Name="转到活动"/>
        <ui:Button Margin="8,0,0,0" Padding="12,6" Content="近期完成" Click="RecentAnchor_Click" AutomationProperties.Name="转到近期完成"/>
      </StackPanel>
    </Grid>

    <ScrollViewer x:Name="DashboardScrollViewer" Grid.Row="1" Margin="0,20,0,0"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False" PanningMode="VerticalOnly">
      <StackPanel x:Name="DashboardContent">
        <Border x:Name="OverviewAnchor" Height="0" IsHitTestVisible="False"/>
        <ItemsControl ItemsSource="{Binding PrimaryKpis}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="176" MinHeight="104" Margin="0,0,12,12" Padding="12"
                      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                  <TextBlock Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Label}"/>
                  <TextBlock Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding Value}"/>
                  <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Comparison}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding CurrentStateKpis}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="176" MinHeight="88" Margin="0,0,12,12" Padding="12"
                      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                  <TextBlock Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Label}"/>
                  <TextBlock Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding Value}"/>
                  <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Comparison}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Margin="0,0,0,12" Padding="16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="还没有活动记录"/>
            <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="完成任务或结束专注后，这里会形成可回顾的统计。"/>
          </StackPanel>
        </Border>

        <Grid x:Name="SectionGrid">
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftSectionColumn" Width="*"/><ColumnDefinition x:Name="RightSectionColumn" Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border x:Name="ComparisonCard" Style="{StaticResource ReviewSectionCardStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="本期与上期"/>
              <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Comparisons}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <review:ComparisonBarGroup Margin="0,0,0,12" MetricName="{Binding MetricName}" CurrentLabel="{Binding CurrentLabel}"
                      PreviousLabel="{Binding PreviousLabel}" CurrentValue="{Binding CurrentValue}" PreviousValue="{Binding PreviousValue}"
                      CurrentText="{Binding CurrentText}" PreviousText="{Binding PreviousText}" DeltaText="{Binding DeltaText}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="全部时间范围不提供上一周期比较。">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource ReviewEmptyTextStyle}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding HasPreviousPeriod}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>

          <Border x:Name="CompletedCard" Grid.Column="1" Style="{StaticResource ReviewSectionCardStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="按象限完成"/>
              <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding CompletedQuadrantRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <review:MetricBar Margin="0,0,0,12" QuadrantId="{Binding QuadrantId}" Label="{Binding Label}" SecondaryLabel="{Binding SecondaryLabel}"
                                      ProgressValue="{Binding ProgressValue}" PercentageText="{Binding PercentageText}" ValueText="{Binding ValueText}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border x:Name="ActivityCard" Grid.Row="1" Style="{StaticResource ReviewSectionCardStyle}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="活动"/>
                <ComboBox Grid.Column="1" Width="96" ItemsSource="{Binding ActivityChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedActivityMode}" AutomationProperties.Name="活动指标"/>
              </Grid>
              <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding ActivityItems}">
                <ItemsControl.Style>
                  <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsSevenDayRange}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                  </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Text="{Binding DisplayLabel}"/>
                      <ProgressBar Grid.Column="1" Height="8" Margin="8,0" VerticalAlignment="Center" Maximum="100" Value="{Binding RelativeValue}"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" ToolTip="{Binding ToolTipText}" IsHitTestVisible="False"/>
                      <TextBlock Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Text="{Binding ValueText}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding ActivityItems}">
                <ItemsControl.Style>
                  <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsActivityStrip}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                  </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ProgressBar Width="12" Height="64" Margin="0,0,4,8" Orientation="Vertical" Maximum="100" Value="{Binding RelativeValue}"
                                 Foreground="{DynamicResource AccentFillColorDefaultBrush}" ToolTip="{Binding ToolTipText}" IsHitTestVisible="False"
                                 AutomationProperties.Name="{Binding ToolTipText}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border x:Name="FocusBreakdownCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource ReviewSectionCardStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="按象限专注"/>
              <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding FocusQuadrantRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <review:MetricBar Margin="0,0,0,12" QuadrantId="{Binding QuadrantId}" Label="{Binding Label}" SecondaryLabel="{Binding SecondaryLabel}"
                                      ProgressValue="{Binding ProgressValue}" PercentageText="{Binding PercentageText}" ValueText="{Binding ValueText}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="这个范围内没有已完成的有效专注记录。">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource ReviewEmptyTextStyle}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding HasFocusData}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>

          <Border x:Name="InsightsCard" Grid.Row="2" Style="{StaticResource ReviewSectionCardStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="洞察"/>
              <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding InsightItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="4"/>
                      <TextBlock Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding Text}" TextWrapping="Wrap"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="积累更多完成或专注记录后，这里会出现简短洞察。">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource ReviewEmptyTextStyle}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding HasInsights}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>

          <Border x:Name="FocusSummaryCard" Grid.Row="2" Grid.Column="1" Style="{StaticResource ReviewSectionCardStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="专注摘要"/>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="总专注"/><TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextStyle}" Text="{Binding FocusTotalText}"/>
                <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="有效次数"/><TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource BodyStrongTextStyle}" Text="{Binding FocusSessionsText}"/>
                <TextBlock Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="平均每次"/><TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource BodyStrongTextStyle}" Text="{Binding FocusAverageText}"/>
                <TextBlock Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="最长一次"/><TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource BodyStrongTextStyle}" Text="{Binding FocusLongestText}"/>
              </Grid>
              <Separator Margin="0,16,0,12"/>
              <TextBlock Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="专注最多的任务"/>
              <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyStrongTextStyle}" Text="{Binding MostFocusedTaskTitle}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding MostFocusedTaskDetail}"/>
              <TextBlock Margin="0,12,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="专注最多的象限"/>
              <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyStrongTextStyle}" Text="{Binding MostFocusedQuadrantText}"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border x:Name="RecentCompletedCard" Margin="0,0,12,0" Padding="16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="近期完成"/>
            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding RecentCompleted}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,8" AutomationProperties.Name="{Binding Title}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MetadataText}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Background="{DynamicResource ApplicationBackgroundBrush}" Opacity="0.92"
            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ui:ProgressRing IsIndeterminate="True"/>
        <TextBlock Margin="0,12,0,0" Style="{StaticResource CaptionTextStyle}" Text="正在加载 Review…"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource ApplicationBackgroundBrush}" Opacity="0.96"
            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Review 加载失败"/>
        <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding ErrorMessage}"/>
        <ui:Button Margin="0,12,0,0" Content="重试" Click="Retry_Click" AutomationProperties.Name="重试加载 Review"/>
      </StackPanel>
    </Border>
  </Grid>
</Page>
