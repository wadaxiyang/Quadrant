<Page x:Class="Quadrant.App.Views.Pages.ReviewPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Loaded="Page_Loaded" Unloaded="Page_Unloaded">
  <Grid Margin="24,16,24,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource TitleLargeTextStyle}" Text="Review"/><TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="查看完成记录与专注时间"/></StackPanel><ComboBox Grid.Column="1" Width="140" VerticalAlignment="Center" ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" AutomationProperties.Name="Review 统计范围"/></Grid>
    <UniformGrid Grid.Row="1" Margin="0,20,0,16" Columns="3"><Border Margin="0,0,8,0" Padding="14" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"><StackPanel><TextBlock Style="{StaticResource CaptionTextStyle}" Text="已完成"/><TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding CompletedTasksText}"/></StackPanel></Border><Border Margin="4,0" Padding="14" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"><StackPanel><TextBlock Style="{StaticResource CaptionTextStyle}" Text="专注时间"/><TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding FocusTimeText}"/></StackPanel></Border><Border Margin="8,0,0,0" Padding="14" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"><StackPanel><TextBlock Style="{StaticResource CaptionTextStyle}" Text="专注次数"/><TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding SessionCountText}"/></StackPanel></Border></UniformGrid>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Padding="14" Margin="0,0,8,16" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"><StackPanel><TextBlock Style="{StaticResource CaptionTextStyle}" Text="平均每次专注"/><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding AverageFocusText}"/></StackPanel></Border><Border Grid.Column="1" Padding="14" Margin="8,0,0,16" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"><StackPanel Orientation="Horizontal"><StackPanel><TextBlock Style="{StaticResource CaptionTextStyle}" Text="当前 Inbox"/><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding CurrentInboxText}"/></StackPanel><StackPanel Margin="32,0,0,0"><TextBlock Style="{StaticResource CaptionTextStyle}" Text="当前已逾期"/><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding CurrentOverdueText}"/></StackPanel></StackPanel></Border>
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource SectionTitleTextStyle}" Text="近期完成"/>
      <ListBox Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" ItemsSource="{Binding RecentCompleted}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"><ListBox.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,6" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Text="{Binding TaskTitleSnapshot}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding CompletedLocalDate, StringFormat={}{0:yyyy-MM-dd}}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
      <StackPanel Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="这个范围内还没有记录"/><TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="完成任务或结束专注后，统计会显示在这里。"/></StackPanel>
      <StackPanel Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Review 加载失败"/><ui:Button Margin="0,12,0,0" HorizontalAlignment="Center" Content="重试" Click="Retry_Click"/></StackPanel>
    </Grid>
  </Grid>
</Page>
