<Window x:Class="Quadrant.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="560" SizeToContent="Height" MinWidth="480" WindowStartupLocation="CenterOwner">
    <Grid Margin="{StaticResource WindowMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource TitleMediumTextStyle}" Text="设置" />
        <StackPanel Grid.Row="1" Margin="{StaticResource FieldTopMargin}">
            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="主题" />
            <ComboBox Margin="{StaticResource CaptionTopMargin}" SelectedValuePath="Tag" SelectedValue="{Binding Theme}">
                <ComboBoxItem Tag="System" Content="跟随系统" /><ComboBoxItem Tag="Light" Content="浅色" /><ComboBoxItem Tag="Dark" Content="深色" />
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="{StaticResource FieldTopMargin}">
            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="关闭按钮行为" />
            <ComboBox Margin="{StaticResource CaptionTopMargin}" SelectedValuePath="Tag" SelectedValue="{Binding CloseToTray}">
                <ComboBoxItem Tag="True" Content="最小化到托盘" /><ComboBoxItem Tag="False" Content="退出应用" />
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="{StaticResource FieldTopMargin}">
            <CheckBox Content="登录 Windows 后启动" IsChecked="{Binding LaunchAtStartup}" />
            <CheckBox Margin="{StaticResource CaptionTopMargin}" Content="启动后保持后台" IsChecked="{Binding StartMinimized}" />
            <TextBlock Margin="{StaticResource CaptionTopMargin}" Style="{StaticResource CaptionTextStyle}" Text="全局快捷键" />
            <TextBox Margin="{StaticResource CaptionTopMargin}" Text="{Binding GlobalHotkey, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <GroupBox Grid.Row="4" Margin="{StaticResource FieldTopMargin}" Header="四象限名称">
            <ItemsControl ItemsSource="{Binding Quadrants}"><ItemsControl.ItemTemplate><DataTemplate>
                <Grid Margin="{StaticResource CaptionTopMargin}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Width="32" VerticalAlignment="Center" Text="{Binding Id, StringFormat=Q{0}}" />
                    <TextBox Grid.Column="1" Margin="{StaticResource ButtonGap}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="2" Margin="{StaticResource ButtonGap}" Text="{Binding Subtitle, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </GroupBox>
        <StackPanel Grid.Row="5" Margin="{StaticResource FieldTopMargin}" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button IsCancel="True" MinWidth="80" Content="取消" /><Button Margin="{StaticResource ButtonGap}" IsDefault="True" MinWidth="80" Click="Save_Click" Content="保存" />
        </StackPanel>
    </Grid>
</Window>
