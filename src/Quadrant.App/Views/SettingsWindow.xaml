<ui:FluentWindow x:Class="Quadrant.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="设置"
                 Icon="/Resources/Quadrant.ico"
                 Width="620"
                 Height="680"
                 MinWidth="520"
                 MinHeight="560"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="设置" CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon><ui:ImageIcon Source="/Resources/Quadrant.ico" /></ui:TitleBar.Icon>
        </ui:TitleBar>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,16,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleLargeTextStyle}" Text="应用设置" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="调整外观、后台行为和象限名称" />
                </StackPanel>

                <ui:Card Grid.Row="1" Margin="0,16,0,0" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"><TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="主题" /><TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="跟随 Windows 或固定浅色/深色" /></StackPanel>
                        <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Theme}"><ComboBoxItem Tag="System" Content="跟随系统" /><ComboBoxItem Tag="Light" Content="浅色" /><ComboBoxItem Tag="Dark" Content="深色" /></ComboBox>
                    </Grid>
                </ui:Card>

                <ui:Card Grid.Row="2" Margin="0,12,0,0" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"><TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="关闭按钮" /><TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="选择隐藏到托盘或退出应用" /></StackPanel>
                        <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding CloseToTray}"><ComboBoxItem Tag="True" Content="隐藏到托盘" /><ComboBoxItem Tag="False" Content="退出应用" /></ComboBox>
                    </Grid>
                </ui:Card>

                <ui:Card Grid.Row="3" Margin="0,12,0,0" Padding="16">
                    <StackPanel>
                        <ui:ToggleSwitch Content="登录 Windows 后启动" IsChecked="{Binding LaunchAtStartup}" />
                        <ui:ToggleSwitch Margin="0,12,0,0" Content="启动后保持后台" IsChecked="{Binding StartMinimized}" />
                        <TextBlock Margin="0,16,0,0" Style="{StaticResource CaptionTextStyle}" Text="全局快捷键" />
                        <ui:TextBox Margin="0,4,0,0" Icon="{ui:SymbolIcon Keyboard24}" Text="{Binding GlobalHotkey, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ui:Card>

                <GroupBox Grid.Row="4" Margin="0,16,0,0" Header="四象限名称">
                    <ItemsControl Margin="8" ItemsSource="{Binding Quadrants}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Id, StringFormat=Q{0}}" />
                                <ui:TextBox Grid.Column="1" Margin="0,0,8,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:TextBox Grid.Column="2" Text="{Binding Subtitle, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <ui:InfoBar x:Name="ValidationInfo" Grid.Row="5" Margin="0,16,0,0" IsOpen="False" IsClosable="True" Severity="Error" Title="设置无法保存" />

                <StackPanel Grid.Row="6" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button IsCancel="True" MinWidth="88" Content="取消" />
                    <ui:Button Margin="8,0,0,0" Appearance="Primary" IsDefault="True" MinWidth="88" Click="Save_Click" Content="保存" Icon="{ui:SymbolIcon Save24}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
