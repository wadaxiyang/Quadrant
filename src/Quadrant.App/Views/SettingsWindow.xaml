<ui:FluentWindow x:Class="Quadrant.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="设置" Icon="/Resources/Quadrant.ico"
                 Width="720" Height="760" MinWidth="600" MinHeight="600"
                 ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterOwner">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ui:TitleBar Title="设置" CloseWindowByDoubleClickOnIcon="True">
      <ui:TitleBar.Icon><ui:ImageIcon Source="/Resources/Quadrant.ico"/></ui:TitleBar.Icon>
    </ui:TitleBar>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,16,24,20">
        <TextBlock Style="{StaticResource TitleLargeTextStyle}" Text="应用设置"/>
        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="只显示当前版本已经生效的选项"/>

        <TextBlock Margin="0,20,0,8" Style="{StaticResource SectionTitleTextStyle}" Text="常规"/>
        <ui:Card Padding="16"><StackPanel>
          <ui:ToggleSwitch Content="登录 Windows 后启动" IsChecked="{Binding LaunchAtStartup}"/>
          <ui:ToggleSwitch Margin="0,12,0,0" Content="启动后保持后台" IsChecked="{Binding StartMinimized}"/>
          <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextStyle}" Text="关闭按钮"/><ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding CloseToTray}"><ComboBoxItem Tag="True" Content="隐藏到托盘"/><ComboBoxItem Tag="False" Content="退出应用"/></ComboBox></Grid>
          <TextBlock Margin="0,16,0,4" Style="{StaticResource CaptionTextStyle}" Text="全局快捷键"/>
          <ui:TextBox Icon="{ui:SymbolIcon Keyboard24}" Text="{Binding GlobalHotkey, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="全局快捷键"/>
        </StackPanel></ui:Card>

        <TextBlock Margin="0,20,0,8" Style="{StaticResource SectionTitleTextStyle}" Text="任务"/>
        <ui:Card Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Quick Capture 默认位置"/><TextBlock Margin="0,4,12,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="默认进入 Inbox，或固定到一个象限"/></StackPanel>
          <ComboBox Grid.Column="1" ItemsSource="{Binding QuickCaptureDestinations}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding QuickCaptureQuadrantId}" AutomationProperties.Name="Quick Capture 默认位置"/>
          <StackPanel Grid.Row="1" Margin="0,16,12,0"><TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="默认提醒"/><TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="设置截止日期后自动选择；仍可逐项修改"/></StackPanel>
          <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,16,0,0" ItemsSource="{Binding ReminderChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DefaultReminder}" AutomationProperties.Name="任务默认提醒"/>
        </Grid></ui:Card>

        <TextBlock Margin="0,20,0,8" Style="{StaticResource SectionTitleTextStyle}" Text="Focus"/>
        <ui:Card Padding="16"><StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="专注时长"/><TextBlock Grid.Column="1" TextAlignment="Right" Text="{Binding FocusMinutes, StringFormat={}{0} 分}"/></Grid>
          <Slider Margin="0,4,0,0" Minimum="1" Maximum="240" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FocusMinutes}" AutomationProperties.Name="专注分钟"/>
          <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="短休息"/><TextBlock Grid.Column="1" TextAlignment="Right" Text="{Binding ShortBreakMinutes, StringFormat={}{0} 分}"/></Grid>
          <Slider Margin="0,4,0,0" Minimum="1" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ShortBreakMinutes}" AutomationProperties.Name="短休息分钟"/>
          <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="长休息"/><TextBlock Grid.Column="1" TextAlignment="Right" Text="{Binding LongBreakMinutes, StringFormat={}{0} 分}"/></Grid>
          <Slider Margin="0,4,0,0" Minimum="1" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding LongBreakMinutes}" AutomationProperties.Name="长休息分钟"/>
          <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="每几轮进入长休息"/><TextBlock Grid.Column="1" TextAlignment="Right" Text="{Binding LongBreakInterval, StringFormat={}{0} 轮}"/></Grid>
          <Slider Margin="0,4,0,0" Minimum="2" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding LongBreakInterval}" AutomationProperties.Name="长休息轮次"/>
          <ui:ToggleSwitch Margin="0,16,0,0" Content="专注结束后自动开始休息" IsChecked="{Binding AutoStartBreak}"/>
          <ui:ToggleSwitch Margin="0,12,0,0" Content="休息结束后自动开始下一次专注" IsChecked="{Binding AutoStartFocus}"/>
        </StackPanel></ui:Card>

        <TextBlock Margin="0,20,0,8" Style="{StaticResource SectionTitleTextStyle}" Text="通知"/>
        <ui:Card Padding="16"><StackPanel><ui:ToggleSwitch Content="任务提醒" IsChecked="{Binding TaskRemindersEnabled}"/><ui:ToggleSwitch Margin="0,12,0,0" Content="Focus 完成通知" IsChecked="{Binding FocusNotificationsEnabled}"/><ui:ToggleSwitch Margin="0,12,0,0" Content="通知声音" IsChecked="{Binding NotificationSoundEnabled}"/></StackPanel></ui:Card>

        <TextBlock Margin="0,20,0,8" Style="{StaticResource SectionTitleTextStyle}" Text="外观"/>
        <ui:Card Padding="16"><StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextStyle}" Text="主题"/><ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Theme}"><ComboBoxItem Tag="System" Content="跟随系统"/><ComboBoxItem Tag="Light" Content="浅色"/><ComboBoxItem Tag="Dark" Content="深色"/></ComboBox></Grid>
          <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="侧边栏图标大小"/><TextBlock Grid.Column="1" TextAlignment="Right" Text="{Binding SidebarIconSize, StringFormat={}{0:F0} px}"/></Grid>
          <Slider Margin="0,4,0,0" Minimum="16" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SidebarIconSize}" AutomationProperties.Name="侧边栏图标大小"/>
        </StackPanel></ui:Card>

        <TextBlock Margin="0,20,0,8" Style="{StaticResource SectionTitleTextStyle}" Text="Review"/>
        <ui:Card Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextStyle}" Text="默认统计范围"/><ComboBox Grid.Column="1" ItemsSource="{Binding ReviewRangeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ReviewDefaultRange}"/><TextBlock Grid.Row="1" Margin="0,16,0,0" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextStyle}" Text="每周起始日"/><ComboBox Grid.Row="1" Grid.Column="1" Margin="0,16,0,0" ItemsSource="{Binding WeekStartChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding WeekStart}"/></Grid></ui:Card>

        <TextBlock Margin="0,20,0,8" Style="{StaticResource SectionTitleTextStyle}" Text="四象限名称"/>
        <ui:Card Padding="12"><ItemsControl ItemsSource="{Binding Quadrants}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Id, StringFormat=Q{0}}"/><ui:TextBox Grid.Column="1" Margin="0,0,8,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/><ui:TextBox Grid.Column="2" Text="{Binding Subtitle, UpdateSourceTrigger=PropertyChanged}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ui:Card>

        <TextBlock Margin="0,20,0,8" Style="{StaticResource SectionTitleTextStyle}" Text="数据"/>
        <ui:Card Padding="16"><StackPanel><TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="数据库位置"/><TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding DatabasePath}" TextWrapping="Wrap"/>
          <WrapPanel x:Name="DataActionButtons" Margin="0,14,0,0"><ui:Button Margin="0,0,8,8" Click="Backup_Click" Content="备份数据库" Icon="{ui:SymbolIcon Save24}"/><ui:Button Margin="0,0,8,8" Click="Export_Click" Content="导出 JSON" Icon="{ui:SymbolIcon Document24}"/><ui:Button Margin="0,0,8,8" Click="ClearFocus_Click" Content="清除 Focus 历史"/><ui:Button Margin="0,0,8,8" Click="ClearCompletion_Click" Content="清除完成历史"/><ui:Button Margin="0,0,8,8" Appearance="Danger" Click="ResetAll_Click" Content="重置全部数据"/></WrapPanel>
          <ui:InfoBar x:Name="DataInfo" Margin="0,8,0,0" IsOpen="False" IsClosable="True" Severity="Informational" Title="数据维护"/>
        </StackPanel></ui:Card>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Padding="24,12" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource ApplicationBackgroundBrush}"><Grid><ui:InfoBar x:Name="ValidationInfo" Margin="0,0,200,0" IsOpen="False" IsClosable="True" Severity="Error" Title="设置无法保存"/><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal"><ui:Button IsCancel="True" MinWidth="88" Content="取消"/><ui:Button Margin="8,0,0,0" Appearance="Primary" IsDefault="True" MinWidth="88" Click="Save_Click" Content="保存" Icon="{ui:SymbolIcon Save24}"/></StackPanel></Grid></Border>
    <ui:ContentDialogHost x:Name="DialogHost" Grid.RowSpan="3" IsDisableSiblingsEnabled="True"/>
  </Grid>
</ui:FluentWindow>
