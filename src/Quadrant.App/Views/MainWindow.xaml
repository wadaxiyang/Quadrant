<Window x:Class="Quadrant.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding AppTitle}"
        Width="1180"
        Height="760"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="{StaticResource WindowMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Style="{StaticResource TitleLargeTextStyle}"
                       Text="{Binding AppTitle}" />
            <TextBlock DockPanel.Dock="Right"
                       Margin="{StaticResource ToolbarSecondaryMargin}"
                       VerticalAlignment="Center"
                       Style="{StaticResource BodyTextStyle}"
                       Opacity="0.7"
                       Text="{Binding PlaceholderTitle}" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Margin="{StaticResource QuadrantTopLeftMargin}" Style="{StaticResource QuadrantPanelStyle}">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SectionTitleTextStyle}" Text="Q1" />
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Margin="{StaticResource QuadrantTopRightMargin}" Style="{StaticResource QuadrantPanelStyle}">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SectionTitleTextStyle}" Text="Q2" />
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Margin="{StaticResource QuadrantBottomLeftMargin}" Style="{StaticResource QuadrantPanelStyle}">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SectionTitleTextStyle}" Text="Q3" />
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Margin="{StaticResource QuadrantBottomRightMargin}" Style="{StaticResource QuadrantPanelStyle}">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SectionTitleTextStyle}" Text="Q4" />
            </Border>
        </Grid>
    </Grid>
</Window>
