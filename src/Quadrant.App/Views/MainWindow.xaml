<Window x:Class="Quadrant.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding AppTitle}"
        Width="1180"
        Height="760"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Text="{Binding AppTitle}" />
            <TextBlock DockPanel.Dock="Right"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Opacity="0.7"
                       Text="{Binding PlaceholderTitle}" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="16">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Q1" />
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Margin="8,0,0,8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="16">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Q2" />
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Margin="0,8,8,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="16">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Q3" />
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Margin="8,8,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="16">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Q4" />
            </Border>
        </Grid>
    </Grid>
</Window>
