<Window x:Class="Quadrant.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Quadrant.App"
        xmlns:enums="clr-namespace:Quadrant.Core.Enums;assembly=Quadrant.Core"
        Title="{Binding AppTitle}"
        Width="1180"
        Height="760"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Grid Margin="{StaticResource WindowMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Style="{StaticResource TitleLargeTextStyle}"
                       Text="{Binding AppTitle}" />
            <Button DockPanel.Dock="Right" Margin="{StaticResource ToolbarSecondaryMargin}" Command="{Binding NewTaskCommand}" Content="新建任务" />
            <Button DockPanel.Dock="Right" Margin="{StaticResource ToolbarSecondaryMargin}" Click="Completed_Click" Content="已完成" />
            <TextBox x:Name="SearchBox"
                     DockPanel.Dock="Right"
                     Width="220"
                     Margin="{StaticResource ToolbarSecondaryMargin}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{Binding SearchPlaceholder}" />
            <StackPanel DockPanel.Dock="Right" Margin="{StaticResource ToolbarSecondaryMargin}" Orientation="Horizontal">
                <Button Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static enums:TaskFilter.All}" Content="全部" />
                <Button Margin="{StaticResource ButtonGap}" Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static enums:TaskFilter.Today}" Content="今天" />
                <Button Margin="{StaticResource ButtonGap}" Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static enums:TaskFilter.Overdue}" Content="已逾期" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Tag="1" AllowDrop="True" DragOver="Quadrant_DragOver" Drop="Quadrant_Drop" DragLeave="Quadrant_DragLeave" Margin="{StaticResource QuadrantTopLeftMargin}" Style="{StaticResource QuadrantPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="{StaticResource QuadrantHeaderBottomMargin}">
                        <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource QuadrantAccentWidth}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource QuadrantQ1AccentBrush}" />
                        <StackPanel Grid.Column="1" Margin="{StaticResource CaptionTopMargin}">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Quadrants[0].Name}" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Quadrants[0].Subtitle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextStyle}" Text="{Binding Quadrants[0].TaskCountText}" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Quadrants[0].Tasks}"
                                 ItemTemplate="{StaticResource TaskCardTemplate}"
                                 Padding="0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding Quadrants[0].EmptyText}"
                                   Visibility="{Binding Quadrants[0].IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Tag="2" AllowDrop="True" DragOver="Quadrant_DragOver" Drop="Quadrant_Drop" DragLeave="Quadrant_DragLeave" Margin="{StaticResource QuadrantTopRightMargin}" Style="{StaticResource QuadrantPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="{StaticResource QuadrantHeaderBottomMargin}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource QuadrantAccentWidth}" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource QuadrantQ2AccentBrush}" />
                        <StackPanel Grid.Column="1" Margin="{StaticResource CaptionTopMargin}">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Quadrants[1].Name}" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Quadrants[1].Subtitle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextStyle}" Text="{Binding Quadrants[1].TaskCountText}" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Quadrants[1].Tasks}" ItemTemplate="{StaticResource TaskCardTemplate}" Padding="0" BorderThickness="0" Background="Transparent" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Text="{Binding Quadrants[1].EmptyText}" Visibility="{Binding Quadrants[1].IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Tag="3" AllowDrop="True" DragOver="Quadrant_DragOver" Drop="Quadrant_Drop" DragLeave="Quadrant_DragLeave" Margin="{StaticResource QuadrantBottomLeftMargin}" Style="{StaticResource QuadrantPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="{StaticResource QuadrantHeaderBottomMargin}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource QuadrantAccentWidth}" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource QuadrantQ3AccentBrush}" />
                        <StackPanel Grid.Column="1" Margin="{StaticResource CaptionTopMargin}">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Quadrants[2].Name}" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Quadrants[2].Subtitle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextStyle}" Text="{Binding Quadrants[2].TaskCountText}" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Quadrants[2].Tasks}" ItemTemplate="{StaticResource TaskCardTemplate}" Padding="0" BorderThickness="0" Background="Transparent" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Text="{Binding Quadrants[2].EmptyText}" Visibility="{Binding Quadrants[2].IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Tag="4" AllowDrop="True" DragOver="Quadrant_DragOver" Drop="Quadrant_Drop" DragLeave="Quadrant_DragLeave" Margin="{StaticResource QuadrantBottomRightMargin}" Style="{StaticResource QuadrantPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="{StaticResource QuadrantHeaderBottomMargin}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource QuadrantAccentWidth}" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource QuadrantQ4AccentBrush}" />
                        <StackPanel Grid.Column="1" Margin="{StaticResource CaptionTopMargin}">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Quadrants[3].Name}" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Quadrants[3].Subtitle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextStyle}" Text="{Binding Quadrants[3].TaskCountText}" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Quadrants[3].Tasks}" ItemTemplate="{StaticResource TaskCardTemplate}" Padding="0" BorderThickness="0" Background="Transparent" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Text="{Binding Quadrants[3].EmptyText}" Visibility="{Binding Quadrants[3].IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
