<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Base spacing scale. New layout values should compose these six increments. -->
    <sys:Double x:Key="SpaceXS">4</sys:Double>
    <sys:Double x:Key="SpaceS">8</sys:Double>
    <sys:Double x:Key="SpaceM">12</sys:Double>
    <sys:Double x:Key="SpaceL">16</sys:Double>
    <sys:Double x:Key="SpaceXL">24</sys:Double>
    <sys:Double x:Key="SpaceXXL">32</sys:Double>

    <!-- Reusable insets. -->
    <Thickness x:Key="InsetS">8</Thickness>
    <Thickness x:Key="InsetM">12</Thickness>
    <Thickness x:Key="InsetL">16</Thickness>
    <Thickness x:Key="InsetXL">24</Thickness>
    <Thickness x:Key="InsetXXL">32</Thickness>

    <!-- Page and header grammar. -->
    <Thickness x:Key="PageContentMargin">24,16,24,24</Thickness>
    <Thickness x:Key="PageHeaderBottomMargin">0,0,0,24</Thickness>
    <Thickness x:Key="PageSubtitleMargin">0,4,0,0</Thickness>
    <Thickness x:Key="PageHeaderActionMargin">16,0,0,0</Thickness>
    <Thickness x:Key="PageHeaderControlGap">12,0,0,0</Thickness>

    <!-- Section and row rhythm. -->
    <Thickness x:Key="SectionTopMargin">0,24,0,0</Thickness>
    <Thickness x:Key="SectionHeaderBottomMargin">0,0,0,12</Thickness>
    <Thickness x:Key="SectionItemTopMargin">0,16,0,0</Thickness>
    <Thickness x:Key="RowBottomMargin">0,0,0,4</Thickness>
    <Thickness x:Key="RowContentPadding">12</Thickness>
    <Thickness x:Key="CompactControlPadding">8,4</Thickness>

    <!-- Existing aliases retained while pages migrate to the named grammar above. -->
    <Thickness x:Key="CaptionTopMargin">0,4,0,0</Thickness>
    <Thickness x:Key="FieldTopMargin">0,16,0,0</Thickness>
    <Thickness x:Key="ButtonGap">8,0,0,0</Thickness>
    <Thickness x:Key="TaskCardBottomMargin">0,0,8,0</Thickness>
    <Thickness x:Key="QuadrantHeaderBottomMargin">0,0,12,0</Thickness>
    <GridLength x:Key="QuadrantAccentWidth">3</GridLength>
    <GridLength x:Key="FormColumnGap">16</GridLength>

    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>

    <!-- Legacy page-specific values; later rounds replace their consumers deliberately. -->
    <Thickness x:Key="WindowMargin">16</Thickness>
    <GridLength x:Key="ToolbarHeight">Auto</GridLength>
    <Thickness x:Key="ToolbarSecondaryMargin">16,0,0,0</Thickness>
    <Thickness x:Key="QuadrantTopLeftMargin">0,0,8,8</Thickness>
    <Thickness x:Key="QuadrantTopRightMargin">8,0,0,8</Thickness>
    <Thickness x:Key="QuadrantBottomLeftMargin">0,8,8,0</Thickness>
    <Thickness x:Key="QuadrantBottomRightMargin">8,8,0,0</Thickness>
</ResourceDictionary>
