<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:Quadrant.App.Converters">
    <converters:StringToVisibilityConverter x:Key="TaskCardStringToVisibilityConverter" />

    <DataTemplate x:Key="TaskCardTemplate">
        <Border Style="{StaticResource TaskCardStyle}" Margin="{StaticResource TaskCardBottomMargin}">
            <AutomationProperties.Name>
                <MultiBinding StringFormat="{}{0}；{1}；{2}">
                    <Binding Path="Title" />
                    <Binding Path="DueText" />
                    <Binding Path="DueStatusText" />
                </MultiBinding>
            </AutomationProperties.Name>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="{StaticResource CaptionTopMargin}" Opacity="0.72" Text="{Binding DueText}" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="{StaticResource CaptionTopMargin}" Text="{Binding DueStatusText}" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="{StaticResource CaptionTopMargin}" Opacity="0.72" Text="{Binding ReminderText}" Visibility="{Binding ReminderText, Converter={StaticResource TaskCardStringToVisibilityConverter}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding CompleteCommand}" CommandParameter="{Binding Id}" Content="{DynamicResource CompleteText}" AutomationProperties.Name="标记任务完成" ToolTip="完成任务" />
                    <Button Margin="{StaticResource ButtonGap}" Command="{Binding EditCommand}" CommandParameter="{Binding Id}" Content="{DynamicResource EditText}" AutomationProperties.Name="编辑任务" ToolTip="编辑任务" />
                    <Button Margin="{StaticResource ButtonGap}" Command="{Binding DeleteCommand}" CommandParameter="{Binding Id}" Content="{DynamicResource DeleteText}" AutomationProperties.Name="删除任务" ToolTip="删除任务" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
