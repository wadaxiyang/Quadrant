<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Level 1: a quiet content layer over the Mica window. -->
    <Style x:Key="PageContentSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LayerOnMicaBaseAltFillColorTransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Level 2: section surfaces such as quadrants, metrics and settings groups. -->
    <Style x:Key="SectionSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource InsetL}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    </Style>

    <Style x:Key="HeroSurfaceStyle" TargetType="Border" BasedOn="{StaticResource SectionSurfaceStyle}">
        <Setter Property="Background" Value="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}" />
        <Setter Property="Padding" Value="{StaticResource InsetXXL}" />
    </Style>

    <!-- Level 3: lightweight rows inside a section. -->
    <Style x:Key="SubtleRowSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource RowContentPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SubtleListRowItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Margin" Value="{StaticResource RowBottomMargin}" />
        <Setter Property="Padding" Value="{StaticResource RowContentPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PageHeaderContainerStyle" TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource PageHeaderBottomMargin}" />
    </Style>

    <Style x:Key="PageHeaderTitleStackStyle" TargetType="StackPanel">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PageHeaderActionsStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="{StaticResource PageHeaderActionMargin}" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Existing surfaces remain visually compatible until their dedicated migration rounds. -->
    <Style x:Key="QuadrantPanelStyle" TargetType="Border" BasedOn="{StaticResource SectionSurfaceStyle}" />

    <Style x:Key="TaskCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource InsetM}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="{DynamicResource SpaceXXL}" />
        <Setter Property="MinHeight" Value="{DynamicResource SpaceXXL}" />
        <Setter Property="Padding" Value="{StaticResource InsetS}" />
    </Style>

    <Style x:Key="QuadrantTaskListStyle" TargetType="ListBox">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
