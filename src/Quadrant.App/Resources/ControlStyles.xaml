<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Level 1: a quiet content layer over the Mica window. -->
    <Style x:Key="PageContentSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LayerOnMicaBaseAltFillColorTransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Level 2: section surfaces such as quadrants, metrics and settings groups. -->
    <Style x:Key="SectionSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource InsetL}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    </Style>

    <Style x:Key="HeroSurfaceStyle" TargetType="Border" BasedOn="{StaticResource SectionSurfaceStyle}">
        <Setter Property="Background" Value="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}" />
        <Setter Property="Padding" Value="{StaticResource InsetXXL}" />
    </Style>

    <!-- Level 3: lightweight rows inside a section. -->
    <Style x:Key="SubtleRowSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource RowContentPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    </Style>

    <Style x:Key="TaskRowSurfaceStyle" TargetType="Border" BasedOn="{StaticResource SubtleRowSurfaceStyle}">
        <Setter Property="Margin" Value="{StaticResource RowBottomMargin}" />
        <Setter Property="Padding" Value="{StaticResource InsetS}" />
    </Style>

    <Style x:Key="TaskMetadataChipStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    </Style>

    <Style x:Key="HomeFilterGroupStyle" TargetType="Border">
        <Setter Property="Padding" Value="2" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    </Style>

    <Style x:Key="HomeFilterToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="QuadrantCountBadgeStyle" TargetType="ui:InfoBadge" BasedOn="{StaticResource {x:Type ui:InfoBadge}}">
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="QuadrantAddButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style x:Key="TaskRowActionButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="MinWidth" Value="{StaticResource SpaceXXL}" />
        <Setter Property="MinHeight" Value="{StaticResource SpaceXXL}" />
        <Setter Property="Padding" Value="{StaticResource InsetS}" />
    </Style>

    <Style x:Key="PageHeaderContainerStyle" TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource PageHeaderBottomMargin}" />
    </Style>

    <Style x:Key="PageHeaderTitleStackStyle" TargetType="StackPanel">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PageHeaderActionsStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="{StaticResource PageHeaderActionMargin}" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Existing surfaces remain visually compatible until their dedicated migration rounds. -->
    <Style x:Key="QuadrantPanelStyle" TargetType="Border" BasedOn="{StaticResource SectionSurfaceStyle}" />

    <Style x:Key="TaskCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource InsetM}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="{DynamicResource SpaceXXL}" />
        <Setter Property="MinHeight" Value="{DynamicResource SpaceXXL}" />
        <Setter Property="Padding" Value="{StaticResource InsetS}" />
    </Style>

    <!-- Low-opacity accent tints keep selection visible without becoming a full accent fill. -->
    <SolidColorBrush x:Key="TaskListViewItemSelectedBackgroundBrush"
                     Color="{DynamicResource SystemAccentColorPrimary}"
                     Opacity="0.12" />
    <SolidColorBrush x:Key="TaskListViewItemSelectedPointerOverBackgroundBrush"
                     Color="{DynamicResource SystemAccentColorPrimary}"
                     Opacity="0.18" />

    <!-- Keyboard focus remains a separate, keyboard-only adorner that follows the
         active Windows accent resource. -->
    <Style x:Key="TaskListViewItemFocusVisualStyle" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource TextControlFocusedBorderBrush}"
                            BorderThickness="2"
                            CornerRadius="{StaticResource RadiusMedium}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="TaskListViewItemTemplate" TargetType="ui:ListViewItem">
        <Border x:Name="SelectionSurface"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource RadiusMedium}"
                SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="SelectionSurface" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
            </MultiTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="SelectionSurface" Property="Background" Value="{DynamicResource TaskListViewItemSelectedBackgroundBrush}" />
                <Setter TargetName="SelectionSurface" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True" />
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="SelectionSurface" Property="Background" Value="{DynamicResource TaskListViewItemSelectedPointerOverBackgroundBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="SelectionSurface" Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="QuadrantTaskListStyle" TargetType="ui:ListView" BasedOn="{StaticResource {x:Type ui:ListView}}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ui:ListViewItem">
                    <Setter Property="Foreground" Value="{DynamicResource ListViewItemForeground}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource TaskListViewItemFocusVisualStyle}" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                    <Setter Property="Padding" Value="10,0,4,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template" Value="{StaticResource TaskListViewItemTemplate}" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
